{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "user-cache",
      "category": "applicationCache",
      "risk": "safe",
      "root": "homeLibrary",
      "relativePath": "Caches",
      "matchSpec": "childDirectories",
      "extensions": [],
      "excludes": [
        "CloudKit",
        "com.apple.bird",
        "com.apple.iCloud",
        "FamilyCircle"
      ],
      "minAgeDays": null,
      "usesStaleThreshold": false,
      "packageExtensions": [],
      "requiresFullDiskAccess": false,
      "explanationKey": "cleanup.explanation.cache",
      "enabled": true
    },
    {
      "id": "user-logs",
      "category": "logs",
      "risk": "safe",
      "root": "homeLibrary",
      "relativePath": "Logs",
      "matchSpec": "childDirectories",
      "extensions": [],
      "excludes": [],
      "minAgeDays": 30,
      "usesStaleThreshold": true,
      "packageExtensions": [],
      "requiresFullDiskAccess": false,
      "explanationKey": "cleanup.explanation.logsItem",
      "enabled": true
    },
    {
      "id": "user-diagnostic-reports",
      "category": "logs",
      "risk": "review",
      "root": "homeLibrary",
      "relativePath": "Logs/DiagnosticReports",
      "matchSpec": "anyFile",
      "extensions": [],
      "excludes": [],
      "minAgeDays": 30,
      "usesStaleThreshold": true,
      "packageExtensions": [],
      "requiresFullDiskAccess": false,
      "explanationKey": "cleanup.explanation.logsItem",
      "enabled": true
    },
    {
      "id": "system-logs",
      "category": "logs",
      "risk": "review",
      "root": "systemLibrary",
      "relativePath": "Logs",
      "matchSpec": "childDirectories",
      "extensions": [],
      "excludes": [],
      "minAgeDays": 30,
      "usesStaleThreshold": true,
      "packageExtensions": [],
      "requiresFullDiskAccess": true,
      "explanationKey": "cleanup.explanation.systemLogsItem",
      "enabled": true
    },
    {
      "id": "download-installers",
      "category": "installers",
      "risk": "review",
      "root": "home",
      "relativePath": "Downloads",
      "matchSpec": "filesByExtension",
      "extensions": [
        "dmg",
        "pkg",
        "mpkg",
        "xip",
        "iso"
      ],
      "excludes": [],
      "minAgeDays": 30,
      "usesStaleThreshold": true,
      "packageExtensions": [],
      "requiresFullDiskAccess": false,
      "explanationKey": "cleanup.explanation.installers",
      "enabled": true
    },
    {
      "id": "download-archives",
      "category": "installers",
      "risk": "review",
      "root": "home",
      "relativePath": "Downloads",
      "matchSpec": "filesByExtension",
      "extensions": [
        "zip",
        "tar",
        "gz",
        "tgz"
      ],
      "excludes": [],
      "minAgeDays": 90,
      "usesStaleThreshold": false,
      "packageExtensions": [],
      "requiresFullDiskAccess": false,
      "explanationKey": "cleanup.explanation.installers",
      "enabled": true
    },
    {
      "id": "user-temporary-items",
      "category": "temporaryFiles",
      "risk": "review",
      "root": "homeLibrary",
      "relativePath": "Application Support",
      "matchSpec": "childDirectories",
      "extensions": [],
      "excludes": [],
      "minAgeDays": 30,
      "usesStaleThreshold": false,
      "packageExtensions": [],
      "requiresFullDiskAccess": false,
      "explanationKey": "cleanup.explanation.temporary",
      "enabled": true
    },
    {
      "id": "user-saved-state",
      "category": "temporaryFiles",
      "risk": "safe",
      "root": "homeLibrary",
      "relativePath": "Saved Application State",
      "matchSpec": "childDirectories",
      "extensions": [],
      "excludes": [],
      "minAgeDays": null,
      "usesStaleThreshold": false,
      "packageExtensions": [],
      "requiresFullDiskAccess": false,
      "explanationKey": "cleanup.explanation.savedState",
      "enabled": true
    }
  ]
}

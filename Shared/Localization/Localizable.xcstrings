    "scan.nothingFoundDetail": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac looks tidy. Sift found no caches, logs or installers worth removing."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 很整洁。Sift 没有发现值得清理的缓存、日志或安装包。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 깨끗합니다. 정리할 만한 캐시, 로그 또는 설치 파일이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Mac в порядке. Sift не нашёл кэшей, логов или установщиков, которые стоит удалить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac está ordenado. Sift no encontró cachés, registros ni instaladores que merezca la pena eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac はきれいな状態です。削除すべきキャッシュ、ログ、インストーラは見つかりませんでした。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac est propre. Sift n’a trouvé aucun cache, journal ou installateur à supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Mac ist aufgeräumt. Sift fand keine Caches, Protokolle oder Installer, die sich lohnen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Mac è in ordine. Sift non ha trovato cache, log o installer da rimuovere."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu Mac está organizado. O Sift não encontrou caches, logs ou instaladores que valham a pena remover."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 很整潔。Sift 沒有發現值得清理的快取、記錄檔或安裝程式。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’iniz düzenli görünüyor. Sift kaldırmaya değer önbellek, günlük veya yükleyici bulamadı."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój Mac jest uporządkowany. Sift nie znalazł pamięci podręcznych, dzienników ani instalatorów wartych usunięcia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Mac is netjes. Sift vond geen caches, logbestanden of installatieprogramma’s die verwijdering waard zijn."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ຂອງທ່ານເປັນລະບຽບ. Sift ບໍ່ພົບແຄຊ໌ ໄຟລ໌ບັນທຶກ ຫຼື ໂປຣແກຣມຕິດຕັ້ງທີ່ຄວນລຶບ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز Mac الخاص بك مرتب. لم يعثر Sift على ذاكرة مؤقتة أو سجلات أو برامج تثبيت تستحق الإزالة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Mac שלכם מסודר. Sift לא מצא מטמונים, יומנים או מתקינים ששווה להסיר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مک شما مرتب است. Sift حافظهٔ نهانی، گزارش یا نصب‌کننده‌ای که ارزش حذف داشته باشد نیافت."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашият Mac изглежда подреден. Sift не намери кешове, журнали или инсталатори, които си струва да се премахнат."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš Mac je v pořádku. Sift nenašel žádné mezipaměti, protokoly ani instalátory, které by stálo za to odstranit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Mac ser ryddelig ud. Sift fandt ingen caches, logfiler eller installationsprogrammer, der er værd at fjerne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Mac σας φαίνεται τακτοποιημένο. Το Sift δεν βρήκε cache, αρχεία καταγραφής ή προγράμματα εγκατάστασης που αξίζει να αφαιρεθούν."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Mac se ve ordenado. Sift no encontró cachés, registros ni instaladores que valga la pena eliminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Macisi näyttää siistiltä. Sift ei löytänyt välimuisteja, lokeja tai asennusohjelmia, jotka kannattaisi poistaa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Macje rendben van. A Sift nem talált eltávolításra érdemes gyorsítótárat, naplót vagy telepítőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac Anda tampak rapi. Sift tidak menemukan cache, log, atau penginstal yang perlu dihapus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac anda kelihatan kemas. Sift tidak menemui cache, log atau pemasang yang perlu dibuang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen ser ryddig ut. Sift fant ingen cacher, loggfiler eller installasjonsprogrammer som er verdt å fjerne."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu Mac está organizado. O Sift não encontrou caches, registos ou instaladores que valha a pena eliminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Macul tău pare ordonat. Sift nu a găsit cache-uri, jurnale sau instalatoare care merită eliminate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Mac ser städad ut. Sift hittade inga cacher, loggar eller installationsprogram som är värda att ta bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ของคุณดูเรียบร้อยดี Sift ไม่พบแคช บันทึก หรือไฟล์ติดตั้งที่ควรลบ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Mac виглядає охайним. Sift не знайшов кешів, журналів чи інсталяторів, які варто видалити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac của bạn có vẻ gọn gàng. Sift không tìm thấy bộ nhớ đệm, nhật ký hay bộ cài nào đáng xóa."
          }
        }
      }
    },

    "files.scopeEmpty": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No folders yet. Duplicates are searched only in folders you add."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有文件夹。重复文件只在你添加的文件夹中搜索。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 폴더가 없습니다. 중복 파일은 추가한 폴더에서만 검색합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папок пока нет. Дубликаты ищутся только в добавленных папках."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay carpetas. Los duplicados se buscan solo en las carpetas que añadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだフォルダがありません。重複ファイルは追加したフォルダ内だけを検索します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier pour l’instant. Les doublons ne sont cherchés que dans les dossiers ajoutés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Ordner. Duplikate werden nur in hinzugefügten Ordnern gesucht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna cartella. I duplicati si cercano solo nelle cartelle che aggiungi."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há pastas. Duplicados são buscados apenas nas pastas que você adicionar."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有資料夾。重複檔案只在你加入的資料夾中搜尋。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz klasör yok. Kopyalar yalnızca eklediğiniz klasörlerde aranır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze folderów. Duplikaty są szukane tylko w dodanych folderach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen mappen. Duplicaten worden alleen in toegevoegde mappen gezocht."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍັງບໍ່ມີໂຟນເດີ. ໄຟລ໌ຊ້ຳຈະຖືກຄົ້ນສະເພາະໃນໂຟນເດີທີ່ທ່ານເພີ່ມ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مجلدات بعد. تُبحث المكررات فقط في المجلدات التي تضيفها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין תיקיות. כפילויות נחפשות רק בתיקיות שתוסיפו."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز پوشه‌ای نیست. تکراری‌ها فقط در پوشه‌هایی که می‌افزایید جست‌وجو می‌شوند."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още няма папки. Дубликати се търсят само в папките, които добавите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné složky. Duplikáty se hledají jen ve složkách, které přidáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mapper endnu. Dubletter søges kun i mapper, du tilføjer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν φάκελοι ακόμη. Τα διπλότυπα αναζητούνται μόνο σε φακέλους που προσθέτετε."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay carpetas. Los duplicados se buscan solo en las carpetas que agregues."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä kansioita. Kaksoiskappaleita etsitään vain lisäämistäsi kansioista."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs mappa. A duplikátumokat csak a hozzáadott mappákban keresi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada folder. Duplikat hanya dicari di folder yang Anda tambahkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada folder. Pendua hanya dicari dalam folder yang anda tambah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mapper ennå. Duplikater søkes bare i mapper du legger til."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há pastas. Os duplicados são procurados apenas nas pastas que adicionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă niciun folder. Duplicatele sunt căutate doar în folderele pe care le adaugi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga mappar än. Dubbletter söks bara i mappar du lägger till."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีโฟลเดอร์ ไฟล์ซ้ำจะถูกค้นหาเฉพาะในโฟลเดอร์ที่คุณเพิ่ม"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Папок ще немає. Дублікати шукаються лише в доданих вами папках."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có thư mục nào. Tệp trùng chỉ được tìm trong các thư mục bạn thêm."
          }
        }
      }
    },

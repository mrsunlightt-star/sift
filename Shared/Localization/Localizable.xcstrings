          "stringUnit": {
            "state": "translated",
            "value": "由產生它的工具重建"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturan araçla yeniden oluşturun"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbuduj w narzędziu, które go utworzyło"
          }
        },
        "nl": {

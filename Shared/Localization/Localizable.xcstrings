            "value": "Een groot bestand. Sift gokt niet: jij bepaalt wat er verwijderd wordt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ຂະໜາດໃຫຍ່. Sift ບໍ່ເດາະເດາະ: ທ່ານເປັນຜູ້ຕັດສິນວ່າຈະລຶບອັນໃດ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف كبير. لا يخمّن Sift: أنت من يقرر ماذا يُزال."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ גדול. Sift לא מנחש: אתם מחליטים מה להסיר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایلی بزرگ. Sift حدس نمی‌زند: تصمیم حذف با شماست."
          }
        }
      }
    },
    "cleanup.explanation.logs": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log files older than %d days. They do not affect how apps run."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 天前的日志文件。不影响应用正常运行。"

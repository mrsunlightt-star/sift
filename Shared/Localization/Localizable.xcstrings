    "storage.localNote": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured on this Mac. Nothing is uploaded or sent online."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据来自本机分析，不上传、不联网。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 분석한 데이터입니다. 업로드하거나 전송하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерено на этом Mac. Ничего не отправляется в сеть."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido en este Mac. No se sube ni se envía nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で計測したデータです。送信やアップロードは行いません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré sur ce Mac. Rien n’est envoyé en ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac gemessen. Nichts wird hochgeladen oder gesendet."
          }
        }
      }
    },

        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift가 %@에 종료를 요청하지 못했습니다. 직접 종료한 뒤 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

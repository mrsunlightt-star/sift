        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Създайте отново от програмата, която го е създала"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořit znovu v nástroji, který jej vytvořil"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genopbyg det fra værktøjet, der oprettede det"

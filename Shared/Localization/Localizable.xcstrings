    "uninstall.quitFailed": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift could not ask %@ to quit. Quit it manually and try again."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 无法请求 %@ 退出。请手动退出后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift가 %@에 종료를 요청하지 못했습니다. 직접 종료한 뒤 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift не удалось попросить %@ завершить работу. Закройте его вручную и повторите."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift no pudo pedir a %@ que se cerrara. Ciérrala manualmente e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift は %@ に終了を要求できませんでした。手動で終了してから再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift n’a pas pu demander à %@ de quitter. Quittez-le manuellement et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift konnte %@ nicht zum Beenden auffordern. Beenden Sie es manuell und versuchen Sie es erneut."
          }
        }
      }
    },
    "uninstall.reason.applicationName": {

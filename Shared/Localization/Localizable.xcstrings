    "cleanup.explanation.systemLogs": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System log files older than %d days. Some require Full Disk Access to read."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 天前的系统日志。部分需要完全磁盘访问权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d일이 지난 시스템 로그입니다. 일부는 전체 디스크 접근 권한이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системные журналы старше %d дней. Для некоторых нужен полный доступ к диску."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros del sistema de más de %d días. Algunos requieren acceso total al disco."

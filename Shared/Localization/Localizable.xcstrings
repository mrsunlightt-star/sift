    "permission.fullDiskAccessDetail": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scans caches and logs without it. Granting Full Disk Access lets it also read system logs and app support folders."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 无需该权限也能扫描缓存和日志。授予完全磁盘访问权限后，还可读取系统日志和应用支持目录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift는 이 권한 없이도 캐시와 로그를 검사합니다. 허용하면 시스템 로그와 앱 지원 폴더도 읽습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift сканирует кэши и логи и без него. С ним также читаются системные логи и папки приложений."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift analiza cachés y registros sin ello. Concediéndolo, también lee registros del sistema y carpetas de apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この権限がなくてもキャッシュとログはスキャンできます。許可するとシステムログやアプリのサポートフォルダも読めます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift analyse caches et journaux sans lui. Accordé, il lit aussi les journaux système et les dossiers d’apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scannt Caches und Protokolle auch ohne. Mit ihm liest es zusätzlich Systemprotokolle und App-Ordner."
          }
        }
      }
    },

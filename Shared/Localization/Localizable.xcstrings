    "diagnostics.explanation.developerData": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build data and caches a development tool keeps here. Sift does not judge what a project can rebuild, so nothing here is offered for removal."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发工具存放的构建数据和缓存。Sift 无法判断某个项目能重建什么，因此这里的内容不会被列为可删除项。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 도구가 보관하는 빌드 데이터와 캐시입니다. Sift는 프로젝트가 무엇을 다시 만들 수 있는지 판단하지 않으므로 삭제 대상으로 제시하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные сборки и кэши, которые хранит инструмент разработки. Sift не может судить, что проект перестроит, поэтому ничего отсюда не предлагается к удалению."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de compilación y cachés que guarda una herramienta de desarrollo. Sift no juzga qué puede reconstruir un proyecto, así que no ofrece nada de aquí para eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発ツールが置くビルドデータとキャッシュです。Sift はプロジェクトが何を再構築できるか判断しないため、ここから削除対象として提示しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de compilation et caches conservés par un outil de développement. Sift ne juge pas ce qu’un projet peut reconstruire et ne propose donc rien à supprimer ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build-Daten und Caches eines Entwicklungswerkzeugs. Sift beurteilt nicht, was ein Projekt neu aufbauen kann, und bietet hier nichts zum Entfernen an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati di build e cache che uno strumento di sviluppo conserva qui. Sift non giudica cosa un progetto possa ricreare, quindi qui nulla viene offerto per la rimozione."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados de build e caches que uma ferramenta de desenvolvimento guarda aqui. O Sift não julga o que um projeto pode reconstruir, então nada daqui é oferecido para remoção."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發工具存放的建置資料和快取。Sift 無法判斷某個專案能重建什麼，因此這裡的內容不會被列為可刪除項。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir geliştirme aracının burada tuttuğu derleme verileri ve önbellekler. Sift bir projenin neyi yeniden oluşturabileceğine hükmetmez, bu yüzden buradan kaldırılmak üzere bir şey önerilmez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane kompilacji i pamięci podręczne przechowywane przez narzędzie deweloperskie. Sift nie ocenia, co projekt może odtworzyć, więc nic stąd nie jest proponowane do usunięcia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buildgegevens en caches die een ontwikkeltool hier bewaart. Sift oordeelt niet wat een project kan herbouwen, dus wordt hier niets aangeboden voor verwijdering."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຂໍ້ມູນສ້າງ ແລະ ແຄຊ໌ທີ່ເຄື່ອງມືພັດທະນາເກັບໄວ້ນີ້. Sift ບໍ່ຕັດສິນວ່າໂຄງການສ້າງຄືນຫຍັງໄດ້ ຈຶ່ງບໍ່ສະເໜີສິ່ງເຫຼົ່ານີ້ເປັນລາຍການລຶບ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات بناء وذاكرات مؤقتة يحتفظ بها أداة تطوير هنا. لا يحكم Sift بما يستطيع المشروع إعادة بنائه، لذا لا يُعرض من هنا شيء للإزالة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני בנייה ומטמונים שכלי פיתוח שומר כאן. Sift אינו שופט מה הפרויקט יכול לבנות מחדש, ולכן כאן לא מוצע דבר להסרה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های ساخت و حافظه‌های نهانی که یک ابزار توسعه اینجا نگه می‌دارد. Sift دربارهٔ آن‌چه پروژه می‌تواند بازسازی کند قضاوت نمی‌کند، پس هیچ‌چیز از اینجا برای حذف پیشنهاد نمی‌شود."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Данни от компилация и кешове, които инструмент за разработка пази тук. Sift не може да прецени какво проектът може да създаде отново, затова нищо тук не се предлага за премахване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data sestavení a mezipaměti, které zde vývojářský nástroj uchovává. Sift neposuzuje, co projekt umí vytvořit znovu, proto zde nic nenabízí k odstranění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggedata og caches, som et udviklingsværktøj gemmer her. Sift vurderer ikke, hvad et projekt kan genopbygge, så intet her tilbydes til fjernelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεδομένα μεταγλώττισης και cache που κρατά εδώ ένα εργαλείο ανάπτυξης. Το Sift δεν κρίνει τι μπορεί να δημιουργήσει ξανά ένα έργο, οπότε τίποτα εδώ δεν προσφέρεται για αφαίρεση."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de compilación y cachés que guarda aquí una herramienta de desarrollo. Sift no evalúa qué puede reconstruir un proyecto, así que no ofrece nada de aquí para eliminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koontitiedot ja välimuistit, joita kehitystyökalu säilyttää täällä. Sift ei arvioi, mitä projekti voi luoda uudelleen, joten mitään täällä ei tarjota poistettavaksi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy fejlesztőeszköz által itt tartott build-adatok és gyorsítótárak. A Sift nem ítéli meg, mit tud újraépíteni egy projekt, ezért innen semmi nem ajánlható eltávolításra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data build dan cache yang disimpan alat pengembangan di sini. Sift tidak menilai apa yang dapat dibangun ulang proyek, jadi tidak ada yang ditawarkan untuk dihapus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data binaan dan cache yang disimpan alat pembangunan di sini. Sift tidak menilai apa yang boleh dibina semula oleh projek, jadi tiada apa-apa di sini ditawarkan untuk dibuang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggedata og cacher et utviklingsverktøy lagrer her. Sift vurderer ikke hva et prosjekt kan bygge på nytt, så ingenting her tilbys for fjerning."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados de compilação e caches que uma ferramenta de desenvolvimento guarda aqui. O Sift não avalia o que um projeto pode reconstruir, pelo que nada aqui é proposto para eliminação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Date de compilare și cache-uri pe care un instrument de dezvoltare le păstrează aici. Sift nu judecă ce poate reconstrui un proiect, așa că nimic de aici nu este oferit spre eliminare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggdata och cacher som ett utvecklingsverktyg sparar här. Sift bedömer inte vad ett projekt kan bygga upp igen, så inget här erbjuds för borttagning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลการบิลด์และแคชที่เครื่องมือพัฒนาเก็บไว้ที่นี่ Sift ไม่ตัดสินว่าโปรเจกต์สร้างอะไรใหม่ได้ จึงไม่มีสิ่งใดที่นี่ถูกเสนอให้ลบ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані збирання й кеші, які інструмент розробки зберігає тут. Sift не може оцінити, що проєкт здатен відбудувати, тому нічого звідси не пропонується до видалення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu bản dựng và bộ nhớ đệm mà công cụ phát triển lưu ở đây. Sift không đánh giá dự án có thể tạo lại gì, nên không có gì ở đây được đề nghị xóa."
          }
        }
      }
    },
    "diagnostics.explanation.developerIndex": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An index a development tool built for this project. The tool rebuilds it on demand; until then, code completion and symbol search are slower."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发工具为此项目建立的索引。需要时该工具会重建；在重建前，代码补全和符号搜索会更慢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 도구가 이 프로젝트를 위해 만든 색인입니다. 필요할 때 도구가 다시 만들며, 그때까지 코드 완성과 심볼 검색이 느려집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс, который инструмент разработки построил для проекта. Он перестроит его при необходимости; до этого автодополнение и поиск символов медленнее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice que una herramienta de desarrollo creó para este proyecto. La herramienta lo reconstruye cuando hace falta; hasta entonces el autocompletado y la búsqueda de símbolos son más lentos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発ツールがこのプロジェクト用に作成した索引です。必要になればツールが再構築します。それまで補完とシンボル検索は遅くなります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Index qu’un outil de développement a créé pour ce projet. L’outil le reconstruit à la demande ; d’ici là, la complétion et la recherche de symboles sont plus lentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Index, den ein Entwicklungswerkzeug für dieses Projekt erstellt hat. Das Werkzeug baut ihn bei Bedarf neu auf; bis dahin sind Vervollständigung und Symbolsuche langsamer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un indice costruito da uno strumento di sviluppo per questo progetto. Lo strumento lo ricrea su richiesta; fino ad allora completamento e ricerca di simboli sono più lenti."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Um índice que uma ferramenta de desenvolvimento criou para este projeto. A ferramenta o reconstrói sob demanda; até lá, o autocompletar e a busca de símbolos ficam mais lentos."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發工具為此專案建立的索引。需要時該工具會重建；在重建前，程式碼補全和符號搜尋會更慢。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir geliştirme aracının bu proje için oluşturduğu dizin. Araç gerektiğinde yeniden oluşturur; o ana kadar kod tamamlama ve simge araması yavaşlar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks zbudowany przez narzędzie deweloperskie dla tego projektu. Narzędzie odbuduje go na żądanie; do tego czasu uzupełnianie i wyszukiwanie symboli są wolniejsze."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een index die een ontwikkeltool voor dit project bouwde. De tool herbouwt hem op verzoek; tot die tijd zijn aanvullen en symboolzoeken trager."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດັດຊະນີທີ່ເຄື່ອງມືພັດທະນາສ້າງໄວ້ໃຫ້ໂຄງການນີ້. ເຄື່ອງມືຈະສ້າງຄືນເມື່ອຕ້ອງການ; ກ່ອນໜ້ານັ້ນ ການສົມບູນໂຄດ ແລະ ການຄົ້ນຫາສັນຍາລັກ ຈະຊ້າລົງ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرس بناه أداة تطوير لهذا المشروع. تعيد الأداة بناءه عند الطلب؛ وحتى ذلك الحين يكون الإكمال التلقائي والبحث عن الرموز أبطأ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אינדקס שכלי פיתוח בנה לפרויקט זה. הכלי בונה אותו מחדש לפי דרישה; עד אז השלמת הקוד וחיפוש סמלים איטיים יותר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایه‌ای که یک ابزار توسعه برای این پروژه ساخته است. ابزار در صورت نیاز آن را بازسازی می‌کند؛ تا آن زمان تکمیل کد و جست‌وجوی نمادها کندترند."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс, който инструмент за разработка е създал за този проект. Инструментът ще го създаде отново при нужда; дотогава автодовършването и търсенето на символи са по-бавни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Index, který pro tento projekt vytvořil vývojářský nástroj. Nástroj jej vytvoří znovu na vyžádání; do té doby je našeptávání kódu a hledání symbolů pomalejší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et indeks, som et udviklingsværktøj har oprettet til dette projekt. Værktøjet genopbygger det efter behov; indtil da er kodefuldførelse og symbolsøgning langsommere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα ευρετήριο που δημιούργησε εργαλείο ανάπτυξης για αυτό το έργο. Το εργαλείο το δημιουργεί ξανά κατόπιν αιτήματος· μέχρι τότε, η αυτόματη συμπλήρωση κώδικα και η αναζήτηση συμβόλων είναι πιο αργές."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice que creó una herramienta de desarrollo para este proyecto. La herramienta lo reconstruye cuando hace falta; hasta entonces, el autocompletado y la búsqueda de símbolos son más lentos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakemisto, jonka kehitystyökalu on luonut tälle projektille. Työkalu luo sen uudelleen tarvittaessa; siihen asti koodin täydennys ja symbolihaku ovat hitaampia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy fejlesztőeszköz által ehhez a projekthez épített index. Az eszköz igény szerint újraépíti; addig a kódkiegészítés és a szimbólumkeresés lassabb."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks yang dibangun alat pengembangan untuk proyek ini. Alat tersebut membangunnya ulang saat diperlukan; sampai saat itu, pelengkapan kode dan pencarian simbol lebih lambat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks yang dibina oleh alat pembangunan untuk projek ini. Alat itu membinanya semula apabila diperlukan; sehingga itu, pelengkapan kod dan carian simbol lebih perlahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En indeks et utviklingsverktøy har laget for dette prosjektet. Verktøyet bygger den på nytt ved behov; til da er kodefullføring og symbolsøk tregere."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um índice criado por uma ferramenta de desenvolvimento para este projeto. A ferramenta reconstrói-o quando necessário; até lá, o preenchimento automático e a pesquisa de símbolos ficam mais lentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un index creat de un instrument de dezvoltare pentru acest proiect. Instrumentul îl reconstruiește la cerere; până atunci, completarea codului și căutarea simbolurilor sunt mai lente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett index som ett utvecklingsverktyg har skapat för det här projektet. Verktyget bygger upp det igen vid behov; tills dess är kodkomplettering och symbolsökning långsammare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดัชนีที่เครื่องมือพัฒนาสร้างขึ้นสำหรับโปรเจกต์นี้ เครื่องมือจะสร้างใหม่เมื่อต้องการ จนกว่าจะถึงตอนนั้น การเติมโค้ดและการค้นหาสัญลักษณ์จะช้าลง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Індекс, який інструмент розробки створив для цього проєкту. Інструмент відбудує його за потреби; доти автодоповнення й пошук символів повільніші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ mục do công cụ phát triển tạo cho dự án này. Công cụ sẽ tạo lại khi cần; cho đến lúc đó, gợi ý mã và tìm ký hiệu sẽ chậm hơn."
          }
        }
      }
    },
    "diagnostics.explanation.snapshots": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS local snapshots. They hold the state of the volume, macOS thins them by itself, and no per-snapshot size is reported by the system."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 本地快照。它们保存卷的状态，macOS 会自动精简，系统不提供单个快照的占用大小。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 로컬 스냅샷입니다. 볼륨 상태를 보관하며 macOS가 스스로 정리합니다. 스냅샷별 크기는 시스템이 제공하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные снимки APFS. Они хранят состояние тома, macOS прореживает их сама, размер отдельного снимка система не сообщает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantáneas locales de APFS. Guardan el estado del volumen, macOS las reduce por su cuenta y el sistema no informa del tamaño de cada una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS のローカルスナップショットです。ボリュームの状態を保持し、macOS が自動的に間引きます。個別のサイズはシステムから提供されません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantanés locaux APFS. Ils conservent l’état du volume, macOS les élague lui-même, et le système ne fournit pas de taille par instantané."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale APFS-Snapshots. Sie halten den Zustand des Volumes, macOS dünnt sie selbst aus, und das System meldet keine Größe je Snapshot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot locali APFS. Conservano lo stato del volume, macOS li assottiglia da solo e il sistema non riporta la dimensione di ciascuno."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots locais do APFS. Guardam o estado do volume, o macOS os reduz por conta própria e o sistema não informa o tamanho de cada um."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 本機快照。它們保存卷宗的狀態，macOS 會自動精簡，系統不提供單一快照的佔用大小。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS yerel anlık görüntüleri. Birimin durumunu tutar, macOS bunları kendisi arındırır ve sistem her birinin boyutunu bildirmez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne migawki APFS. Przechowują stan wolumenu, macOS sam je przerzedza, a system nie podaje rozmiaru pojedynczej migawki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale APFS-snapshots. Ze bewaren de volumestatus, macOS dunt ze zelf uit en het systeem meldt geen grootte per snapshot."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot ທ້ອງຖິ່ນ APFS. ເກັບສະຖານະຣະບົບ, macOS ຈັດການຫຍໍ້ເອງ, ແລະ ລະບົບບໍ່ລາຍງານຂະໜາດຂອງແຕ່ລະອັນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقطات APFS محلية. تحفظ حالة الحجم، يقلّصها macOS بنفسه، والنظام لا يبلّغ عن حجم كل لقطة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות מצב מקומיות של APFS. הן שומרות את מצב הכונן, macOS מדלל אותן בעצמו, והמערכת אינה מדווחת על גודל כל אחת."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس‌های فوری محلی APFS. وضعیت حجم را نگه می‌دارند، مک‌او‌اس خودش آن‌ها را کاهش می‌دهد و سیستم اندازهٔ هر کدام را گزارش نمی‌کند."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Локални снимки на APFS. Те пазят състоянието на тома, macOS ги разрежда сама и системата не съобщава размер за отделна снимка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní snímky APFS. Uchovávají stav svazku, macOS je sám postupně ruší a systém neuvádí velikost jednotlivých snímků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale APFS-snapshots. De gemmer diskens tilstand, macOS tynder dem selv ud, og systemet rapporterer ingen størrelse per snapshot."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοπικά στιγμιότυπα APFS. Διατηρούν την κατάσταση του τόμου, το macOS τα περιορίζει μόνο του και το σύστημα δεν αναφέρει μέγεθος ανά στιγμιότυπο."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantáneas locales de APFS. Guardan el estado del volumen, macOS las reduce por su cuenta y el sistema no informa el tamaño de cada una."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset APFS-tilannekuvat. Ne säilyttävät levyn tilan, macOS ohentaa niitä itse, eikä järjestelmä ilmoita tilannekuvakohtaista kokoa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyi APFS-pillanatképek. A kötet állapotát őrzik, a macOS maga ritkítja őket, és a rendszer nem ad meg pillanatképenkénti méretet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot lokal APFS. Snapshot menyimpan status volume, macOS memangkasnya sendiri, dan sistem tidak melaporkan ukuran per snapshot."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petikan setempat APFS. Petikan menyimpan keadaan volum, macOS menyusutkannya sendiri, dan sistem tidak melaporkan saiz bagi setiap petikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale APFS-øyeblikksbilder. De holder diskens tilstand, macOS tynner dem ut selv, og systemet rapporterer ingen størrelse per øyeblikksbilde."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantâneos locais do APFS. Guardam o estado do volume, o macOS reduz o seu número automaticamente e o sistema não indica o tamanho de cada um."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantaneuri locale APFS. Ele păstrează starea volumului, macOS le subțiază singur, iar sistemul nu raportează dimensiunea fiecărui instantaneu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokala APFS-ögonblicksbilder. De håller diskens tillstånd, macOS tunnar ut dem självt, och systemet rapporterar ingen storlek per ögonblicksbild."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแนปชอตภายในเครื่องของ APFS เก็บสถานะของโวลุ่ม macOS จะลดจำนวนเอง และระบบไม่รายงานขนาดของแต่ละสแนปชอต"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальні знімки APFS. Вони зберігають стан тому, macOS сама їх проріджує, а розмір окремого знімка система не повідомляє."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chụp cục bộ APFS. Chúng lưu trạng thái của ổ đĩa, macOS tự giảm bớt và hệ thống không báo kích thước của từng ảnh chụp."
          }
        }
      }
    },
    "diagnostics.explanation.spotlightIndexed": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight's index for this volume; indexing is currently on. macOS rebuilds it with mdutil -E — moving it to the Trash only makes search unavailable until it is rebuilt."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卷的 Spotlight 索引，索引服务当前已启用。macOS 可用 mdutil -E 重建；直接移入废纸篓只会让搜索在重建完成前不可用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 볼륨의 Spotlight 색인이며 색인이 켜져 있습니다. macOS는 mdutil -E로 다시 만듭니다. 휴지통으로 옮기면 다시 만들어질 때까지 검색만 사용할 수 없게 됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс Spotlight для этого тома; индексация включена. macOS перестраивает его через mdutil -E — перемещение в Корзину лишь отключит поиск до перестроения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice de Spotlight de este volumen; la indexación está activada. macOS lo reconstruye con mdutil -E: moverlo a la Papelera solo deja la búsqueda inutilizable hasta que se reconstruya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボリュームの Spotlight インデックスで、現在は索引が有効です。macOS は mdutil -E で再構築します。ゴミ箱に移しても、再構築が終わるまで検索が使えなくなるだけです。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Index Spotlight de ce volume ; l’indexation est active. macOS le reconstruit avec mdutil -E : le placer dans la Corbeille rend simplement la recherche indisponible jusqu’à la reconstruction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight-Index dieses Volumes; die Indizierung ist aktiv. macOS baut ihn mit mdutil -E neu auf – in den Papierkorb gelegt wird nur die Suche unbrauchbar, bis er neu aufgebaut ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indice Spotlight di questo volume; l’indicizzazione è attiva. macOS lo ricrea con mdutil -E: spostarlo nel Cestino rende solo la ricerca indisponibile finché non è stato ricostruito."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O índice do Spotlight deste volume; a indexação está ativada. O macOS o reconstrói com mdutil -E — movê-lo para a Lixeira apenas deixa a busca indisponível até ser reconstruído."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此卷宗的 Spotlight 索引，索引服務目前已啟用。macOS 可用 mdutil -E 重建；直接移入垃圾桶只會讓搜尋在重建完成前不可用。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu birimin Spotlight dizini; dizinleme açık. macOS bunu mdutil -E ile yeniden oluşturur — Çöp Sepeti’ne taşımak yalnızca yeniden oluşturulana kadar aramayı kullanılamaz hâle getirir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks Spotlight tego wolumenu; indeksowanie jest włączone. macOS odbuduje go przez mdutil -E — przeniesienie do Kosza tylko na czas odbudowy wyłączy wyszukiwanie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Spotlight-index van dit volume; indexeren staat aan. macOS herbouwt hem met mdutil -E — naar de Prullenbak verplaatsen maakt zoeken alleen onbruikbaar tot de herbouw klaar is."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດັດຊະນີ Spotlight ຂອງຣະບົບນີ້; ການຈັດດັດຊະນີເປີດຢູ່. macOS ສ້າງຄືນໄດ້ດ້ວຍ mdutil -E; ຖ້າຍ້າຍໄປຖັງຂີ້ເຫຍື້ອ ການຄົ້ນຫາຈະໃຊ້ບໍ່ໄດ້ຈົນກວ່າຈະສ້າງຄືນສຳເລັດ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرس Spotlight لهذا الحجم؛ الفهرسة مفعّلة. يعيد macOS بناءه عبر mdutil -E — نقله إلى المهملات يجعل البحث فقط غير متاح حتى تكتمل إعادة البناء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אינדקס ה-Spotlight של הכונן הזה; האינדוקס פעיל. macOS בונה אותו מחדש עם mdutil -E — העברה אל פח האשפה רק תשבית את החיפוש עד לסיום הבנייה מחדש."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایهٔ Spotlight این حجم؛ نمایه‌سازی روشن است. مک‌او‌اس آن را با mdutil -E بازسازی می‌کند — انتقال به سطل بازیافت فقط تا پایان بازسازی، جست‌وجو را از کار می‌اندازد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Индексът на Spotlight за този том; индексирането в момента е включено. macOS го създава отново с mdutil -E — преместването му в Кошчето само прави търсенето недостъпно, докато не бъде създаден отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Index Spotlightu pro tento svazek; indexování je právě zapnuto. macOS jej vytvoří znovu pomocí mdutil -E — přesun do Koše jen znepřístupní vyhledávání, dokud nebude vytvořen znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlights indeks for denne disk; indeksering er i øjeblikket slået til. macOS genopbygger det med mdutil -E – flytning til Papirkurven gør kun søgning utilgængelig, indtil det er genopbygget."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ευρετήριο του Spotlight για αυτόν τον τόμο· η ευρετηρίαση είναι προς το παρόν ενεργή. Το macOS το δημιουργεί ξανά με mdutil -E — η μετακίνησή του στον Κάδο κάνει απλώς την αναζήτηση μη διαθέσιμη μέχρι να δημιουργηθεί ξανά."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice de Spotlight de este volumen; la indexación está activada. macOS lo reconstruye con mdutil -E: moverlo a la Papelera solo deja la búsqueda no disponible hasta que se reconstruya."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlightin hakemisto tälle levylle; indeksointi on tällä hetkellä päällä. macOS luo sen uudelleen komennolla mdutil -E – Roskakoriin siirtäminen tekee vain hausta käyttökelvottoman, kunnes se luodaan uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Spotlight indexe ehhez a kötethez; az indexelés jelenleg be van kapcsolva. A macOS újraépíti az mdutil -E paranccsal – a Kukába helyezés csak addig teszi elérhetetlenné a keresést, amíg újra nem épül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks Spotlight untuk volume ini; pengindeksan sedang aktif. macOS membangun ulangnya dengan mdutil -E — memindahkannya ke Tempat Sampah hanya membuat pencarian tidak tersedia sampai dibangun ulang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks Spotlight untuk volum ini; pengindeksan sedang aktif. macOS membinanya semula dengan mdutil -E — mengalihkannya ke Tong Sampah hanya menjadikan carian tidak tersedia sehingga ia dibina semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlights indeks for denne disken; indeksering er slått på nå. macOS bygger den på nytt med mdutil -E – flytting til Papirkurven gjør bare søk utilgjengelig til den er bygget på nytt."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice do Spotlight deste volume; a indexação está ativa. O macOS reconstrói-o com mdutil -E — movê-lo para o Lixo apenas torna a pesquisa indisponível até ser reconstruído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexul Spotlight pentru acest volum; indexarea este activă acum. macOS îl reconstruiește cu mdutil -E — mutarea lui în Coș doar face căutarea indisponibilă până la reconstruire."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlights index för den här disken; indexering är för närvarande på. macOS bygger upp det igen med mdutil -E – att flytta det till Papperskorgen gör bara sökning otillgänglig tills det har byggts upp igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดัชนีของ Spotlight สำหรับโวลุ่มนี้ ขณะนี้การทำดัชนีเปิดอยู่ macOS จะสร้างใหม่ด้วย mdutil -E การย้ายไปที่ถังขยะเพียงทำให้การค้นหาใช้ไม่ได้จนกว่าจะสร้างใหม่"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Індекс Spotlight для цього тому; індексування наразі ввімкнено. macOS відбудовує його через mdutil -E — переміщення в Кошик лише зробить пошук недоступним, доки його не відбудовано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ mục của Spotlight cho ổ đĩa này; tính năng lập chỉ mục hiện đang bật. macOS tạo lại bằng mdutil -E — chuyển nó vào Thùng rác chỉ khiến tìm kiếm không dùng được cho đến khi được tạo lại."
          }
        }
      }
    },

        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift raakt deze locatie nooit aan, om je bestanden te beschermen."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເພື່ອປົກປ້ອງໄຟລ໌ຂອງທ່ານ, Sift ຈະບໍ່ແຕະຕຳແໜ່ງນີ້."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحماية ملفاتك، لا يلمس Sift هذا الموقع أبدًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להגן על הקבצים שלכם, Sift לעולם לא נוגע במיקום זה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای محافظت از فایل‌هایتان، Sift هرگز به این مکان دست نمی‌زند."
          }
        }
      }
    },

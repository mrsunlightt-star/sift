        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 범위를 측정할 수 없어 합계는 최소값입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть области измерить не удалось, поэтому итоги — нижняя граница."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte del alcance no se pudo medir, así que los totales son un mínimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部を測定できなかったため、合計は下限値です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de la portée n’a pas pu être mesurée : les totaux sont un minimum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil des Bereichs war nicht messbar, die Summen sind also Untergrenzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte dell’ambito non si è lasciata misurare: i totali sono un limite inferiore."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do escopo não pôde ser medida, então os totais são um limite inferior."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分範圍無法統計，因此合計只是下限。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapsamın bir kısmı ölçülemediği için toplamlar alt sınırdır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Części zakresu nie udało się zmierzyć, więc sumy są dolnym ograniczeniem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deel van het bereik kon niet worden gemeten, de totalen zijn dus een ondergrens."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບາງສ່ວນວັດແທກບໍ່ໄດ້ ຈຶ່ງຕົວເລກລວມເປັນພຽງຂອບລຸ່ມ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر قياس جزء من النطاق، لذا فإن الإجماليات حد أدنى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מההיקף לא נמדד, ולכן הסכומים הם גבול תחתון."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بخشی از محدوده اندازه‌گیری نشد، پس جمع‌ها حد پایین‌اند."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Част от обхвата не можа да бъде измерена, затова общите стойности са долна граница."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Část rozsahu nebylo možné změřit, takže součty jsou spodní hranicí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En del af området kunne ikke måles, så totalerne er et minimum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μέρος του εύρους δεν ήταν δυνατό να μετρηθεί, οπότε τα σύνολα είναι κατώτερο όριο."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo medir parte del alcance, así que los totales son un límite inferior."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osaa alueesta ei voitu mitata, joten kokonaismäärät ovat alaraja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hatókör egy részét nem sikerült megmérni, ezért az összegek alsó határt jelentenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian cakupan tidak dapat diukur, jadi totalnya merupakan batas bawah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebahagian skop tidak dapat diukur, jadi jumlahnya ialah had bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En del av området kunne ikke måles, så totalene er et minimum."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do âmbito não pôde ser medida, pelo que os totais são um limite inferior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O parte a domeniului nu a putut fi măsurată, așa că totalurile sunt o limită inferioară."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En del av omfånget kunde inte mätas, så totalerna är en undre gräns."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถวัดขอบเขตบางส่วนได้ ยอดรวมจึงเป็นค่าต่ำสุด"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Частину обсягу не вдалося виміряти, тож підсумки є нижньою межею."
          }
        },
        "vi": {

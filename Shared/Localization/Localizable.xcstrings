          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duży plik. Sift nie zgaduje: to Ty decydujesz, co usunąć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een groot bestand. Sift gokt niet: jij bepaalt wat er verwijderd wordt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ຂະໜາດໃຫຍ່. Sift ບໍ່ເດາະເດາະ: ທ່ານເປັນຜູ້ຕັດສິນວ່າຈະລຶບອັນໃດ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف كبير. لا يخمّن Sift: أنت من يقرر ماذا يُزال."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",

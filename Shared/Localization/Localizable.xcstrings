          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de registro de más de %d días. No afectan al funcionamiento de las apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 日より前のログファイルです。アプリの動作には影響しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux de plus de %d jours. Sans effet sur le fonctionnement des apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolldateien älter als %d Tage. Sie beeinflussen Apps nicht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File di log più vecchi di %d giorni. Non influiscono sul funzionamento delle app."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos de log com mais de %d dias. Não afetam o funcionamento dos apps."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 天前的記錄檔案。不影響應用程式正常執行。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d günden eski günlük dosyaları. Uygulamaların çalışmasını etkilemez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki dzienników starsze niż %d dni. Nie wpływają na działanie aplikacji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logbestanden ouder dan %d dagen. Ze beïnvloeden de apps niet."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ບັນທຶກທີ່ເກົ່າກວ່າ %d ວັນ. ບໍ່ກະທົບການເຮັດວຽກຂອງແອັບ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات سجلات أقدم من %d يومًا. لا تؤثر على عمل التطبيقات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובצי יומן בני יותר מ-%d ימים. אינם משפיעים על פעולת האפליקציות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل‌های گزارش قدیمی‌تر از %d روز. بر کار برنامه‌ها اثر نمی‌گذارند."
          }
        }
      }
    },
    "cleanup.explanation.logsItem": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stale log files. Removing them does not change how apps run."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过期日志文件。删除它们不会影响应用运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 로그 파일입니다. 삭제해도 앱 실행에는 영향이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устаревшие файлы журналов. Их удаление не влияет на работу приложений."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de registro obsoletos. Eliminarlos no afecta al funcionamiento de las apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いログファイルです。削除してもアプリの動作には影響しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux obsolètes. Les supprimer ne change rien au fonctionnement des apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veraltete Protokolldateien. Ihr Entfernen ändert nichts an der Arbeitsweise der Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File di log datati. Rimuoverli non cambia il funzionamento delle app."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos de log antigos. Removê-los não afeta o funcionamento dos apps."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過期記錄檔案。刪除它們不會影響應用程式執行。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski günlük dosyaları. Bunları kaldırmak uygulamaların çalışmasını değiştirmez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestarzałe pliki dzienników. Ich usunięcie nie zmienia działania aplikacji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verouderde logbestanden. Ze verwijderen verandert niets aan de werking van de apps."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ບັນທຶກເກົ່າ. ການລຶບອອກບໍ່ກະທົບການເຮັດວຽກຂອງແອັບ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات سجلات قديمة. إزالتها لا تغيّر عمل التطبيقات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובצי יומן ישנים. הסרתם אינה משנה את פעולת האפליקציות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گزارش‌های قدیمی. حذفشان کار برنامه‌ها را تغییر نمی‌دهد."
          }
        }
      }
    },

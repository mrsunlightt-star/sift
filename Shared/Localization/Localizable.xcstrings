          "stringUnit": {
            "state": "translated",
            "value": "לבנות מחדש מהכלי שיצר אותו"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با ابزاری که ساخته بازسازی کنید"

    "scan.results.trashHint": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to the Trash by default; recoverable until you empty it."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认移入废纸篓，清空废纸篓前可恢复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 휴지통으로 이동하며, 비우기 전까지 복구할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию в Корзину; можно восстановить до её очистки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mueve a la papelera; puedes recuperarlo hasta vaciarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定でゴミ箱に移動し、ゴミ箱を空にするまで復元できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacé dans la corbeille ; récupérable jusqu’à ce que vous la vidiez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig in den Papierkorb; bis zum Leeren wiederherstellbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostato nel Cestino per impostazione predefinita; recuperabile finché non lo svuoti."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai para a Lixeira por padrão; recuperável até esvaziá-la."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設移入垃圾桶，清空垃圾桶前可還原。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak Çöp Sepeti’ne taşınır; boşaltana kadar geri alınabilir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie trafia do Kosza; do przywrócenia do jego opróżnienia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard naar de Prullenbak; terug te zetten totdat je die leegt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍ້າຍໄປຖັງຂີ້ເຫຍື້ອໂດຍຄ່າເລີ່ມຕົ້ນ; ກູ້ຄືນໄດ້ຈົນກວ່າຈະລ້າງຖັງ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتقل إلى المهملات افتراضيًا؛ قابل للاستعادة حتى تفرغها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מועבר לפח האשפה כברירת מחדל; ניתן לשחזר עד שתרוקנו אותו."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌طور پیش‌فرض به سطل بازیافت می‌رود؛ تا خالی کردنش قابل بازیابی است."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "По подразбиране се преместват в Кошчето; могат да се върнат, докато не го изпразните."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím nastavení přesunuto do Koše; obnovitelné, dokud jej nevysypete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttes til Papirkurven som standard; kan gendannes, indtil du tømmer den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακινούνται στον Κάδο από προεπιλογή· ανακτήσιμα μέχρι να τον αδειάσετε."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mueve a la Papelera por defecto; es recuperable hasta que la vacíes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirretään oletuksena Roskakoriin; palautettavissa, kunnes tyhjennät sen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alapértelmezés szerint a Kukába kerül; visszaállítható, amíg ki nem üríti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipindahkan ke Tempat Sampah secara default; dapat dipulihkan sampai Anda mengosongkannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialihkan ke Tong Sampah secara lalai; boleh dipulihkan sehingga anda mengosongkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttes til Papirkurven som standard; kan gjenopprettes til du tømmer den."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Movido para o Lixo por predefinição; recuperável até o esvaziar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutate implicit în Coș; recuperabile până golești Coșul."
          }
        },
        "sv": {

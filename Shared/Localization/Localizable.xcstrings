    "uninstall.systemAppDetail": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift only removes apps you installed yourself."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 只处理你自己安装的应用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift는 직접 설치한 앱만 제거합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift удаляет только приложения, установленные вами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift solo elimina apps que instalaste tú."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift はご自身でインストールしたアプリのみ削除します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ne supprime que les apps que vous avez installées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift entfernt nur Apps, die Sie selbst installiert haben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift rimuove solo le app che hai installato tu."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift só remove apps que você mesmo instalou."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 只處理你自己安裝的應用程式。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift yalnızca sizin yüklediğiniz uygulamaları kaldırır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift usuwa tylko aplikacje, które samodzielnie zainstalowałeś."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift verwijdert alleen apps die je zelf hebt geïnstalleerd."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ຈັດການສະເພາະແອັບທີ່ທ່ານຕິດຕັ້ງເອງ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل Sift التطبيقات التي ثبّتها بنفسك فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift מסיר רק אפליקציות שהתקנתם בעצמכם."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift فقط برنامه‌هایی را حذف می‌کند که خودتان نصب کرده‌اید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift премахва само приложения, които вие сте инсталирали."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift odstraňuje pouze aplikace, které jste nainstalovali sami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift fjerner kun apps, du selv har installeret."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sift αφαιρεί μόνο εφαρμογές που εγκαταστήσατε εσείς."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift solo elimina las aplicaciones que instalaste tú."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift poistaa vain itse asentamiasi sovelluksia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sift csak az Ön által telepített alkalmazásokat távolítja el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift hanya menghapus aplikasi yang Anda pasang sendiri."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift hanya membuang apl yang anda pasang sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",

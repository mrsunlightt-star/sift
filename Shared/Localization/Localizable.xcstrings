    "scan.results.trashHint": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to the Trash by default; recoverable until you empty it."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认移入废纸篓，清空废纸篓前可恢复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 휴지통으로 이동하며, 비우기 전까지 복구할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию в Корзину; можно восстановить до её очистки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mueve a la papelera; puedes recuperarlo hasta vaciarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定でゴミ箱に移動し、ゴミ箱を空にするまで復元できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

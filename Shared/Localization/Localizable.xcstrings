    "scan.running.readOnly": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads names, sizes and modification dates only. It never opens files or uploads data."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读取文件名、大小与修改时间，不打开内容、不上传任何数据"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 이름, 크기, 수정일만 읽습니다. 내용을 열거나 데이터를 업로드하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читаются только имена, размеры и даты изменения. Содержимое не открывается и никуда не отправляется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lee nombres, tamaños y fechas de modificación. No abre archivos ni sube datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前・サイズ・更新日のみを読み取ります。中身を開いたり送信したりしません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit uniquement les noms, tailles et dates. N’ouvre jamais les fichiers et n’envoie rien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest nur Namen, Größen und Änderungsdaten. Öffnet keine Dateien und lädt nichts hoch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge solo nomi, dimensioni e date di modifica. Non apre mai i file e non invia dati."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê apenas nomes, tamanhos e datas de modificação. Não abre arquivos nem envia dados."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只讀取檔名、大小與修改時間，不開啟內容、不上傳任何資料"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ad, boyut ve değişiklik tarihi okur. Dosyaları açmaz, veri göndermez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyta tylko nazwy, rozmiary i daty modyfikacji. Nie otwiera plików ani niczego nie wysyła."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest alleen namen, groottes en wijzigingsdata. Opent nooit bestanden en verstuurt niets."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອ່ານຊື່, ຂະໜາດ ແລະ ວັນທີແກ້ໄຂເທົ່ານັ້ນ. ບໍ່ເປີດເນື້ອໃນ ແລະ ບໍ່ສົ່ງຂໍ້ມູນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ الأسماء والأحجام وتواريخ التعديل فقط. لا يفتح الملفات ولا يرفع بيانات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קורא רק שמות, גדלים ותאריכי שינוי. אינו פותח קבצים ואינו שולח נתונים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط نام‌ها، اندازه‌ها و تاریخ‌های تغییر را می‌خواند. فایلی را باز نمی‌کند و داده‌ای نمی‌فرستد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Четат се само имена, размери и дати на промяна. Файловете никога не се отварят и нищо не се качва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čte pouze názvy, velikosti a data změny. Nikdy neotevírá soubory ani neodesílá data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læser kun navne, størrelser og ændringsdatoer. Åbner aldrig filer eller uploader data."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάζει μόνο ονόματα, μεγέθη και ημερομηνίες τροποποίησης. Δεν ανοίγει ποτέ αρχεία και δεν μεταφορτώνει δεδομένα."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lee nombres, tamaños y fechas de modificación. Nunca abre archivos ni sube datos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukee vain nimet, koot ja muutospäivämäärät. Ei koskaan avaa tiedostoja tai lataa tietoja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak neveket, méreteket és módosítási dátumokat olvas. Soha nem nyit meg fájlokat, és nem tölt fel adatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya membaca nama, ukuran, dan tanggal modifikasi. Tidak pernah membuka file atau mengunggah data."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya membaca nama, saiz dan tarikh pengubahsuaian. Ia tidak pernah membuka fail atau memuat naik data."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leser bare navn, størrelser og endringsdatoer. Åpner aldri filer eller laster opp data."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê apenas nomes, tamanhos e datas de modificação. Nunca abre ficheiros nem envia dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citește doar nume, dimensiuni și date de modificare. Nu deschide niciodată fișiere și nu încarcă date."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser bara namn, storlekar och ändringsdatum. Öppnar aldrig filer eller laddar upp data."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเฉพาะชื่อ ขนาด และวันที่แก้ไข ไม่เคยเปิดไฟล์หรืออัปโหลดข้อมูล"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читаються лише назви, розміри й дати зміни. Файли ніколи не відкриваються, і нічого не завантажується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ đọc tên, kích thước và ngày sửa đổi. Không bao giờ mở tệp hay tải dữ liệu lên."
          }
        }
      }
    },

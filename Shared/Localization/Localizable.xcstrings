    "diagnostics.explanation.coreSpotlight": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search metadata the system keeps for your own content, such as mail and messages. Rebuilding it can take a while, and search is incomplete until it finishes."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统为你的内容（邮件、信息等）保存的搜索元数据。重建可能耗时，重建期间搜索不完整。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일과 메시지 등 사용자 콘텐츠를 위해 시스템이 보관하는 검색 메타데이터입니다. 다시 만드는 데 시간이 걸리며, 끝날 때까지 검색이 불완전합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метаданные поиска, которые система хранит для ваших материалов — почты и сообщений. Перестроение занимает время, до его конца поиск неполон."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatos de búsqueda que el sistema guarda para tu contenido, como correo y mensajes. Reconstruirlos tarda un rato y la búsqueda queda incompleta hasta que termina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールやメッセージなど、あなたの内容のためにシステムが保持する検索メタデータです。再構築には時間がかかり、完了まで検索は不完全です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées de recherche que le système conserve pour vos contenus, comme le courrier et les messages. La reconstruction prend du temps et la recherche reste incomplète jusque-là."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchmetadaten, die das System für Ihre Inhalte wie Mail und Nachrichten vorhält. Der Neuaufbau dauert, bis dahin ist die Suche unvollständig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadati di ricerca che il sistema conserva per i tuoi contenuti, come mail e messaggi. Ricrearli richiede tempo e la ricerca resta incompleta finché non è finita."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadados de pesquisa que o sistema guarda para seu conteúdo, como e-mail e mensagens. Reconstruí-los demora e a busca fica incompleta até terminar."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統為你的內容（郵件、訊息等）保存的搜尋元資料。重建可能耗時，重建期間搜尋不完整。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin posta ve mesajlar gibi içerikleriniz için tuttuğu arama meta verileri. Yeniden oluşturmak zaman alır ve bitene kadar arama eksik kalır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadane wyszukiwania, które system przechowuje dla Twoich treści, jak poczta i wiadomości. Odbudowa trwa, a wyszukiwanie jest niekompletne, aż się skończy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekmetadata die het systeem bijhoudt voor je eigen inhoud, zoals mail en berichten. Herbouwen kost tijd en zoeken is incompleet totdat het klaar is."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເມຕາດຕາການຄົ້ນຫາທີ່ລະບົບເກັບໄວ້ສຳລັບເນື້ອໃນຂອງທ່ານ ເຊັ່ນ ໄມລ໌ ແລະ ຂໍ້ຄວາມ. ການສ້າງຄືນອາດໃຊ້ເວລາ ແລະ ການຄົ້ນຫາຈະບໍ່ຄົບຖ້ວນຈົນກວ່າຈະສຳເລັດ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات وصفية للبحث يحتفظ بها النظام لمحتواك، كالبريد والرسائل. إعادة بنائها تستغرق وقتًا ويبقى البحث ناقصًا حتى تنتهي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני חיפוש שהמערכת שומרת עבור התוכן שלכם, כגון דואר והודעות. בנייה מחדש לוקחת זמן והחיפוש בלתי שלם עד לסיומה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فرادادهٔ جست‌وجویی که سیستم برای محتوای شما — مثل ایمیل و پیام‌ها — نگه می‌دارد. بازسازی زمان می‌برد و تا پایان آن جست‌وجو ناقص است."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Метаданни за търсене, които системата пази за вашето съдържание, например поща и съобщения. Създаването им отново може да отнеме време и търсенето е непълно, докато не завърши."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata vyhledávání, která systém uchovává k vašemu obsahu, například k mailům a zprávám. Nové vytvoření může chvíli trvat a vyhledávání je do dokončení neúplné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgemetadata, som systemet gemmer for dit eget indhold, f.eks. mail og beskeder. Genopbygning kan tage tid, og søgning er ufuldstændig, indtil den er færdig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταδεδομένα αναζήτησης που κρατά το σύστημα για το δικό σας περιεχόμενο, όπως αλληλογραφία και μηνύματα. Η αναδημιουργία τους μπορεί να διαρκέσει, και η αναζήτηση είναι ελλιπής μέχρι να ολοκληρωθεί."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatos de búsqueda que el sistema guarda para tu propio contenido, como correo y mensajes. Reconstruirlos puede tardar y la búsqueda queda incompleta hasta que termina."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakumetatiedot, joita järjestelmä säilyttää omalle sisällöllesi, kuten sähköpostille ja viesteille. Uudelleenluonti voi kestää, ja haku on puutteellinen, kunnes se valmistuu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszer az Ön tartalmához, például levelekhez és üzenetekhez fenntartott keresési metaadatai. Az újraépítés eltarthat egy ideig, és a keresés addig hiányos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata pencarian yang disimpan sistem untuk konten Anda sendiri, seperti email dan pesan. Membangunnya ulang bisa memakan waktu, dan pencarian tidak lengkap sampai selesai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata carian yang disimpan sistem untuk kandungan anda sendiri, seperti mel dan mesej. Membinanya semula mungkin mengambil masa, dan carian tidak lengkap sehingga ia selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søkemetadata som systemet lagrer for ditt eget innhold, for eksempel e-post og meldinger. Å bygge det på nytt kan ta tid, og søk er ufullstendig til det er ferdig."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadados de pesquisa que o sistema guarda para o seu conteúdo, como correio e mensagens. Reconstruí-los pode demorar, e a pesquisa fica incompleta até terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadate de căutare pe care sistemul le păstrează pentru conținutul tău, cum ar fi e-mailurile și mesajele. Reconstruirea poate dura, iar căutarea este incompletă până se termină."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökmetadata som systemet sparar för ditt eget innehåll, till exempel e-post och meddelanden. Att bygga upp det igen kan ta tid, och sökningen är ofullständig tills det är klart."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลเมตาการค้นหาที่ระบบเก็บไว้สำหรับเนื้อหาของคุณ เช่น อีเมลและข้อความ การสร้างใหม่ใช้เวลาสักครู่ และการค้นหาจะไม่สมบูรณ์จนกว่าจะเสร็จ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Метадані пошуку, які система зберігає для вашого вмісту, наприклад пошти й повідомлень. Відбудова може тривати, і пошук неповний, доки вона не завершиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siêu dữ liệu tìm kiếm mà hệ thống lưu cho nội dung của bạn, như thư và tin nhắn. Việc tạo lại có thể mất một lúc và tìm kiếm sẽ chưa đầy đủ cho đến khi hoàn tất."
          }
        }
      }
    },
    "diagnostics.explanation.coreSpotlightUnreadable": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search metadata the system keeps for your own content. Its size could not be read: Full Disk Access is required."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统为你的内容保存的搜索元数据。无法读取它的大小：需要完全磁盘访问权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 사용자 콘텐츠를 위해 보관하는 검색 메타데이터입니다. 크기를 읽을 수 없습니다. 전체 디스크 접근 권한이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метаданные поиска, которые система хранит для ваших материалов. Размер прочитать не удалось: нужен полный доступ к диску."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatos de búsqueda que el sistema guarda para tu contenido. No se pudo leer su tamaño: se necesita acceso total al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの内容のためにシステムが保持する検索メタデータです。サイズを読み取れません。フルディスクアクセスが必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées de recherche conservées pour vos contenus. Leur taille n’a pas pu être lue : l’accès complet au disque est requis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchmetadaten für Ihre Inhalte. Die Größe war nicht lesbar: Vollzugriff auf die Festplatte ist nötig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadati di ricerca che il sistema conserva per i tuoi contenuti. Non è stata possibile leggere la dimensione: serve l’Accesso completo al disco."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadados de pesquisa que o sistema guarda para seu conteúdo. Não foi possível ler seu tamanho: é preciso o Acesso Total ao Disco."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統為你的內容保存的搜尋元資料。無法讀取它的大小：需要完全磁碟存取權限。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin içerikleriniz için tuttuğu arama meta verileri. Boyutu okunamadı: Tam Disk Erişimi gerekiyor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadane wyszukiwania przechowywane dla Twoich treści. Rozmiaru nie udało się odczytać: wymagany pełny dostęp do dysku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekmetadata voor je eigen inhoud. De grootte kon niet worden gelezen: Volledige Schijftoegang is nodig."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເມຕາດຕາການຄົ້ນຫາທີ່ລະບົບເກັບໄວ້ສຳລັບເນື້ອໃນຂອງທ່ານ. ອ່ານຂະໜາດບໍ່ໄດ້: ຕ້ອງມີສິດເຂົ້າເຖິງດິສກ໌ຢ່າງເຕັມສ່ວນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات وصفية للبحث يحتفظ بها النظام لمحتواك. تعذّرت قراءة حجمها: يلزم الوصول الكامل إلى القرص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני חיפוש שהמערכת שומרת עבור התוכן שלכם. לא ניתן היה לקרוא את גודלם: נדרשת גישה מלאה לכונן."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فرادادهٔ جست‌وجویی که سیستم برای محتوای شما نگه می‌دارد. خواندن اندازه‌اش ممکن نشد: دسترسی کامل به دیسک لازم است."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Метаданни за търсене, които системата пази за вашето съдържание. Размерът им не можа да бъде прочетен: нужен е Пълен достъп до диска."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata vyhledávání, která systém uchovává k vašemu obsahu. Jejich velikost nešlo zjistit: je potřeba Úplný přístup k disku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgemetadata, som systemet gemmer for dit eget indhold. Størrelsen kunne ikke læses: fuld diskadgang er påkrævet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταδεδομένα αναζήτησης που κρατά το σύστημα για το δικό σας περιεχόμενο. Δεν ήταν δυνατό να διαβαστεί το μέγεθός τους: απαιτείται Πλήρης πρόσβαση στον δίσκο."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatos de búsqueda que el sistema guarda para tu propio contenido. No se pudo leer su tamaño: se necesita Acceso total al disco."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakumetatiedot, joita järjestelmä säilyttää omalle sisällöllesi. Kokoa ei voitu lukea: täysi levynkäyttöoikeus vaaditaan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszer az Ön tartalmához fenntartott keresési metaadatai. A méretüket nem sikerült beolvasni: Teljes lemezhozzáférés szükséges."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata pencarian yang disimpan sistem untuk konten Anda sendiri. Ukurannya tidak dapat dibaca: Akses Disk Penuh diperlukan."

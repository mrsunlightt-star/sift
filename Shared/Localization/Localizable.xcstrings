    "cleanup.explanation.systemLogs": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System log files older than %d days. Some require Full Disk Access to read."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 天前的系统日志。部分需要完全磁盘访问权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d일이 지난 시스템 로그입니다. 일부는 전체 디스크 접근 권한이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системные журналы старше %d дней. Для некоторых нужен полный доступ к диску."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros del sistema de más de %d días. Algunos requieren acceso total al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 日より前のシステムログです。一部はフルディスクアクセスが必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux système de plus de %d jours. Certains exigent un accès complet au disque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemprotokolle älter als %d Tage. Einige erfordern vollständigen Festplattenzugriff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File di log di sistema più vecchi di %d giorni. Alcuni richiedono l’Accesso completo al disco."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs do sistema com mais de %d dias. Alguns exigem o Acesso Total ao Disco."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 天前的系統記錄檔。部分需要完全磁碟存取權限。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d günden eski sistem günlükleri. Bazılarını okumak Tam Disk Erişimi gerektirir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzienniki systemowe starsze niż %d dni. Odczyt niektórych wymaga pełnego dostępu do dysku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeemlogbestanden ouder dan %d dagen. Sommige lezen vereist Volledige Schijftoegang."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ບັນທຶກລະບົບທີ່ເກົ່າກວ່າ %d ວັນ. ບາງອັນຕ້ອງມີສິດເຂົ້າເຖິງດິສກ໌ຢ່າງເຕັມສ່ວນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات سجلات النظام أقدم من %d يومًا. بعضها يتطلب الوصول الكامل إلى القرص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובצי יומן מערכת בני יותר מ-%d ימים. חלקם דורש גישה מלאה לכונן."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گزارش‌های سیستم قدیمی‌تر از %d روز. برخی نیاز به دسترسی کامل به دیسک دارند."
          }
        }
      }
    },

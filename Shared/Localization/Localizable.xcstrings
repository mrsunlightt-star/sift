    "report.privacyNote": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report lists categories and sizes only. It contains no file names, paths or file contents."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本报告只列出分类和大小，不包含文件名、路径或文件内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보고서는 카테고리와 크기만 표시하며 파일 이름, 경로, 내용을 포함하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В отчёте только категории и размеры: без имён файлов, путей и содержимого."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este informe solo lista categorías y tamaños: sin nombres, rutas ni contenidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレポートは分類と容量のみです。ファイル名やパス、内容は含みません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce rapport ne liste que des catégories et des tailles : aucun nom, chemin ni contenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bericht nennt nur Kategorien und Größen: keine Dateinamen, Pfade oder Inhalte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rapporto elenca solo categorie e dimensioni. Non contiene nomi di file, percorsi né contenuti."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relatório lista apenas categorias e tamanhos. Não contém nomes de arquivos, caminhos nem conteúdos."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本報告只列出分類和大小，不包含檔名、路徑或檔案內容。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rapor yalnızca kategori ve boyutları listeler. Dosya adı, yol veya içerik içermez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten raport wymienia tylko kategorie i rozmiary. Nie zawiera nazw plików, ścieżek ani treści."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit rapport noemt alleen categorieën en groottes. Het bevat geen bestandsnamen, paden of inhoud."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລາຍງານນີ້ລາຍການປະເພດ ແລະ ຂະໜາດເທົ່ານັ້ນ. ບໍ່ມີຊື່ໄຟລ໌, ເສັ້ນທາງ ຫຼື ເນື້ອໃນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسرد هذا التقرير الفئات والأحجام فقط. لا يحتوي على أسماء ملفات أو مسارات أو محتويات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדוח הזה מפרט קטגוריות וגדלים בלבד. הוא אינו מכיל שמות קבצים, נתיבים או תוכן."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این گزارش فقط دسته‌ها و اندازه‌ها را فهرست می‌کند. شامل نام فایل، مسیر یا محتوا نیست."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този отчет изброява само категории и размери. Не съдържа имена на файлове, пътища или съдържание."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato zpráva uvádí jen kategorie a velikosti. Neobsahuje názvy souborů, cesty ani obsah souborů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne rapport viser kun kategorier og størrelser. Den indeholder ingen filnavne, stier eller filindhold."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η αναφορά απαριθμεί μόνο κατηγορίες και μεγέθη. Δεν περιέχει ονόματα αρχείων, διαδρομές ή περιεχόμενα αρχείων."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este informe solo indica categorías y tamaños. No contiene nombres de archivos, rutas ni contenidos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä raportti luettelee vain kategoriat ja koot. Se ei sisällä tiedostonimiä, polkuja tai tiedostojen sisältöä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a jelentés csak kategóriákat és méreteket sorol fel. Nem tartalmaz fájlneveket, elérési utakat vagy fájltartalmat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan ini hanya mencantumkan kategori dan ukuran. Tidak berisi nama file, jalur, atau konten file."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan ini menyenaraikan kategori dan saiz sahaja. Ia tidak mengandungi nama fail, laluan atau kandungan fail."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne rapporten viser bare kategorier og størrelser. Den inneholder ingen filnavn, stier eller filinnhold."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este relatório lista apenas categorias e tamanhos. Não contém nomes de ficheiros, caminhos nem conteúdos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest raport listează doar categorii și dimensiuni. Nu conține nume de fișiere, căi sau conținutul fișierelor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här rapporten visar bara kategorier och storlekar. Den innehåller inga filnamn, sökvägar eller filinnehåll."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายงานนี้แสดงเฉพาะหมวดหมู่และขนาด ไม่มีชื่อไฟล์ เส้นทาง หรือเนื้อหาไฟล์"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей звіт містить лише категорії та розміри. У ньому немає назв файлів, шляхів чи вмісту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo này chỉ liệt kê danh mục và kích thước. Không chứa tên tệp, đường dẫn hay nội dung tệp."
          }
        }
      }
    },

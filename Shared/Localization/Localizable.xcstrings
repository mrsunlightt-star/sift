          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este resultado cubre todo lo solicitado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要求した範囲をすべて確認しました。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce résultat couvre toute la portée demandée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ergebnis deckt den gesamten angeforderten Bereich ab."
          }
        }
      }
    },
    "diagnostics.coverage.note": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings to grant Full Disk Access, then run the analysis again."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中授予完全磁盘访问权限，然后重新运行诊断。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 전체 디스크 접근 권한을 허용한 뒤 다시 진단하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдайте полный доступ к диску в Системных настройках и запустите анализ снова."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede acceso total al disco en Ajustes del Sistema y vuelve a analizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でフルディスクアクセスを許可し、もう一度診断してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l’accès complet au disque dans les Réglages Système, puis relancez l’analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilen Sie in den Systemeinstellungen Vollzugriff auf die Festplatte und starten Sie die Analyse erneut."
          }
        }
      }
    },
    "diagnostics.coverage.partial": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the scope could not be measured, so the totals are a lower bound."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分范围无法统计，因此合计只是下限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 범위를 측정할 수 없어 합계는 최소값입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть области измерить не удалось, поэтому итоги — нижняя граница."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte del alcance no se pudo medir, así que los totales son un mínimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部を測定できなかったため、合計は下限値です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de la portée n’a pas pu être mesurée : les totaux sont un minimum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil des Bereichs war nicht messbar, die Summen sind also Untergrenzen."
          }
        }
      }
    },
    "diagnostics.coverage.permissionDenied": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some locations need Full Disk Access before they can be measured."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分位置需要完全磁盘访问权限才能统计。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 위치는 전체 디스크 접근 권한이 있어야 측정할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть мест требует полного доступа к диску."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas ubicaciones necesitan acceso total al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の場所はフルディスクアクセスが必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains emplacements nécessitent un accès complet au disque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Orte benötigen Vollzugriff auf die Festplatte."
          }
        }
      }
    },
    "diagnostics.coverage.volumeUnavailable": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A volume is no longer available, so it was not measured."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一个卷已不可用，未做统计。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 수 없는 볼륨이 있어 측정하지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один том недоступен и не измерялся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volumen ya no está disponible y no se midió."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できないボリュームがあり、測定していません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volume n’est plus disponible et n’a pas été mesuré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Volume ist nicht mehr verfügbar und wurde nicht gemessen."
          }
        }
      }
    },
    "diagnostics.empty": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing large was found in this scope."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此范围内没有发现占用较大的内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 범위에서 큰 항목을 찾지 못했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой области ничего крупного не найдено."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró nada voluminoso en este alcance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この範囲には大きな項目はありませんでした。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de volumineux dans cette portée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Bereich wurde nichts Großes gefunden."
          }
        }
      }
    },
    "diagnostics.explanation.coreSpotlight": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search metadata the system keeps for your own content, such as mail and messages. Rebuilding it can take a while, and search is incomplete until it finishes."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统为你的内容（邮件、信息等）保存的搜索元数据。重建可能耗时，重建期间搜索不完整。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일과 메시지 등 사용자 콘텐츠를 위해 시스템이 보관하는 검색 메타데이터입니다. 다시 만드는 데 시간이 걸리며, 끝날 때까지 검색이 불완전합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метаданные поиска, которые система хранит для ваших материалов — почты и сообщений. Перестроение занимает время, до его конца поиск неполон."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatos de búsqueda que el sistema guarda para tu contenido, como correo y mensajes. Reconstruirlos tarda un rato y la búsqueda queda incompleta hasta que termina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールやメッセージなど、あなたの内容のためにシステムが保持する検索メタデータです。再構築には時間がかかり、完了まで検索は不完全です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées de recherche que le système conserve pour vos contenus, comme le courrier et les messages. La reconstruction prend du temps et la recherche reste incomplète jusque-là."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchmetadaten, die das System für Ihre Inhalte wie Mail und Nachrichten vorhält. Der Neuaufbau dauert, bis dahin ist die Suche unvollständig."
          }
        }
      }
    },
    "diagnostics.explanation.coreSpotlightUnreadable": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search metadata the system keeps for your own content. Its size could not be read: Full Disk Access is required."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统为你的内容保存的搜索元数据。无法读取它的大小：需要完全磁盘访问权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 사용자 콘텐츠를 위해 보관하는 검색 메타데이터입니다. 크기를 읽을 수 없습니다. 전체 디스크 접근 권한이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метаданные поиска, которые система хранит для ваших материалов. Размер прочитать не удалось: нужен полный доступ к диску."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadatos de búsqueda que el sistema guarda para tu contenido. No se pudo leer su tamaño: se necesita acceso total al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの内容のためにシステムが保持する検索メタデータです。サイズを読み取れません。フルディスクアクセスが必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Métadonnées de recherche conservées pour vos contenus. Leur taille n’a pas pu être lue : l’accès complet au disque est requis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchmetadaten für Ihre Inhalte. Die Größe war nicht lesbar: Vollzugriff auf die Festplatte ist nötig."
          }
        }
      }
    },
    "diagnostics.explanation.developerData": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build data and caches a development tool keeps here. Sift does not judge what a project can rebuild, so nothing here is offered for removal."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发工具存放的构建数据和缓存。Sift 无法判断某个项目能重建什么，因此这里的内容不会被列为可删除项。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 도구가 보관하는 빌드 데이터와 캐시입니다. Sift는 프로젝트가 무엇을 다시 만들 수 있는지 판단하지 않으므로 삭제 대상으로 제시하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные сборки и кэши, которые хранит инструмент разработки. Sift не может судить, что проект перестроит, поэтому ничего отсюда не предлагается к удалению."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de compilación y cachés que guarda una herramienta de desarrollo. Sift no juzga qué puede reconstruir un proyecto, así que no ofrece nada de aquí para eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発ツールが置くビルドデータとキャッシュです。Sift はプロジェクトが何を再構築できるか判断しないため、ここから削除対象として提示しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de compilation et caches conservés par un outil de développement. Sift ne juge pas ce qu’un projet peut reconstruire et ne propose donc rien à supprimer ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build-Daten und Caches eines Entwicklungswerkzeugs. Sift beurteilt nicht, was ein Projekt neu aufbauen kann, und bietet hier nichts zum Entfernen an."
          }
        }
      }
    },
    "diagnostics.explanation.developerIndex": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An index a development tool built for this project. The tool rebuilds it on demand; until then, code completion and symbol search are slower."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发工具为此项目建立的索引。需要时该工具会重建；在重建前，代码补全和符号搜索会更慢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 도구가 이 프로젝트를 위해 만든 색인입니다. 필요할 때 도구가 다시 만들며, 그때까지 코드 완성과 심볼 검색이 느려집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс, который инструмент разработки построил для проекта. Он перестроит его при необходимости; до этого автодополнение и поиск символов медленнее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice que una herramienta de desarrollo creó para este proyecto. La herramienta lo reconstruye cuando hace falta; hasta entonces el autocompletado y la búsqueda de símbolos son más lentos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発ツールがこのプロジェクト用に作成した索引です。必要になればツールが再構築します。それまで補完とシンボル検索は遅くなります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Index qu’un outil de développement a créé pour ce projet. L’outil le reconstruit à la demande ; d’ici là, la complétion et la recherche de symboles sont plus lentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Index, den ein Entwicklungswerkzeug für dieses Projekt erstellt hat. Das Werkzeug baut ihn bei Bedarf neu auf; bis dahin sind Vervollständigung und Symbolsuche langsamer."
          }
        }
      }
    },
    "diagnostics.explanation.snapshots": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS local snapshots. They hold the state of the volume, macOS thins them by itself, and no per-snapshot size is reported by the system."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 本地快照。它们保存卷的状态，macOS 会自动精简，系统不提供单个快照的占用大小。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 로컬 스냅샷입니다. 볼륨 상태를 보관하며 macOS가 스스로 정리합니다. 스냅샷별 크기는 시스템이 제공하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные снимки APFS. Они хранят состояние тома, macOS прореживает их сама, размер отдельного снимка система не сообщает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantáneas locales de APFS. Guardan el estado del volumen, macOS las reduce por su cuenta y el sistema no informa del tamaño de cada una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS のローカルスナップショットです。ボリュームの状態を保持し、macOS が自動的に間引きます。個別のサイズはシステムから提供されません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantanés locaux APFS. Ils conservent l’état du volume, macOS les élague lui-même, et le système ne fournit pas de taille par instantané."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale APFS-Snapshots. Sie halten den Zustand des Volumes, macOS dünnt sie selbst aus, und das System meldet keine Größe je Snapshot."
          }
        }
      }
    },
    "diagnostics.explanation.spotlightIndexed": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight's index for this volume; indexing is currently on. macOS rebuilds it with mdutil -E — moving it to the Trash only makes search unavailable until it is rebuilt."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卷的 Spotlight 索引，索引服务当前已启用。macOS 可用 mdutil -E 重建；直接移入废纸篓只会让搜索在重建完成前不可用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 볼륨의 Spotlight 색인이며 색인이 켜져 있습니다. macOS는 mdutil -E로 다시 만듭니다. 휴지통으로 옮기면 다시 만들어질 때까지 검색만 사용할 수 없게 됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс Spotlight для этого тома; индексация включена. macOS перестраивает его через mdutil -E — перемещение в Корзину лишь отключит поиск до перестроения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice de Spotlight de este volumen; la indexación está activada. macOS lo reconstruye con mdutil -E: moverlo a la Papelera solo deja la búsqueda inutilizable hasta que se reconstruya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボリュームの Spotlight インデックスで、現在は索引が有効です。macOS は mdutil -E で再構築します。ゴミ箱に移しても、再構築が終わるまで検索が使えなくなるだけです。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Index Spotlight de ce volume ; l’indexation est active. macOS le reconstruit avec mdutil -E : le placer dans la Corbeille rend simplement la recherche indisponible jusqu’à la reconstruction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight-Index dieses Volumes; die Indizierung ist aktiv. macOS baut ihn mit mdutil -E neu auf – in den Papierkorb gelegt wird nur die Suche unbrauchbar, bis er neu aufgebaut ist."
          }
        }
      }
    },
    "diagnostics.explanation.spotlightNotIndexed": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight's index for this volume; indexing currently reports as off. macOS manages this directory."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卷的 Spotlight 索引，当前索引服务处于关闭状态。此目录由 macOS 管理。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 볼륨의 Spotlight 색인이며 현재 색인이 꺼져 있습니다. 이 디렉터리는 macOS가 관리합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс Spotlight для этого тома; индексация сейчас отключена. Каталог управляется macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice de Spotlight de este volumen; la indexación figura como desactivada. macOS gestiona este directorio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボリュームの Spotlight インデックスで、現在は索引が無効です。このフォルダは macOS が管理します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Index Spotlight de ce volume ; l’indexation est signalée comme inactive. Ce dossier est géré par macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight-Index dieses Volumes; die Indizierung meldet sich als aus. Dieses Verzeichnis verwaltet macOS."
          }
        }
      }
    },
    "diagnostics.explanation.spotlightStateUnknown": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight's index for this volume. What Spotlight is currently doing could not be read."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卷的 Spotlight 索引。无法读取 Spotlight 当前的状态。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 볼륨의 Spotlight 색인입니다. 현재 Spotlight 상태를 읽을 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс Spotlight для этого тома. Текущее состояние Spotlight прочитать не удалось."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice de Spotlight de este volumen. No se pudo leer qué está haciendo Spotlight ahora mismo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボリュームの Spotlight インデックスです。現在の状態を読み取れませんでした。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Index Spotlight de ce volume. L’état actuel de Spotlight n’a pas pu être lu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight-Index dieses Volumes. Der aktuelle Zustand war nicht lesbar."
          }
        }
      }
    },
    "diagnostics.explanation.spotlightUnreadable": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight's index for this volume. Its size could not be read: Full Disk Access is required."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卷的 Spotlight 索引。无法读取它的大小：需要完全磁盘访问权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 볼륨의 Spotlight 색인입니다. 크기를 읽을 수 없습니다. 전체 디스크 접근 권한이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс Spotlight для этого тома. Размер прочитать не удалось: нужен полный доступ к диску."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice de Spotlight de este volumen. No se pudo leer su tamaño: se necesita acceso total al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボリュームの Spotlight インデックスです。サイズを読み取れません。フルディスクアクセスが必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Index Spotlight de ce volume. Sa taille n’a pas pu être lue : l’accès complet au disque est requis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight-Index dieses Volumes. Die Größe war nicht lesbar: Vollzugriff auf die Festplatte ist nötig."
          }
        }
      }
    },
    "diagnostics.explanation.systemData": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of macOS or its libraries. It occupies space and cannot be removed."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属于 macOS 或其系统库。它占用空间，但不能删除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 또는 시스템 라이브러리의 일부입니다. 공간을 차지하지만 삭제할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть macOS или её библиотек. Занимает место и не может быть удалена."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de macOS o de sus bibliotecas. Ocupa espacio y no se puede eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS またはそのライブラリの一部です。容量を使いますが削除できません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait partie de macOS ou de ses bibliothèques. Occupe de l’espace et ne peut pas être supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teil von macOS oder dessen Bibliotheken. Belegt Platz und darf nicht entfernt werden."
          }
        }
      }
    },
    "diagnostics.explanation.volumeChild": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A directory at the top level of the volume."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷根目录下的一个目录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨 최상위의 디렉터리입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог верхнего уровня тома."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un directorio en el nivel superior del volumen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリューム直下のフォルダです。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier à la racine du volume."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Verzeichnis auf oberster Ebene des Volumes."
          }
        }
      }
    },
    "diagnostics.intro": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What actually occupies the disk, what it is, and whether it can be rebuilt. This page never removes anything."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘空间究竟被什么占用、这些数据是什么、能否重建。此页面不会删除任何内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크를 실제로 차지하는 것, 그것이 무엇인지, 다시 만들 수 있는지 보여 줍니다. 이 페이지는 아무것도 삭제하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что на самом деле занимает диск, что это и можно ли это перестроить. Эта страница ничего не удаляет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué ocupa realmente el disco, qué es y si se puede reconstruir. Esta página no elimina nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクを実際に占めているもの、それが何か、再構築できるかを示します。このページは何も削除しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui occupe réellement le disque, ce que c’est et si cela peut être reconstruit. Cette page ne supprime rien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Festplatte tatsächlich belegt, was es ist und ob es sich neu aufbauen lässt. Diese Seite entfernt nichts."
          }
        }
      }
    },
    "diagnostics.note.approximate": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizes are estimates: clones and snapshots make allocated space non-additive."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小是估算值：克隆和快照会使分配空间不能简单相加。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기는 추정값입니다. 클론과 스냅샷 때문에 할당 공간은 단순 합산이 되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размеры приблизительны: из-за клонов и снимков выделенное место не складывается напрямую."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tamaños son estimaciones: los clones y las instantáneas hacen que el espacio asignado no sea aditivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズは推定値です。クローンやスナップショットがあるため、割り当て容量は単純に合計できません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tailles sont estimées : les clones et les instantanés rendent l’espace alloué non additif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größen sind Schätzwerte: Klone und Snapshots machen belegten Speicher nicht addierbar."
          }
        }
      }
    },
    "diagnostics.note.readOnly": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics only reads. Nothing here is removed, and a cleanup still goes through the normal confirmation."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断只做读取。这里的任何内容都不会被删除；如要清理，仍会走正常的确认流程。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단은 읽기만 합니다. 여기서 아무것도 삭제되지 않으며, 정리는 평소의 확인 절차를 거칩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика только читает. Здесь ничего не удаляется, а очистка по-прежнему проходит обычное подтверждение."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diagnóstico solo lee. Aquí no se elimina nada y cualquier limpieza pasa por la confirmación habitual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断は読み取りのみです。ここでは何も削除されず、整理する場合も通常の確認を行います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le diagnostic ne fait que lire. Rien n’est supprimé ici, et un nettoyage passe toujours par la confirmation habituelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diagnose liest nur. Hier wird nichts entfernt, und eine Bereinigung durchläuft weiterhin die übliche Bestätigung."
          }
        }
      }
    },

    "diagnostics.explanation.spotlightUnreadable": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight's index for this volume. Its size could not be read: Full Disk Access is required."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卷的 Spotlight 索引。无法读取它的大小：需要完全磁盘访问权限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 볼륨의 Spotlight 색인입니다. 크기를 읽을 수 없습니다. 전체 디스크 접근 권한이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индекс Spotlight для этого тома. Размер прочитать не удалось: нужен полный доступ к диску."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Índice de Spotlight de este volumen. No se pudo leer su tamaño: se necesita acceso total al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボリュームの Spotlight インデックスです。サイズを読み取れません。フルディスクアクセスが必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Index Spotlight de ce volume. Sa taille n’a pas pu être lue : l’accès complet au disque est requis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight-Index dieses Volumes. Die Größe war nicht lesbar: Vollzugriff auf die Festplatte ist nötig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indice Spotlight di questo volume. Non è stata possibile leggere la dimensione: serve l’Accesso completo al disco."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O índice do Spotlight deste volume. Não foi possível ler seu tamanho: é preciso o Acesso Total ao Disco."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此卷宗的 Spotlight 索引。無法讀取它的大小：需要完全磁碟存取權限。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu birimin Spotlight dizini. Boyutu okunamadı: Tam Disk Erişimi gerekiyor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks Spotlight tego wolumenu. Nie udało się odczytać jego rozmiaru: wymagany pełny dostęp do dysku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Spotlight-index van dit volume. De grootte kon niet worden gelezen: Volledige Schijftoegang is nodig."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດັດຊະນີ Spotlight ຂອງຣະບົບນີ້. ອ່ານຂະໜາດບໍ່ໄດ້: ຕ້ອງມີສິດເຂົ້າເຖິງດິສກ໌ຢ່າງເຕັມສ່ວນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرس Spotlight لهذا الحجم. تعذّرت قراءة حجمه: يلزم الوصول الكامل إلى القرص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אינדקס ה-Spotlight של הכונן הזה. לא ניתן היה לקרוא את גודלו: נדרשת גישה מלאה לכונן."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایهٔ Spotlight این حجم. خواندن اندازه‌اش ممکن نشد: دسترسی کامل به دیسک لازم است."
          }
        }
      }
    },
    "diagnostics.explanation.systemData": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of macOS or its libraries. It occupies space and cannot be removed."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属于 macOS 或其系统库。它占用空间，但不能删除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 또는 시스템 라이브러리의 일부입니다. 공간을 차지하지만 삭제할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть macOS или её библиотек. Занимает место и не может быть удалена."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de macOS o de sus bibliotecas. Ocupa espacio y no se puede eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS またはそのライブラリの一部です。容量を使いますが削除できません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait partie de macOS ou de ses bibliothèques. Occupe de l’espace et ne peut pas être supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teil von macOS oder dessen Bibliotheken. Belegt Platz und darf nicht entfernt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte di macOS o delle sue librerie. Occupa spazio e non si può rimuovere."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do macOS ou de suas bibliotecas. Ocupa espaço e não pode ser removida."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屬於 macOS 或其系統程式庫。它佔用空間，但不能刪除。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS’un veya kitaplıklarının bir parçası. Yer kaplar ve kaldırılamaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część macOS lub jego bibliotek. Zajmuje miejsce i nie można jej usunąć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderdeel van macOS of diens bibliotheken. Neemt ruimte in en kan niet verwijderd worden."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປັນສ່ວນໜຶ່ງຂອງ macOS ຫຼື ຄັງສະຄຣິບຂອງມັນ. ກິນພື້ນທີ່ ແຕ່ລຶບອອກບໍ່ໄດ້."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزء من macOS أو مكتباته. يشغل مساحة ولا يمكن إزالته."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מ-macOS או מהספריות שלו. תופס שטח ואינו ניתן להסרה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بخشی از مک‌او‌اس یا کتابخانه‌هایش. فضا اشغال می‌کند و قابل حذف نیست."
          }
        }
      }
    },

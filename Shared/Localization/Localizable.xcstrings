        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ne touche pas à cet emplacement pour protéger vos fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift lässt diesen Ort zum Schutz Ihrer Dateien unberührt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift non tocca mai questa posizione, per proteggere i tuoi file."
          }
        },

          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایلی بزرگ. Sift حدس نمی‌زند: تصمیم حذف با شماست."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Голям файл. Sift никога не гадае: вие решавате дали да го премахнете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velký soubor. Sift nic neodhaduje: rozhodujete vy, co odstranit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En stor fil. Sift gætter aldrig: du beslutter, hvad der skal fjernes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μεγάλο αρχείο. Το Sift δεν μαντεύει: εσείς αποφασίζετε αν θα αφαιρεθεί."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo grande. Sift no adivina: tú decides cuáles eliminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuri tiedosto. Sift ei koskaan arvaa: sinä päätät, poistetaanko se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagy fájl. A Sift soha nem találgat: Ön dönti el, mi kerüljön eltávolításra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File besar. Sift tidak pernah menebak: Anda yang memutuskan mana yang dihapus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail besar. Sift tidak pernah meneka: anda yang menentukan yang mana untuk dibuang."

    "storage.suggestionDetail": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with caches and old installers, then scan again to confirm."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先处理缓存和旧安装包，再扫描一次确认。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시와 오래된 설치 파일부터 처리한 뒤 다시 검사하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с кэшей и старых установщиков, затем просканируйте снова."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por las cachés y los instaladores antiguos; luego analiza de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュと古いインストーラから処理し、もう一度スキャンしてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par les caches et les anciens installateurs, puis relancez l’analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit Caches und alten Installern und scannen Sie dann erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia da cache e installer datati, poi scansiona di nuovo per confermare."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece por caches e instaladores antigos e verifique novamente para confirmar."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先處理快取和舊安裝程式，再掃描一次確認。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellek ve eski yükleyicilerle başlayın, sonra doğrulamak için yeniden tarayın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od pamięci podręcznych i starych instalatorów, potem skanuj ponownie dla potwierdzenia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met caches en oude installatieprogramma’s en scan daarna opnieuw ter bevestiging."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເລີ່ມຈາກແຄຊ໌ ແລະ ໂປຣແກຣມຕິດຕັ້ງເກົ່າ ແລ້ວສະແກນຄືນເພື່ອຢືນຢັນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بالذاكرات المؤقتة وبرامج التثبيت القديمة، ثم افحص مجددًا للتأكيد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו במטמונים ובמתקינים ישנים ואז סרקו שוב לאישוש."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با حافظه‌های نهانی و نصب‌کننده‌های قدیمی شروع کنید و سپس برای اطمینان دوباره اسکن بگیرید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Започнете с кешове и стари инсталатори, след което сканирайте отново, за да потвърдите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte mezipamětmi a starými instalátory, poté skenujte znovu pro potvrzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynd med caches og gamle installationsprogrammer, og scan derefter igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε με cache και παλιά προγράμματα εγκατάστασης και, στη συνέχεια, σαρώστε ξανά για επιβεβαίωση."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por las cachés y los instaladores antiguos; después vuelve a analizar para confirmar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita välimuisteista ja vanhoista asennusohjelmista ja skannaa sitten uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdje a gyorsítótárakkal és a régi telepítőkkel, majd vizsgáljon újra az ellenőrzéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan cache dan penginstal lama, lalu pindai lagi untuk memastikan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan dengan cache dan pemasang lama, kemudian imbas semula untuk mengesahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynn med cacher og gamle installasjonsprogrammer, og skann deretter på nytt."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece pelas caches e pelos instaladores antigos e, em seguida, verifique novamente para confirmar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începe cu cache-urile și instalatoarele vechi, apoi scanează din nou pentru a confirma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja med cacher och gamla installationsprogram och skanna sedan igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",

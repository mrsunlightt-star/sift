    "permission.fullDiskAccessDetail": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scans caches and logs without it. Granting Full Disk Access lets it also read system logs and app support folders."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 无需该权限也能扫描缓存和日志。授予完全磁盘访问权限后，还可读取系统日志和应用支持目录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift는 이 권한 없이도 캐시와 로그를 검사합니다. 허용하면 시스템 로그와 앱 지원 폴더도 읽습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift сканирует кэши и логи и без него. С ним также читаются системные логи и папки приложений."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift analiza cachés y registros sin ello. Concediéndolo, también lee registros del sistema y carpetas de apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この権限がなくてもキャッシュとログはスキャンできます。許可するとシステムログやアプリのサポートフォルダも読めます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift analyse caches et journaux sans lui. Accordé, il lit aussi les journaux système et les dossiers d’apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scannt Caches und Protokolle auch ohne. Mit ihm liest es zusätzlich Systemprotokolle und App-Ordner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scansiona cache e log anche senza. Concedendo l’Accesso completo al disco legge anche i log di sistema e le cartelle di supporto delle app."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift verifica caches e logs sem isso. Ao conceder o Acesso Total ao Disco, ele também lê logs do sistema e pastas de suporte dos apps."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 無需該權限也能掃描快取和記錄檔。授予完全磁碟存取權限後，還可讀取系統記錄檔和應用程式支援目錄。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift bu izin olmadan da önbellek ve günlükleri tarar. İzin verilirse sistem günlüklerini ve uygulama destek klasörlerini de okur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift skanuje pamięci podręczne i dzienniki bez tego. Po nadaniu pełnego dostępu do dysku czyta także dzienniki systemowe i foldery aplikacji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scant caches en logbestanden ook zonder. Met Volledige Schijftoegang leest het ook systeemlogbestanden en app-ondersteuningsmappen."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ສະແກນແຄຊ໌ ແລະ ໄຟລ໌ບັນທຶກໄດ້ໂດຍບໍ່ຕ້ອງສິດນີ້. ເມື່ອອະນຸຍາດແລ້ວ ຈະອ່ານໄຟລ໌ບັນທຶກລະບົບ ແລະ ໂຟນເດີສະໜັບສະໜູນແອັບໄດ້ນຳ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص Sift الذاكرات المؤقتة والسجلات بدون ذلك. بمنح الوصول الكامل إلى القرص، يقرأ أيضًا سجلات النظام ومجلدات دعم التطبيقات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift סורק מטמונים ויומנים גם בלי זה. מתן גישה מלאה לכונן מאפשר לו לקרוא גם יומני מערכת ותיקיות תמיכה של אפליקציות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift بدون این مجوز هم حافظه‌های نهانی و گزارش‌ها را اسکن می‌کند. با دادن دسترسی کامل به دیسک، گزارش‌های سیستم و پوشه‌های پشتیبانی برنامه‌ها را هم می‌خواند."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift сканира кешове и журнали и без него. С Пълен достъп до диска той може да чете и системни журнали и папки за поддръжка на приложения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift skenuje mezipaměti a protokoly i bez něj. S Úplným přístupem k disku může číst i systémové protokoly a složky podpory aplikací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scanner caches og logfiler uden den. Med fuld diskadgang kan den også læse systemlogfiler og app-supportmapper."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sift σαρώνει cache και αρχεία καταγραφής και χωρίς αυτή. Με την Πλήρη πρόσβαση στον δίσκο μπορεί να διαβάζει και αρχεία καταγραφής συστήματος και φακέλους υποστήριξης εφαρμογών."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift analiza cachés y registros sin este acceso. Al concederlo, también puede leer registros del sistema y carpetas de soporte de aplicaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift skannaa välimuistit ja lokit ilman sitä. Täysi levynkäyttöoikeus antaa sen lukea myös järjestelmän lokit ja sovellusten tukikansiot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sift e nélkül is vizsgálja a gyorsítótárakat és naplókat. A Teljes lemezhozzáférés megadásával a rendszernaplókat és az alkalmazástámogató mappákat is be tudja olvasni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift memindai cache dan log tanpa ini. Memberikan Akses Disk Penuh memungkinkannya juga membaca log sistem dan folder dukungan aplikasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift mengimbas cache dan log tanpanya. Memberikan Akses Cakera Penuh membolehkannya turut membaca log sistem dan folder sokongan apl."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift skanner cacher og loggfiler uten den. Med full disktilgang kan den også lese systemloggfiler og appstøttemapper."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift verifica caches e registos sem este acesso. Ao conceder Acesso Total ao Disco, também pode ler registos do sistema e pastas de suporte das aplicações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scanează cache-urile și jurnalele și fără el. Acordarea Accesului complet la disc îi permite să citească și jurnalele de sistem și folderele de suport ale aplicațiilor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift skannar cacher och loggar utan den. Med fullskivåtkomst kan den även läsa systemloggar och appsupportmappar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift สแกนแคชและบันทึกได้โดยไม่ต้องใช้สิทธิ์นี้ การอนุญาตการเข้าถึงดิสก์ทั้งหมดทำให้อ่านบันทึกของระบบและโฟลเดอร์สนับสนุนแอปได้ด้วย"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift сканує кеші й журнали й без нього. З Повним доступом до диска він також читає системні журнали й папки підтримки програм."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift quét bộ nhớ đệm và nhật ký mà không cần quyền này. Cấp Quyền truy cập Toàn bộ Đĩa cho phép đọc cả nhật ký hệ thống và thư mục hỗ trợ ứng dụng."
          }
        }
      }
    },

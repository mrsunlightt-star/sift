        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先处理缓存和旧安装包，再扫描一次确认。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시와 오래된 설치 파일부터 처리한 뒤 다시 검사하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с кэшей и старых установщиков, затем просканируйте снова."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por las cachés y los instaladores antiguos; luego analiza de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュと古いインストーラから処理し、もう一度スキャンしてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par les caches et les anciens installateurs, puis relancez l’analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit Caches und alten Installern und scannen Sie dann erneut."
          }
        }
      }
    },

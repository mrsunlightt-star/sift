    "purchase.licenseRequiredDetail": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning, analysis and previews stay free. Cleaning and uninstalling need the one-time purchase."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描、分析和预览始终免费。清理和卸载需要一次性购买。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔, 분석, 미리보기는 무료입니다. 정리와 제거에는 한 번 구매가 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование, анализ и предпросмотр бесплатны. Очистка и удаление требуют покупки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear, analizar y previsualizar es gratis. Limpiar y desinstalar requiere la compra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン・分析・プレビューは無料です。削除とアンインストールには買い切り購入が必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse et aperçu gratuits. Nettoyage et désinstallation nécessitent l’achat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen, Analyse und Vorschau bleiben gratis. Bereinigen und Deinstallieren kosten einmalig."
          }
        }
      }
    },

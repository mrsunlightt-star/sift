    },
    "diagnostics.intro": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What actually occupies the disk, what it is, and whether it can be rebuilt. This page never removes anything."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘空间究竟被什么占用、这些数据是什么、能否重建。此页面不会删除任何内容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크를 실제로 차지하는 것, 그것이 무엇인지, 다시 만들 수 있는지 보여 줍니다. 이 페이지는 아무것도 삭제하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что на самом деле занимает диск, что это и можно ли это перестроить. Эта страница ничего не удаляет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué ocupa realmente el disco, qué es y si se puede reconstruir. Esta página no elimina nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクを実際に占めているもの、それが何か、再構築できるかを示します。このページは何も削除しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui occupe réellement le disque, ce que c’est et si cela peut être reconstruit. Cette page ne supprime rien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Festplatte tatsächlich belegt, was es ist und ob es sich neu aufbauen lässt. Diese Seite entfernt nichts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa occupa davvero il disco, che cosa è e se si può ricreare. Questa pagina non rimuove mai nulla."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O que realmente ocupa o disco, o que é e se pode ser reconstruído. Esta página nunca remove nada."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "磁碟空間究竟被什麼佔用、這些資料是什麼、能否重建。此頁面不會刪除任何內容。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diski gerçekte ne kaplıyor, bu nedir ve yeniden oluşturulabilir mi. Bu sayfa hiçbir şeyi kaldırmaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co naprawdę zajmuje dysk, czym to jest i czy można to odtworzyć. Ta strona niczego nie usuwa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat de schijf echt bezet houdt, wat het is en of het herbouwd kan worden. Deze pagina verwijdert nooit iets."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຫຍັງກິນພື້ນທີ່ດິສກ໌ຢ່າງແທ້ຈິງ, ມັນແມ່ນຫຍັງ, ແລະ ສ້າງຄືນໄດ້ບໍ. ໜ້ານີ້ບໍ່ລຶບອອກເລີຍ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يشغل القرص فعليًا، وما هو، وهل يمكن إعادة بنائه. هذه الصفحة لا تزيل شيئًا أبدًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה באמת תופס את הכונן, מה זה והאם אפשר לבנות מחדש. העמוד הזה לעולם לא מסיר דבר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "واقعاً چه چیزی دیسک را اشغال کرده، آن چیست و آیا بازسازی می‌شود. این صفحه هرگز چیزی حذف نمی‌کند."
          }
        }
      }
    },
    "diagnostics.note.approximate": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizes are estimates: clones and snapshots make allocated space non-additive."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小是估算值：克隆和快照会使分配空间不能简单相加。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기는 추정값입니다. 클론과 스냅샷 때문에 할당 공간은 단순 합산이 되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размеры приблизительны: из-за клонов и снимков выделенное место не складывается напрямую."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tamaños son estimaciones: los clones y las instantáneas hacen que el espacio asignado no sea aditivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズは推定値です。クローンやスナップショットがあるため、割り当て容量は単純に合計できません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tailles sont estimées : les clones et les instantanés rendent l’espace alloué non additif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größen sind Schätzwerte: Klone und Snapshots machen belegten Speicher nicht addierbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dimensioni sono stime: cloni e snapshot rendono lo spazio allocato non additivo."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tamanhos são estimativas: clones e snapshots fazem o espaço alocado não ser aditivo."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大小是估算值：克隆和快照會使分配空間不能簡單相加。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyutlar tahminidir: klonlar ve anlık görüntüler ayrılan alanı toplanabilir yapmaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmiary są przybliżone: klony i migawki powodują, że zajętość nie sumuje się wprost."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groottes zijn schattingen: klonen en snapshots maken de toegewezen ruimte niet-additief."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຂະໜາດເປັນຄ່າປະມານ: ການກ໋ອບ ແລະ Snapshot ເຮັດໃຫ້ພື້ນທີ່ທີ່ຈັດສັນບໍ່ບວກກັນງ່າຍໆ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأحجام تقديرية: النسخ المتطابقة واللقطات تجعل المساحة المخصصة غير قابلة للجمع المباشر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדלים הם הערכות: שכפולים ותמונות מצב הופכים את השטח המוקצה לבלתי-ניתן לחיבור פשוט."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اندازه‌ها تخمینی‌اند: کپی‌های همسان و عکس‌های فوری باعث می‌شوند فضای تخصیص‌یافته جمع‌شدنی ساده نباشد."
          }
        }
      }
    },
    "diagnostics.note.readOnly": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics only reads. Nothing here is removed, and a cleanup still goes through the normal confirmation."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断只做读取。这里的任何内容都不会被删除；如要清理，仍会走正常的确认流程。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단은 읽기만 합니다. 여기서 아무것도 삭제되지 않으며, 정리는 평소의 확인 절차를 거칩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика только читает. Здесь ничего не удаляется, а очистка по-прежнему проходит обычное подтверждение."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diagnóstico solo lee. Aquí no se elimina nada y cualquier limpieza pasa por la confirmación habitual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断は読み取りのみです。ここでは何も削除されず、整理する場合も通常の確認を行います。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le diagnostic ne fait que lire. Rien n’est supprimé ici, et un nettoyage passe toujours par la confirmation habituelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diagnose liest nur. Hier wird nichts entfernt, und eine Bereinigung durchläuft weiterhin die übliche Bestätigung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La diagnostica legge soltanto. Qui nulla viene rimosso e una pulizia passa comunque dalla conferma normale."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O diagnóstico apenas lê. Nada é removido aqui e qualquer limpeza passa pela confirmação habitual."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷只做讀取。這裡的任何內容都不會被刪除；如要清理，仍會走正常的確認流程。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanı yalnızca okur. Burada hiçbir şey kaldırılmaz ve temizlik yine normal onaydan geçer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostyka tylko odczytuje. Nic tu nie jest usuwane, a czyszczenie nadal przechodzi zwykłe potwierdzenie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostiek leest alleen. Hier wordt niets verwijderd en opschonen gaat nog steeds via de normale bevestiging."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການວິນິດໄສອ່ານຢ່າງດຽວ. ບໍ່ມີຫຍັງຖືກລຶບອອກໃນນີ້; ຖ້າລ້າງ ຍັງຜ່ານການຢືນຢັນປົກກະຕິ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشخيص يقرأ فقط. لا يُزال شيء هنا، وأي تنظيف يمر بالتأكيد المعتاد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האבחון רק קורא. כאן לא מוסר דבר, וכל ניקוי עובר את האישור הרגיל."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عیب‌یابی فقط می‌خواند. اینجا هیچ‌چیز حذف نمی‌شود و پاک‌سازی همچنان از تأیید معمول می‌گذرد."
          }
        }
      }
    },

    "purchase.licenseRequiredDetail": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning, analysis and previews stay free. Cleaning and uninstalling need the one-time purchase."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描、分析和预览始终免费。清理和卸载需要一次性购买。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔, 분석, 미리보기는 무료입니다. 정리와 제거에는 한 번 구매가 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование, анализ и предпросмотр бесплатны. Очистка и удаление требуют покупки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear, analizar y previsualizar es gratis. Limpiar y desinstalar requiere la compra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン・分析・プレビューは無料です。削除とアンインストールには買い切り購入が必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse et aperçu gratuits. Nettoyage et désinstallation nécessitent l’achat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen, Analyse und Vorschau bleiben gratis. Bereinigen und Deinstallieren kosten einmalig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansione, analisi e anteprime restano gratis. Pulizia e disinstallazione richiedono l’acquisto una tantum."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificação, análise e prévia continuam grátis. Limpar e desinstalar exigem a compra única."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描、分析和預覽始終免費。清理和解除安裝需要一次性購買。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarama, analiz ve önizleme ücretsiz kalır. Temizlik ve kaldırma tek seferlik satın alma gerektirir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanowanie, analiza i podglądy pozostają bezpłatne. Czyszczenie i odinstalowanie wymagają jednorazowego zakupu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen, analyseren en bekijken blijven gratis. Opschonen en verwijderen vergen eenmalige aankoop."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການສະແກນ, ການວິເຄາະ ແລະ ການເບິ່ງຕົວຢ່າງ ຟຣີສະເໝີ. ການລ້າງ ແລະ ຖອນການຕິດຕັ້ງ ຕ້ອງຊື້ຄັ້ງດຽວ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفحص والتحليل والمعاينة مجانية دائمًا. التنظيف والإزالة يتطلبان شراءً لمرة واحدة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סריקה, ניתוח ותצוגה מקדימה נשארים חינם. ניקוי והסרה דורשים רכישה חד-פעמית."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکن، تحلیل و پیش‌نمایش همیشه رایگان‌اند. پاک‌سازی و حذف به خرید یک‌باره نیاز دارند."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирането, анализът и прегледите остават безплатни. Почистването и деинсталирането изискват еднократна покупка."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenování, analýza a náhledy zůstávají zdarma. Čištění a odinstalace vyžadují jednorázový nákup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning, analyse og forhåndsvisning er gratis. Oprydning og afinstallation kræver engangskøbet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σάρωση, η ανάλυση και οι προεπισκοπήσεις παραμένουν δωρεάν. Ο καθαρισμός και η απεγκατάσταση απαιτούν την αγορά μία φορά."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizar, medir y previsualizar sigue siendo gratis. Limpiar y desinstalar requiere la compra única."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaus, analyysi ja esikatselut ovat ilmaisia. Siivous ja asennuksen poisto vaativat kertaoston."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vizsgálat, az elemzés és az előnézetek ingyenesek maradnak. A tisztításhoz és az eltávolításhoz egyszeri vásárlás kell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemindaian, analisis, dan pratinjau tetap gratis. Pembersihan dan penghapusan memerlukan pembelian sekali bayar."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengimbasan, analisis dan pratonton kekal percuma. Pembersihan dan penyahpasangan memerlukan pembelian sekali bayar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanning, analyse og forhåndsvisning forblir gratis. Opprydding og avinstallering krever engangskjøpet."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação, a análise e as pré-visualizações continuam gratuitas. Limpar e desinstalar requerem a compra única."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanarea, analiza și previzualizările rămân gratuite. Curățarea și dezinstalarea necesită achiziția unică."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanning, analys och förhandsvisning är gratis. Rensning och avinstallation kräver engångsköpet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสแกน การวิเคราะห์ และการแสดงตัวอย่างยังฟรี การทำความสะอาดและการถอนการติดตั้งต้องซื้อครั้งเดียว"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканування, аналіз і перегляд залишаються безкоштовними. Очищення й видалення потребують одноразової покупки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét, phân tích và xem trước vẫn miễn phí. Dọn dẹp và gỡ cài đặt cần mua một lần."
          }
        }
      }
    },
    "purchase.networkUnavailable": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase service could not be reached. Your license stays usable offline for now."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接购买服务。你的授权目前仍可离线使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 서비스에 연결할 수 없습니다. 라이선스는 당분간 오프라인에서 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис покупки недоступен. Лицензия пока работает офлайн."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con el servicio. Tu licencia sigue funcionando sin conexión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入サービスに接続できません。ライセンスはしばらくオフラインで利用できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Service d’achat injoignable. Votre licence reste utilisable hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufdienst nicht erreichbar. Ihre Lizenz bleibt vorerst offline nutzbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio di acquisto non è raggiungibile. La tua licenza resta per ora utilizzabile offline."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível contatar o serviço de compra. Sua licença continua funcionando offline por enquanto."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連接購買服務。你的授權目前仍可離線使用。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma hizmetine ulaşılamadı. Lisansınız şimdilik çevrimdışı kullanılabilir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa zakupów jest nieosiągalna. Twoja licencja na razie działa offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aankoopdienst is niet bereikbaar. Je licentie blijft voorlopig offline bruikbaar."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຊື່ອມຕໍ່ບໍລິການຊື້ບໍ່ໄດ້. ໃບອະນຸຍາດຂອງທ່ານຍັງໃຊ້ແບບອອຟໄລນ໌ໄດ້ໃນຕອນນີ້."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خدمة الشراء. تظل ترخيصك صالحًا دون اتصال في الوقت الحالي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להתחבר לשירות הרכישות. הרישיון שלכם עדיין עובד ללא חיבור בינתיים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به سرویس خرید دسترسی ممکن نشد. مجوز شما فعلاً همچنان آفلاین کار می‌کند."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Услугата за покупки не можа да бъде достигната. Лицензът ви остава използваем офлайн засега."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Službu nákupu nešlo kontaktovat. Vaše licence zatím zůstává použitelná offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købstjenesten kunne ikke nås. Din licens kan bruges offline indtil videre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η πρόσβαση στην υπηρεσία αγοράς. Η άδειά σας παραμένει προς το παρόν σε χρήση εκτός σύνδεσης."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con el servicio de compra. Tu licencia sigue funcionando sin conexión por ahora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostopalveluun ei saatu yhteyttä. Lisenssisi toimii offline-tilassa toistaiseksi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlási szolgáltatás nem érhető el. A licence egyelőre offline is használható marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan pembelian tidak dapat dihubungi. Lisensi Anda tetap dapat digunakan secara offline untuk sementara."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan pembelian tidak dapat dihubungi. Lesen anda kekal boleh digunakan secara luar talian buat masa ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpstjenesten kunne ikke nås. Lisensen din kan brukes offline foreløpig."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível contactar o serviço de compra. A sua licença continua a funcionar sem ligação por agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciul de achiziții nu a putut fi contactat. Licența rămâne utilizabilă offline deocamdată."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köptjänsten kunde inte nås. Din licens fungerar offline tills vidare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเชื่อมต่อบริการซื้อได้ ลิขสิทธิ์ของคุณยังใช้งานแบบออฟไลน์ได้ในตอนนี้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба покупок недоступна. Ваша ліцензія поки працює офлайн."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối dịch vụ mua hàng. Giấy phép của bạn vẫn dùng được ngoại tuyến trong lúc này."
          }
        }
      }

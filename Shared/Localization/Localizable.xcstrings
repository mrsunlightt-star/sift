    "diagnostics.coverage.complete": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This result covers everything that was asked for."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次结果覆盖了全部请求的范围。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 범위를 모두 확인했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат охватывает всю запрошенную область."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este resultado cubre todo lo solicitado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要求した範囲をすべて確認しました。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce résultat couvre toute la portée demandée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ergebnis deckt den gesamten angeforderten Bereich ab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo risultato copre tutto l’ambito richiesto."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Este resultado cobre tudo o que foi pedido."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次結果涵蓋了全部請求的範圍。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sonuç istenen her şeyi kapsıyor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wynik obejmuje cały żądany zakres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit resultaat dekt alles wat gevraagd is."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຜົນການນີ້ຄຸມຄົບຊ່ອງທີ່ສະເໝີມາ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النتيجة تغطي كل النطاق المطلوب."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוצאה הזו מכסה את כל ההיקף המבוקש."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نتیجه کل محدودهٔ خواسته‌شده را پوشش می‌دهد."
          }
        }
      }
    },
    "diagnostics.coverage.note": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings to grant Full Disk Access, then run the analysis again."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中授予完全磁盘访问权限，然后重新运行诊断。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 전체 디스크 접근 권한을 허용한 뒤 다시 진단하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдайте полный доступ к диску в Системных настройках и запустите анализ снова."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede acceso total al disco en Ajustes del Sistema y vuelve a analizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でフルディスクアクセスを許可し、もう一度診断してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l’accès complet au disque dans les Réglages Système, puis relancez l’analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilen Sie in den Systemeinstellungen Vollzugriff auf die Festplatte und starten Sie die Analyse erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni di Sistema, concedi l’Accesso completo al disco e ripeti l’analisi."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda o Acesso Total ao Disco nos Ajustes do Sistema e execute a análise novamente."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定中授予完全磁碟存取權限，然後重新執行診斷。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları’nda Tam Disk Erişimi verin ve tanıyı yeniden çalıştırın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj pełny dostęp do dysku w Ustawieniach systemowych i uruchom analizę ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef Volledige Schijftoegang in Systeeminstellingen en voer de analyse opnieuw uit."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປີດການຕັ້ງຄ່າລະບົບ ອະນຸຍາດສິດເຂົ້າເຖິງດິສກ໌ຢ່າງເຕັມສ່ວນ ແລ້ວວິນິດໄສຄືນໃໝ່."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح إعدادات النظام، امنح الوصول الكامل إلى القرص، ثم أعد التحليل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את הגדרות המערכת, העניקו גישה מלאה לכונן והריצו את הניתוח שוב."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات سیستم را باز کنید، دسترسی کامل به دیسک بدهید و سپس تحلیل را دوباره اجرا کنید."
          }
        }
      }
    },
    "diagnostics.coverage.partial": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the scope could not be measured, so the totals are a lower bound."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分范围无法统计，因此合计只是下限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 범위를 측정할 수 없어 합계는 최소값입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть области измерить не удалось, поэтому итоги — нижняя граница."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte del alcance no se pudo medir, así que los totales son un mínimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部を測定できなかったため、合計は下限値です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de la portée n’a pas pu être mesurée : les totaux sont un minimum."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil des Bereichs war nicht messbar, die Summen sind also Untergrenzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte dell’ambito non si è lasciata misurare: i totali sono un limite inferiore."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do escopo não pôde ser medida, então os totais são um limite inferior."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分範圍無法統計，因此合計只是下限。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapsamın bir kısmı ölçülemediği için toplamlar alt sınırdır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Części zakresu nie udało się zmierzyć, więc sumy są dolnym ograniczeniem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deel van het bereik kon niet worden gemeten, de totalen zijn dus een ondergrens."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບາງສ່ວນວັດແທກບໍ່ໄດ້ ຈຶ່ງຕົວເລກລວມເປັນພຽງຂອບລຸ່ມ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر قياس جزء من النطاق، لذا فإن الإجماليات حد أدنى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מההיקף לא נמדד, ולכן הסכומים הם גבול תחתון."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بخشی از محدوده اندازه‌گیری نشد، پس جمع‌ها حد پایین‌اند."
          }
        }
      }
    },
    "diagnostics.coverage.permissionDenied": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some locations need Full Disk Access before they can be measured."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",

    "cleanup.explanation.logs": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log files older than %d days. They do not affect how apps run."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 天前的日志文件。不影响应用正常运行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d일이 지난 로그 파일입니다. 앱 실행에 영향을 주지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы журналов старше %d дней. Они не влияют на работу приложений."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de registro de más de %d días. No afectan al funcionamiento de las apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 日より前のログファイルです。アプリの動作には影響しません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux de plus de %d jours. Sans effet sur le fonctionnement des apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolldateien älter als %d Tage. Sie beeinflussen Apps nicht."
          }
        }
      }
    },
    "cleanup.explanation.logsItem": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stale log files. Removing them does not change how apps run."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过期日志文件。删除它们不会影响应用运行。"

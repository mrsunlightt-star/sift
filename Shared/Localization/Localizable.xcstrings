        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto. Riprova."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado. Tente novamente."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發生錯誤，請重試。"
          }

    "risk.review.detail": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually safe to remove, but you should confirm."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常可以删除，但建议你确认。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통 삭제해도 안전하지만 확인이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно можно удалить, но лучше подтвердить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente se puede eliminar, pero conviene confirmar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常は削除できますが、確認をおすすめします。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Généralement supprimable, mais à confirmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist unbedenklich, aber bitte bestätigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito si può rimuovere, ma è meglio confermare."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente pode ser removido, mas é melhor confirmar."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通常可以刪除，但建議你確認。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genellikle kaldırılabilir, ancak onaylamanız iyi olur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykle można usunąć, ale lepiej potwierdzić."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meestal veilig te verwijderen, maar bevestig het beter."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂດຍທົ່ວໄປລຶບໄດ້ ແຕ່ຄວນຢືນຢັນກ່ອນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إزالته عادةً، لكن من الأفضل التأكيد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדרך כלל אפשר להסיר, אבל עדיף לאשר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معمولاً قابل حذف است، اما بهتر است تأیید کنید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обикновено е безопасно за премахване, но е добре да потвърдите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvykle je bezpečné odstranit, ale měli byste to potvrdit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalt sikkert at fjerne, men bekræft det."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνήθως είναι ασφαλές για αφαίρεση, αλλά καλό είναι να το επιβεβαιώσετε."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente se puede eliminar, pero conviene confirmar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yleensä turvallista poistaa, mutta vahvista."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Általában biztonságosan eltávolítható, de erősítse meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biasanya aman dihapus, tetapi sebaiknya Anda konfirmasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biasanya selamat untuk dibuang, tetapi anda harus mengesahkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanligvis trygt å fjerne, men du bør bekrefte."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente pode ser eliminado, mas deve confirmar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De obicei poate fi eliminat în siguranță, dar ar trebui să confirmi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oftast säkert att ta bort, men du bör bekräfta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดยปกติลบได้อย่างปลอดภัย แต่คุณควรยืนยัน"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвичай безпечно видаляти, але варто підтвердити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thường an toàn để xóa nhưng bạn nên xác nhận."
          }
        }
      }
    },

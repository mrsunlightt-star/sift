      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with app caches and old installers: about %@ can be released."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先处理应用缓存和旧安装包，预计可以释放 %@。"

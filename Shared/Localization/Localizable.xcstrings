    "cleanup.confirm.undoNotice": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything goes to the Trash, so you can put it back until you empty it."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都会进入废纸篓，在清空前都可以恢复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 항목은 휴지통으로 이동하며, 비우기 전까지 되돌릴 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё перемещается в Корзину, поэтому можно вернуть до её очистки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo va a la papelera, así que puedes recuperarlo hasta que la vacíes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてゴミ箱に入るため、空にするまで元に戻せます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout va à la corbeille : vous pouvez restaurer jusqu’à ce que vous la vidiez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles landet im Papierkorb und kann bis zum Leeren zurückgeholt werden."
          }
        }
      }
    },
    "cleanup.explanation.cache": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps rebuild these files the next time they run."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用下次运行时会重新生成这些文件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 다음 실행 시 이 파일들을 다시 만듭니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения создадут эти файлы заново при следующем запуске."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps regeneran estos archivos la próxima vez que se ejecutan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは次回起動時にこれらのファイルを再作成します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps recréent ces fichiers à leur prochaine ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps erzeugen diese Dateien beim nächsten Start neu."
          }
        }
      }
    },
    "cleanup.explanation.duplicates": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identical content. Keep one copy and remove the rest."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容完全相同。保留一份，删除其余。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 완전히 동일합니다. 하나만 남기고 나머지를 삭제하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентичное содержимое. Оставьте одну копию и удалите остальные."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido idéntico. Conserva una copia y elimina el resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が完全に同じです。1 つを残して他を削除します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

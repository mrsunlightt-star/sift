    "storage.scopeNote": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File categories cover your home folder and authorised folders on this disk. The toggle adds whole-volume system diagnostics."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件分类统计个人文件夹和此磁盘上已授权的文件夹；开关会为系统诊断加入整卷范围。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 분류는 홈과 이 디스크에서 승인한 폴더를 포함합니다. 스위치는 시스템 진단에 볼륨 전체를 포함합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории файлов охватывают домашнюю папку и разрешённые папки на этом диске. Переключатель добавляет диагностику всего тома."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías cubren tu carpeta personal y las carpetas autorizadas en este disco. La opción añade el diagnóstico de todo el volumen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル分類はホームとこのディスク上で許可したフォルダを対象にします。スイッチはシステム診断にボリューム全体を加えます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories couvrent votre dossier personnel et les dossiers autorisés sur ce disque. L’option ajoute le diagnostic du volume entier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateikategorien umfassen Ihren Benutzerordner und autorisierte Ordner auf diesem Volume. Die Option ergänzt die Systemdiagnose für das gesamte Volume."
          }
        }
      }
    },

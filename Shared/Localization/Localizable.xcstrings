          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak. Spróbuj ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis. Probeer het opnieuw."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ມີບາງຢ່າງຜິດພາດ. ລອງໃໝ່ອີກຄັ້ງ."
          }
        },

            "state": "translated",
            "value": "Reconstruire depuis l’outil concerné"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im erzeugenden Werkzeug neu aufbauen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricrea dallo strumento che l’ha creato"
          }
        },
        "pt-br": {

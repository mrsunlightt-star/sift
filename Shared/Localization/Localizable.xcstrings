    "settings.authorized.empty": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been authorised yet. Folders you add here are scanned, and used to find duplicates."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授权任何位置。在此添加的文件夹会被扫描，并用于查找重复文件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 승인된 위치가 없습니다. 여기에서 추가한 폴더는 검사되며 중복 파일 찾기에 사용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего не разрешено. Добавленные здесь папки сканируются и используются для поиска дубликатов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has autorizado nada. Las carpetas que añadas aquí se analizan y se usan para buscar duplicados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も許可されていません。ここで追加したフォルダはスキャンされ、重複ファイルの検索に使われます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est encore autorisé. Les dossiers ajoutés ici sont analysés et servent à trouver les doublons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts autorisiert. Hier hinzugefügte Ordner werden gescannt und für die Duplikatsuche verwendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora autorizzato nulla. Le cartelle aggiunte qui vengono scansionate e usate per trovare i duplicati."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi autorizado ainda. As pastas adicionadas aqui são verificadas e usadas para encontrar duplicados."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授權任何位置。在此加入的資料夾會被掃描，並用於尋找重複檔案。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir şey yetkilendirilmedi. Buraya eklenen klasörler taranır ve kopya aramada kullanılır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic nie zostało autoryzowane. Dodane tu foldery są skanowane i używane do wyszukiwania duplikatów."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog niets geautoriseerd. Mappen die je hier toevoegt worden gescand en gebruikt om duplicaten te vinden."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍັງບໍ່ໄດ້ອະນຸຍາດຫຍັງເລີຍ. ໂຟນເດີທີ່ເພີ່ມທີ່ນີ້ຈະຖືກສະແກນ ແລະ ໃຊ້ຊອກຫາໄຟລ໌ຊ້ຳ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُصرّح بأي شيء بعد. المجلدات التي تضيفها هنا تُفحص وتُستخدم للعثور على المكررات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא אושר דבר. תיקיות שתוסיפו כאן ייסרקו וישמשו למציאת כפילויות."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز هیچ‌چیز مجاز نشده است. پوشه‌هایی که اینجا می‌افزایید اسکن می‌شوند و برای یافتن تکراری‌ها به کار می‌روند."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още нищо не е разрешено. Папките, добавени тук, се сканират и се използват за търсене на дубликати."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nebylo nic autorizováno. Složky, které zde přidáte, se skenují a používají k hledání duplikátů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet er autoriseret endnu. Mapper, du tilføjer her, scannes og bruges til at finde dubletter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει εξουσιοδοτηθεί τίποτα ακόμη. Οι φάκελοι που προσθέτετε εδώ σαρώνονται και χρησιμοποιούνται για την εύρεση διπλοτύπων."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se autorizó nada. Las carpetas que agregues aquí se analizan y se usan para buscar duplicados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei ole vielä valtuutettu. Tänne lisätyt kansiot skannataan ja niitä käytetään kaksoiskappaleiden etsimiseen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még semmi nincs engedélyezve. Az itt hozzáadott mappákat vizsgálja, és a duplikátumok kereséséhez használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang diizinkan. Folder yang Anda tambahkan di sini akan dipindai dan digunakan untuk menemukan duplikat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada apa-apa yang dibenarkan lagi. Folder yang anda tambah di sini akan diimbas dan digunakan untuk mencari pendua."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er autorisert ennå. Mapper du legger til her, skannes og brukes til å finne duplikater."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada foi autorizado. As pastas adicionadas aqui são verificadas e utilizadas para encontrar duplicados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost autorizat încă nimic. Folderele adăugate aici sunt scanate și folosite pentru a găsi duplicate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget har auktoriserats än. Mappar du lägger till här skannas och används för att hitta dubbletter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้อนุญาตสิ่งใด โฟลเดอร์ที่คุณเพิ่มที่นี่จะถูกสแกนและใช้ค้นหาไฟล์ซ้ำ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще нічого не дозволено. Додані тут папки скануються й використовуються для пошуку дублікатів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì được cho phép. Các thư mục bạn thêm ở đây sẽ được quét và dùng để tìm tệp trùng."
          }
        }
      }
    },

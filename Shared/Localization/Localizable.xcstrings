    "settings.privacyStatement": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift does not collect file contents, file names, full paths, browsing history, app usage or account details. Scan results stay on this Mac, and nothing is uploaded."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 不采集文件内容、文件名、完整路径、浏览历史、应用使用记录或账号信息。扫描结果只保存在本机，不会上传。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift는 파일 내용, 파일 이름, 전체 경로, 방문 기록, 앱 사용 기록 또는 계정 정보를 수집하지 않습니다. 검사 결과는 이 Mac에만 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift не собирает содержимое файлов, имена, полные пути, историю браузера, данные об использовании приложений или аккаунт. Результаты остаются на этом Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift no recopila contenidos, nombres de archivo, rutas completas, historial de navegación, uso de apps ni datos de cuenta. Los resultados se quedan en este Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift はファイル内容、ファイル名、完全なパス、閲覧履歴、アプリの使用履歴、アカウント情報を収集しません。結果はこの Mac にのみ保存されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ne collecte ni contenu, ni noms de fichiers, ni chemins complets, ni historique, ni usage des apps, ni données de compte. Les résultats restent sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift erfasst keine Dateiinhalte, Dateinamen, vollständigen Pfade, Verläufe, App-Nutzung oder Kontodaten. Ergebnisse bleiben auf diesem Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift non raccoglie contenuti dei file, nomi dei file, percorsi completi, cronologia di navigazione, uso delle app o dati dell’account. I risultati della scansione restano su questo Mac e nulla viene caricato online."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift não coleta conteúdos de arquivos, nomes, caminhos completos, histórico de navegação, uso de apps ou dados de conta. Os resultados da verificação ficam neste Mac, e nada é enviado."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 不蒐集檔案內容、檔名、完整路徑、瀏覽記錄、應用程式使用記錄或帳號資訊。掃描結果只保存在本機，不會上傳。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift; dosya içeriklerini, dosya adlarını, tam yolları, tarama geçmişini, uygulama kullanımını veya hesap bilgilerini toplamaz. Tarama sonuçları bu Mac’te kalır, hiçbir şey yüklenmez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift nie zbiera treści plików, ich nazw, pełnych ścieżek, historii przeglądania, użycia aplikacji ani danych konta. Wyniki skanowania zostają na tym Macu, nic nie jest wysyłane."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift verzamelt geen bestandsinhoud, bestandsnamen, volledige paden, browsegeschiedenis, app-gebruik of accountgegevens. Scanresultaten blijven op deze Mac, er wordt niets geüpload."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ບໍ່ເກັບເນື້ອໃນໄຟລ໌, ຊື່ໄຟລ໌, ເສັ້ນທາງເຕັມ, ປະຫວັດການທ່ອງເວັບ, ການໃຊ້ແອັບ ຫຼື ຂໍ້ມູນບັນຊີ. ຜົນການສະແກນຢູ່ໃນເຄື່ອງນີ້ເທົ່ານັ້ນ ບໍ່ມີການສົ່ງຂຶ້ນເຊີຟ໌ເວີ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجمع Sift محتويات الملفات، ولا أسماءها، ولا المسارات الكاملة، ولا سجل التصفح، ولا استخدام التطبيقات، ولا بيانات الحساب. تبقى نتائج الفحص على هذا Mac ولا يُرفع شيء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift אינו אוסף תכני קבצים, שמות קבצים, נתיבים מלאים, היסטוריית גלישה, שימוש באפליקציות או פרטי חשבון. תוצאות הסריקה נשארות ב-Mac הזה ושום דבר אינו מועלה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift محتوای فایل‌ها، نام فایل‌ها، مسیرهای کامل، سابقهٔ مرور، استفاده از برنامه‌ها یا اطلاعات حساب را جمع نمی‌کند. نتایج اسکن فقط روی همین مک می‌ماند و هیچ‌چیز بارگذاری نمی‌شود."
          }
        }
      }
    },

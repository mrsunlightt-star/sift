    "overview.noResults": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a scan to see what can be safely released."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描后，这里会显示可以安全释放的空间。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사를 실행하면 안전하게 확보할 수 있는 공간이 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите сканирование, чтобы увидеть, сколько можно безопасно освободить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un análisis para ver cuánto se puede liberar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンすると、安全に解放できる容量が表示されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez une analyse pour voir ce qui peut être libéré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie einen Scan, um zu sehen, was sicher freigegeben werden kann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui una scansione per vedere cosa puoi liberare in sicurezza."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute uma verificação para ver o que pode ser liberado com segurança."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描後，這裡會顯示可以安全釋放的空間。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenle kazanabileceklerinizi görmek için tarama yapın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom skanowanie, aby zobaczyć, co można bezpiecznie odzyskać."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een scan uit om te zien wat er veilig vrijgemaakt kan worden."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ສະແກນກ່ອນ ເພື່ອເຫັນວ່າສາມາດສ້າງພື້ນທີ່ໄດ້ປອດໄພປານໃດ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل فحصًا لترى ما يمكن تحريره بأمان."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הריצו סריקה כדי לראות מה אפשר לפנות בבטחה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکنی اجرا کنید تا ببینید چه چیزهایی می‌توانند با اطمینان آزاد شوند."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Стартирайте сканиране, за да видите какво може да се освободи безопасно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spusťte skenování a uvidíte, co lze bezpečně uvolnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kør en scanning for at se, hvad der kan frigives sikkert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτελέστε μια σάρωση για να δείτε τι μπορεί να ελευθερωθεί με ασφάλεια."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un análisis para ver qué se puede liberar de forma segura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorita skannaus, niin näet, mitä voidaan vapauttaa turvallisesti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indítson vizsgálatot, hogy lássa, mi szabadítható fel biztonságosan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",

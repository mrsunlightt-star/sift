    "files.scopeEmpty": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No folders yet. Duplicates are searched only in folders you add."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有文件夹。重复文件只在你添加的文件夹中搜索。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 폴더가 없습니다. 중복 파일은 추가한 폴더에서만 검색합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папок пока нет. Дубликаты ищутся только в добавленных папках."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay carpetas. Los duplicados se buscan solo en las carpetas que añadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだフォルダがありません。重複ファイルは追加したフォルダ内だけを検索します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier pour l’instant. Les doublons ne sont cherchés que dans les dossiers ajoutés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Ordner. Duplikate werden nur in hinzugefügten Ordnern gesucht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna cartella. I duplicati si cercano solo nelle cartelle che aggiungi."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há pastas. Duplicados são buscados apenas nas pastas que você adicionar."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有資料夾。重複檔案只在你加入的資料夾中搜尋。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz klasör yok. Kopyalar yalnızca eklediğiniz klasörlerde aranır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze folderów. Duplikaty są szukane tylko w dodanych folderach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen mappen. Duplicaten worden alleen in toegevoegde mappen gezocht."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍັງບໍ່ມີໂຟນເດີ. ໄຟລ໌ຊ້ຳຈະຖືກຄົ້ນສະເພາະໃນໂຟນເດີທີ່ທ່ານເພີ່ມ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مجلدات بعد. تُبحث المكررات فقط في المجلدات التي تضيفها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין תיקיות. כפילויות נחפשות רק בתיקיות שתוסיפו."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز پوشه‌ای نیست. تکراری‌ها فقط در پوشه‌هایی که می‌افزایید جست‌وجو می‌شوند."
          }
        }
      }
    },

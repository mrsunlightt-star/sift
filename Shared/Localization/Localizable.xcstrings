    "cleanup.confirm.undoNotice": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything goes to the Trash, so you can put it back until you empty it."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都会进入废纸篓，在清空前都可以恢复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 항목은 휴지통으로 이동하며, 비우기 전까지 되돌릴 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё перемещается в Корзину, поэтому можно вернуть до её очистки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo va a la papelera, así que puedes recuperarlo hasta que la vacíes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてゴミ箱に入るため、空にするまで元に戻せます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout va à la corbeille : vous pouvez restaurer jusqu’à ce que vous la vidiez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles landet im Papierkorb und kann bis zum Leeren zurückgeholt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto finisce nel Cestino: puoi ripristinarlo finché non lo svuoti."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo vai para a Lixeira, então você pode recuperar até esvaziá-la."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有內容都會進入垃圾桶，在清空前都可以還原。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey Çöp Sepeti’ne gider; boşaltana kadar geri alabilirsiniz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko trafia do Kosza, więc możesz przywrócić do jego opróżnienia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gaat naar de Prullenbak, dus je kunt het terugzetten totdat je die leegt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທຸກຢ່າງຈະເຂົ້າຖັງຂີ້ເຫຍື້ອ ຈຶ່ງກູ້ຄືນໄດ້ຈົນກວ່າຈະລ້າງຖັງ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يذهب إلى المهملات، لذا يمكنك استعادته حتى تفرغها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול יועבר אל פח האשפה, כך שאפשר לשחזר עד שתרוקנו אותו."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه چیز به سطل بازیافت می‌رود؛ تا زمان خالی کردنش می‌توانید بازگردانید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко отива в Кошчето, така че можете да го върнете, докато не го изпразните."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše jde do Koše, takže můžete vše vrátit, dokud jej nevysypete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt ryger i Papirkurven, så du kan lægge det tilbage, indtil du tømmer den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα πηγαίνουν στον Κάδο, ώστε να μπορείτε να τα επαναφέρετε μέχρι να τον αδειάσετε."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo va a la Papelera, así que puedes recuperarlo hasta que la vacíes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki siirtyy Roskakoriin, joten voit palauttaa ne, kunnes tyhjennät sen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden a Kukába kerül, így visszateheti, amíg ki nem üríti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua dipindahkan ke Tempat Sampah, jadi Anda dapat mengembalikannya sampai Anda mengosongkannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya masuk ke Tong Sampah, jadi anda boleh mengembalikannya sehingga anda mengosongkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt går til Papirkurven, så du kan legge det tilbake til du tømmer den."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo vai para o Lixo, pelo que pode recuperar os itens até o esvaziar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul ajunge în Coș, așa că poți pune la loc până îl golești."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt hamnar i Papperskorgen, så du kan lägga tillbaka det tills du tömmer den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างจะถูกย้ายไปที่ถังขยะ คุณจึงกู้คืนได้จนกว่าจะล้างถังขยะ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе переміщується в Кошик, тож ви можете повернути це, доки не спорожните його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ đều được chuyển vào Thùng rác, bạn có thể khôi phục cho đến khi làm trống Thùng rác."
          }
        }
      }
    },
    "cleanup.explanation.cache": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {

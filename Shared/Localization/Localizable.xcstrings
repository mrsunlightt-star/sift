    "diagnostics.coverage.note": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings to grant Full Disk Access, then run the analysis again."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中授予完全磁盘访问权限，然后重新运行诊断。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 전체 디스크 접근 권한을 허용한 뒤 다시 진단하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выдайте полный доступ к диску в Системных настройках и запустите анализ снова."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede acceso total al disco en Ajustes del Sistema y vuelve a analizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でフルディスクアクセスを許可し、もう一度診断してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l’accès complet au disque dans les Réglages Système, puis relancez l’analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erteilen Sie in den Systemeinstellungen Vollzugriff auf die Festplatte und starten Sie die Analyse erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni di Sistema, concedi l’Accesso completo al disco e ripeti l’analisi."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda o Acesso Total ao Disco nos Ajustes do Sistema e execute a análise novamente."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定中授予完全磁碟存取權限，然後重新執行診斷。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları’nda Tam Disk Erişimi verin ve tanıyı yeniden çalıştırın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj pełny dostęp do dysku w Ustawieniach systemowych i uruchom analizę ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef Volledige Schijftoegang in Systeeminstellingen en voer de analyse opnieuw uit."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປີດການຕັ້ງຄ່າລະບົບ ອະນຸຍາດສິດເຂົ້າເຖິງດິສກ໌ຢ່າງເຕັມສ່ວນ ແລ້ວວິນິດໄສຄືນໃໝ່."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح إعدادات النظام، امنح الوصول الكامل إلى القرص، ثم أعد التحليل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו את הגדרות המערכת, העניקו גישה מלאה לכונן והריצו את הניתוח שוב."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات سیستم را باز کنید، دسترسی کامل به دیسک بدهید و سپس تحلیل را دوباره اجرا کنید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете Системни настройки, за да дадете Пълен достъп до диска, и стартирайте анализа отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Nastavení systému, udělte Úplný přístup k disku a analýzu spusťte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Systemindstillinger for at give fuld diskadgang, og kør analysen igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε τις Ρυθμίσεις συστήματος για να παραχωρήσετε Πλήρη πρόσβαση στον δίσκο και εκτελέστε ξανά την ανάλυση."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede Acceso total al disco en Ajustes del Sistema y vuelve a ejecutar el análisis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Järjestelmäasetukset, myönnä täysi levynkäyttöoikeus ja suorita analyysi uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg a Rendszerbeállításokat a Teljes lemezhozzáférés megadásához, majd futtassa újra az elemzést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pengaturan Sistem untuk memberikan Akses Disk Penuh, lalu jalankan analisis lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Tetapan Sistem untuk memberikan Akses Cakera Penuh, kemudian jalankan analisis semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Systeminnstillinger for å gi full disktilgang, og kjør analysen igjen."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda Acesso Total ao Disco nas Definições do Sistema e execute novamente a análise."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Configurările sistemului pentru a acorda Acces complet la disc, apoi rulează din nou analiza."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Systeminställningar för att ge fullskivåtkomst och kör analysen igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการตั้งค่าระบบเพื่ออนุญาตการเข้าถึงดิสก์ทั้งหมด แล้วรันการวิเคราะห์อีกครั้ง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Системні налаштування, щоб надати Повний доступ до диска, і запустіть аналіз знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt Hệ thống để cấp Quyền truy cập Toàn bộ Đĩa, rồi chạy lại phân tích."
          }
        }
      }
    },
    "diagnostics.coverage.partial": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the scope could not be measured, so the totals are a lower bound."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分范围无法统计，因此合计只是下限。"
          }

    "files.requiresAuthorization": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scans Downloads, Desktop and folders you choose. Add a folder to include it."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 只扫描下载、桌面和你选择的文件夹。添加文件夹以纳入扫描。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift는 다운로드, 데스크톱 및 선택한 폴더만 검사합니다. 폴더를 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift сканирует «Загрузки», «Рабочий стол» и выбранные папки. Добавьте папку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift analiza Descargas, Escritorio y las carpetas que elijas. Añade una carpeta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift はダウンロード、デスクトップ、選択したフォルダを対象にします。フォルダを追加してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift analyse Téléchargements, le Bureau et les dossiers choisis. Ajoutez un dossier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift prüft Downloads, Schreibtisch und von Ihnen gewählte Ordner. Ordner hinzufügen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scansiona Download, Scrivania e le cartelle che scegli. Aggiungi una cartella per includerla."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift verifica Downloads, Área de Trabalho e as pastas que você escolher. Adicione uma pasta para incluí-la."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 只掃描「下載」、「桌面」和你選擇的資料夾。加入資料夾以納入掃描。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift, İndirilenler, Masaüstü ve seçtiğiniz klasörleri tarar. Dahil etmek için klasör ekleyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift skanuje Pobrane, Biurko i wybrane foldery. Dodaj folder, aby go uwzględnić."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scant Downloads, Bureaublad en de mappen die je kiest. Voeg een map toe om die op te nemen."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ສະແກນດາວໂຫລດ, ໜ້າຈໍຫຼັກ ແລະ ໂຟນເດີທີ່ທ່ານເລືອກ. ເພີ່ມໂຟນເດີເພື່ອໃສ່ໃນການສະແກນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص Sift التنزيلات وسطح المكتب والمجلدات التي تختارها. أضف مجلدًا لإدراجه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift סורק הורדות, שולחן עבודה ותיקיות שתבחרו. הוסיפו תיקייה כדי לכלול אותה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift دانلودها، میزکار و پوشه‌هایی که انتخاب می‌کنید را اسکن می‌کند. برای گنجاندن، پوشه‌ای بیفزایید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift сканира „Изтегляния“, „Работен плот“ и папките, които изберете. Добавете папка, за да я включите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift skenuje Stažené soubory, Plochu a složky, které vyberete. Přidáním složky ji zahrnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scanner Downloads, Skrivebord og de mapper, du vælger. Tilføj en mappe for at medtage den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sift σαρώνει τους φακέλους Λήψεις, Επιφάνεια εργασίας και φακέλους που επιλέγετε. Προσθέστε έναν φάκελο για να τον συμπεριλάβετε."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift analiza Descargas, Escritorio y las carpetas que elijas. Agrega una carpeta para incluirla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift skannaa Lataukset-, Työpöytä- ja valitsemasi kansiot. Lisää kansio, niin se otetaan mukaan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sift a Letöltéseket, az Asztalt és az Ön által választott mappákat vizsgálja. Adjon hozzá egy mappát a felvételéhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift memindai Downloads, Desktop, dan folder yang Anda pilih. Tambahkan folder untuk menyertakannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift mengimbas Downloads, Desktop dan folder yang anda pilih. Tambah folder untuk menyertakannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift skanner Nedlastinger, Skrivebord og mapper du velger. Legg til en mappe for å ta den med."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift verifica as pastas Downloads e Secretária, bem como as pastas que escolher. Adicione uma pasta para a incluir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift scanează Descărcări, Desktop și folderele pe care le alegi. Adaugă un folder pentru a-l include."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift skannar Hämtade filer, Skrivbord och mappar du väljer. Lägg till en mapp för att inkludera den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift สแกนโฟลเดอร์ Downloads, Desktop และโฟลเดอร์ที่คุณเลือก เพิ่มโฟลเดอร์เพื่อรวมไว้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift сканує «Завантаження», «Робочий стіл» і вибрані вами папки. Додайте папку, щоб включити її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift quét Downloads, Desktop và các thư mục bạn chọn. Hãy thêm thư mục để đưa vào phạm vi."
          }
        }
      }
    },

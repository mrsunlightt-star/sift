        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift no pudo pedir a %@ que se cerrara. Ciérrala manualmente e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift は %@ に終了を要求できませんでした。手動で終了してから再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift n’a pas pu demander à %@ de quitter. Quittez-le manuellement et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift konnte %@ nicht zum Beenden auffordern. Beenden Sie es manuell und versuchen Sie es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift non è riuscito a chiedere a %@ di chiudersi. Chiudila manualmente e riprova."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift não conseguiu pedir para %@ encerrar. Feche manualmente e tente de novo."

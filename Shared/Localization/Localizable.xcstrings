    "uninstall.appRunning": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is running. Quit it before removing, or Sift will skip the files it holds open."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行。请先退出，否则 Sift 会跳过被占用的文件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 실행 중입니다. 먼저 종료하지 않으면 사용 중인 파일은 건너뜁니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запущено. Закройте его, иначе Sift пропустит занятые файлы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se está ejecutando. Ciérrala antes, o Sift omitirá los archivos en uso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が実行中です。先に終了しないと、使用中のファイルはスキップされます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en cours d’exécution. Quittez-le, sinon Sift ignorera les fichiers ouverts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft. Beenden Sie es, sonst überspringt Sift die geöffneten Dateien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è in esecuzione. Chiudila prima di rimuoverla, altrimenti Sift salterà i file che tiene aperti."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está em execução. Encerre-o antes de remover, ou o Sift ignorará os arquivos em uso."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在執行。請先結束，否則 Sift 會略過被佔用的檔案。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ çalışıyor. Kaldırmadan önce kapatın, yoksa Sift kullanımdaki dosyaları atlar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest uruchomiona. Zamknij ją przed usunięciem, w przeciwnym razie Sift pominie używane pliki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ draait. Sluit het eerst af, anders slaat Sift de open bestanden over."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ກຳລັງເຮັດວຽກ. ອອກຈາກແອັບກ່ອນ ຖ້າບໍ່ດັ່ງນັ້ນ Sift ຈະຂ້າມໄຟລ໌ທີ່ຖືກເປີດຢູ່."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ قيد التشغيل. أغلقه قبل الإزالة، وإلا سيتخطى Sift الملفات المفتوحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ פועל כעת. סגרו אותו לפני ההסרה, אחרת Sift ידלג על הקבצים הפתוחים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ در حال اجراست. پیش از حذف آن را ببندید، در غیر این صورت Sift فایل‌های در حال استفاده را نادیده می‌گیرد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ работи. Затворете го преди премахване, иначе Sift ще пропусне файловете, които държи отворени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je spuštěna. Před odstraněním ji ukončete, jinak Sift vynechá soubory, které drží otevřené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kører. Afslut det, før du fjerner det; ellers springer Sift de filer over, det holder åbne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή %@ εκτελείται. Κλείστε την πριν από την αφαίρεση, αλλιώς το Sift θα παραλείψει τα αρχεία που κρατά ανοιχτά."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está en ejecución. Ciérrala antes de eliminar, o Sift omitirá los archivos que mantiene abiertos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on käynnissä. Lopeta se ennen poistamista, muuten Sift ohittaa tiedostot, jotka se pitää avoinna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fut. Az eltávolítás előtt lépjen ki belőle, különben a Sift kihagyja a nyitva tartott fájlokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sedang berjalan. Keluar darinya sebelum menghapus, atau Sift akan melewati file yang sedang dibukanya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sedang berjalan. Keluar daripadanya sebelum membuang, atau Sift akan melangkau fail yang dibukanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kjører. Avslutt det før du fjerner, ellers hopper Sift over filene det holder åpne."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está em execução. Encerre-a antes de eliminar, ou o Sift irá ignorar os ficheiros que mantém abertos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rulează. Închide-o înainte de eliminare, altfel Sift va sări peste fișierele pe care le ține deschise."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ körs. Avsluta det innan du tar bort det, annars hoppar Sift över filerna det håller öppna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ กำลังทำงาน โปรดปิดก่อนลบ ไม่เช่นนั้น Sift จะข้ามไฟล์ที่แอปเปิดอยู่"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ працює. Закрийте його перед видаленням, інакше Sift пропустить файли, які воно тримає відкритими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đang chạy. Hãy thoát ứng dụng trước khi gỡ, nếu không Sift sẽ bỏ qua các tệp đang được mở."
          }
        }
      }
    },

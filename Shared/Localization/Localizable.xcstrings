    "overview.historyLocal": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History stays on this Mac; nothing is synced or uploaded."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录仅保存在本机，不同步、不上传。"

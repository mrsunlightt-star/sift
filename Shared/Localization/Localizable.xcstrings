    },
    "cleanup.explanation.installers": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installers you already used. You may still need them, so confirm first."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经使用过的安装包。你可能仍需要它们，请先确认。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 사용한 설치 파일입니다. 필요할 수 있으니 먼저 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установщики, которые вы уже использовали. Они могут ещё понадобиться."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores que ya usaste. Puede que aún los necesites, confirma antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用済みのインストーラです。必要になる場合があるため確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installateurs déjà utilisés. Vous pourriez en avoir besoin, vérifiez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits verwendete Installer. Sie könnten sie noch brauchen – bitte prüfen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer già utilizzati. Potresti averne ancora bisogno: conferma prima."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores que você já usou. Ainda pode precisar deles; confirme antes."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經使用過的安裝程式。你可能仍需要它們，請先確認。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten kullandığınız yükleyiciler. Hâlâ gerekebilir; önce onaylayın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalatory, które zostały już użyte. Mogą jeszcze być potrzebne — najpierw potwierdź."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installatieprogramma’s die je al hebt gebruikt. Je kunt ze nog nodig hebben — bevestig eerst."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂປຣແກຣມຕິດຕັ້ງທີ່ໃຊ້ແລ້ວ. ທ່ານອາດຍັງຕ້ອງການ, ກະລຸນາຢືນຢັນກ່ອນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برامج تثبيت استخدمتها بالفعل. قد تحتاجها بعدُ، فأكّد أولًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתקינים שכבר השתמשת בהם. ייתכן שעדיין תזדקק להם — אשר קודם."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نصب‌کننده‌هایی که پیش‌تر استفاده کرده‌اید. شاید هنوز لازمشان داشته باشید؛ ابتدا تأیید کنید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталатори, които вече сте използвали. Може да ви потрябват, затова потвърдете първо."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalátory, které jste už použili. Možná je ještě budete potřebovat, proto je nejprve potvrďte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsprogrammer, du allerede har brugt. Du har muligvis stadig brug for dem, så bekræft først."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προγράμματα εγκατάστασης που έχετε ήδη χρησιμοποιήσει. Μπορεί να τα χρειαστείτε ακόμη, οπότε επιβεβαιώστε πρώτα."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores que ya usaste. Puede que aún los necesites, así que confirma antes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asennusohjelmat, joita olet jo käyttänyt. Saatat tarvita niitä vielä, joten vahvista ensin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Már használt telepítők. Lehet, hogy még szüksége van rájuk, ezért előbb erősítse meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penginstal yang sudah Anda gunakan. Anda mungkin masih memerlukannya, jadi konfirmasi dulu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasang yang telah anda gunakan. Anda mungkin masih memerlukannya, jadi sahkan dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installasjonsprogrammer du allerede har brukt. Du kan fortsatt trenge dem, så bekreft først."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores que já utilizou. Pode ainda precisar deles, por isso confirme primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalatoare pe care le-ai folosit deja. S-ar putea să ai încă nevoie de ele, așa că verifică mai întâi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsprogram du redan har använt. Du kan fortfarande behöva dem, så bekräfta först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ติดตั้งที่คุณใช้แล้ว คุณอาจยังต้องใช้ โปรดยืนยันก่อน"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталятори, які ви вже використали. Вони можуть ще знадобитися, тож спершу підтвердьте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ cài bạn đã dùng. Bạn vẫn có thể cần chúng, hãy xác nhận trước."
          }
        }
      }
    },
    "cleanup.explanation.largeFiles": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files larger than %@. Sift never guesses: you decide which to remove."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大于 %@ 的文件。Sift 不做猜测，由你决定删除哪些。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@보다 큰 파일입니다. 어떤 파일을 지울지는 사용자가 결정합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы больше %@. Sift не угадывает: решение за вами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de más de %@. Sift no adivina: tú decides cuáles eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を超えるファイルです。削除するかどうかはご自身で決められます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers de plus de %@. Sift ne devine pas : c’est vous qui décidez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien größer als %@. Sift rät nicht – Sie entscheiden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File più grandi di %@. Sift non indovina: sei tu a decidere cosa rimuovere."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos maiores que %@. O Sift não adivinha: você decide o que remover."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大於 %@ 的檔案。Sift 不做猜測，由你決定刪除哪些。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzeri dosyalar. Sift tahmin yapmaz: neyin kaldırılacağına siz karar verirsiniz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki większe niż %@. Sift nie zgaduje: to Ty decydujesz, co usunąć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden groter dan %@. Sift gokt niet: jij bepaalt wat er verwijderd wordt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ທີ່ໃຫຍ່ກວ່າ %@. Sift ບໍ່ເດາະເດາະ: ທ່ານເປັນຜູ້ຕັດສິນວ່າຈະລຶບອັນໃດ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات أكبر من %@. لا يخمّن Sift: أنت من يقرر ماذا يُزال."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים גדולים מ-%@. Sift לא מנחש: אתם מחליטים מה להסיר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل‌های بزرگ‌تر از %@. Sift حدس نمی‌زند: تصمیم حذف با شماست."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлове, по-големи от %@. Sift никога не гадае: вие решавате кои да премахнете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubory větší než %@. Sift nic neodhaduje: rozhodujete vy, co odstranit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer større end %@. Sift gætter aldrig: du beslutter, hvad der skal fjernes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αρχεία μεγαλύτερα από %@. Το Sift δεν μαντεύει: εσείς αποφασίζετε ποια θα αφαιρεθούν."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de más de %@. Sift no adivina: tú decides cuáles eliminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostot, jotka ovat suurempia kuin %@. Sift ei koskaan arvaa: sinä päätät, mitkä poistetaan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-nál nagyobb fájlok. A Sift soha nem találgat: Ön dönti el, mi kerüljön eltávolításra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File yang lebih besar dari %@. Sift tidak pernah menebak: Anda yang memutuskan mana yang dihapus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail yang lebih besar daripada %@. Sift tidak pernah meneka: anda yang menentukan yang mana untuk dibuang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer større enn %@. Sift gjetter aldri: du bestemmer hva som fjernes."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiros com mais de %@. O Sift não adivinha: a decisão é sua."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișiere mai mari de %@. Sift nu ghicește niciodată: tu decizi ce se elimină."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer större än %@. Sift gissar aldrig: du bestämmer vad som ska tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่ใหญ่กว่า %@ Sift ไม่เดา คุณเป็นผู้ตัดสินว่าจะลบไฟล์ใด"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли, більші за %@. Sift ніколи не вгадує: ви вирішуєте, які видалити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp lớn hơn %@. Sift không đoán: bạn quyết định xóa tệp nào."
          }
        }
      }
    },

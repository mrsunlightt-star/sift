    "settings.skipConfirmationWarning": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift will start cleaning as soon as you click. Items still go to the Trash, but you will not see the list first."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击后 Sift 会立即开始清理。内容仍会进入废纸篓，但不会先显示列表。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 바로 정리를 시작합니다. 항목은 휴지통으로 이동하지만 목록을 먼저 볼 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift начнёт очистку сразу после нажатия. Файлы попадут в Корзину, но список вы не увидите."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift empezará a limpiar al hacer clic. Todo irá a la papelera, pero no verás la lista antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックするとすぐに削除が始まります。ゴミ箱には入りますが、一覧は表示されません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift nettoiera dès le clic. Les éléments iront à la corbeille, mais sans liste préalable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift beginnt sofort nach dem Klick. Alles landet im Papierkorb, aber ohne vorherige Liste."
          }
        }
      }
    },

    "dashboard.cleanupSuggestion": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with app caches and old installers: about %@ can be released."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先处理应用缓存和旧安装包，预计可以释放 %@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 캐시와 오래된 설치 파일부터 처리하면 약 %@을 확보할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с кэшей приложений и старых установщиков: можно освободить около %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por las cachés de apps y los instaladores antiguos: se pueden liberar unos %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのキャッシュと古いインストーラから始めると、約 %@ を解放できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par les caches d’apps et les anciens installateurs : environ %@ peuvent être libérés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit App-Caches und alten Installern: etwa %@ lassen sich freigeben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia da cache e vecchi installer: puoi liberare circa %@."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece por caches e instaladores antigos: cerca de %@ pode ser liberado."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先處理應用程式快取和舊安裝程式，預計可釋放 %@。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama önbellekleri ve eski yükleyicilerle başlayın: yaklaşık %@ kazanılabilir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od pamięci podręcznych aplikacji i starych instalatorów: można odzyskać około %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met app-caches en oude installatieprogramma’s: ongeveer %@ kan vrijkomen."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເລີ່ມຈາກແຄຊ໌ ແລະ ໂປຣແກຣມຕິດຕັ້ງເກົ່າ: ສາມາດສ້າງພື້ນທີ່ປະມານ %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بذاكرة التطبيقات المؤقتة وبرامج التثبيت القديمة: يمكن تحرير نحو %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו במטמוני אפליקציות ומתקינים ישנים: ניתן לפנות כ-%@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از حافظهٔ نهانی برنامه‌ها و نصب‌کننده‌های قدیمی شروع کنید: حدود %@ آزاد می‌شود."
          }
        }
      }
    },

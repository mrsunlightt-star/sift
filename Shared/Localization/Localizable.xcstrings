    "uninstall.quitFailed": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift could not ask %@ to quit. Quit it manually and try again."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 无法请求 %@ 退出。请手动退出后重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift가 %@에 종료를 요청하지 못했습니다. 직접 종료한 뒤 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift не удалось попросить %@ завершить работу. Закройте его вручную и повторите."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift no pudo pedir a %@ que se cerrara. Ciérrala manualmente e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift は %@ に終了を要求できませんでした。手動で終了してから再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift n’a pas pu demander à %@ de quitter. Quittez-le manuellement et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift konnte %@ nicht zum Beenden auffordern. Beenden Sie es manuell und versuchen Sie es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift non è riuscito a chiedere a %@ di chiudersi. Chiudila manualmente e riprova."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift não conseguiu pedir para %@ encerrar. Feche manualmente e tente de novo."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 無法要求 %@ 結束。請手動結束後重試。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift, %@’yı kapanması için uyaramadı. Elle kapatıp yeniden deneyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift nie mógł poprosić %@ o zamknięcie. Zamknij ją ręcznie i spróbuj ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift kon %@ niet vragen af te sluiten. Sluit het handmatig af en probeer het opnieuw."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ຂໍໃຫ້ %@ ອອກບໍ່ສຳເລັດ. ອອກເອງກ່ອນ ແລ້ວລອງໃໝ່."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن Sift من مطالبة %@ بالإغلاق. أغلقه يدويًا وحاول مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift לא הצליח לבקש מ-%@ להיסגר. סגרו אותו ידנית ונסו שוב."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift نتوانست از %@ بخواهد که ببندد. آن را دستی ببندید و دوباره تلاش کنید."
          }
        }
      }
    },
    "uninstall.reason.applicationName": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name is exactly the application name, in a folder macOS keeps per app."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称与应用名完全一致，且位于 macOS 按应用存放数据的目录。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 앱 이름과 정확히 일치하며, macOS가 앱별로 사용하는 폴더입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя точно совпадает с приложением, и папка предназначена для данных приложений."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre coincide exactamente y la carpeta es la que macOS usa por app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前がアプリ名と完全に一致し、macOS がアプリごとに使うフォルダーです。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom correspond exactement, dans un dossier que macOS réserve aux apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name stimmt genau überein, in einem Ordner, den macOS je App verwendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome coincide con quello dell’app, in una cartella che macOS riserva a ciascuna app."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome coincide exatamente com o do app, em uma pasta que o macOS mantém por app."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱與應用程式名稱完全一致，且位於 macOS 按應用程式存放資料的目錄。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad, uygulamanın adıyla birebir aynı ve macOS’un uygulama başına kullandığı klasörde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa dokładnie odpowiada aplikacji, w folderze, który macOS prowadzi per aplikacja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam komt exact overeen met de app, in een map die macOS per app bijhoudt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຊື່ກົງກັບຊື່ແອັບ ແລະ ຢູ່ໃນໂຟນເດີທີ່ macOS ເກັບຂໍ້ມູນຕໍ່ແອັບ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسم يطابق اسم التطبيق تمامًا، في مجلد يحتفظ به macOS لكل تطبيق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם תואם בדיוק לשם האפליקציה, בתיקייה ש-macOS משתמש בה לכל אפליקציה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام دقیقاً با نام برنامه یکسان است و در پوشه‌ای است که مک‌او‌اس برای هر برنامه نگه می‌دارد."
          }
        }
      }
    },

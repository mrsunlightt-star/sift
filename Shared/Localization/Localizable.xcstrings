    "diagnostics.coverage.complete": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This result covers everything that was asked for."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次结果覆盖了全部请求的范围。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 범위를 모두 확인했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

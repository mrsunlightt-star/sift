    "storage.localNote": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured on this Mac. Nothing is uploaded or sent online."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据来自本机分析，不上传、不联网。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 분석한 데이터입니다. 업로드하거나 전송하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерено на этом Mac. Ничего не отправляется в сеть."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido en este Mac. No se sube ni se envía nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で計測したデータです。送信やアップロードは行いません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré sur ce Mac. Rien n’est envoyé en ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac gemessen. Nichts wird hochgeladen oder gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misurato su questo Mac. Nulla viene caricato o inviato online."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido neste Mac. Nada é enviado para a rede."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料來自本機分析，不上傳、不連網。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’te ölçüldü. Hiçbir şey yüklenmez veya gönderilmez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmierzono na tym Macu. Nic nie jest wysyłane ani umieszczane w sieci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeten op deze Mac. Niets wordt geüpload of online verstuurd."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ວັດແທກຢູ່ເຄື່ອງນີ້. ບໍ່ສົ່ງຂຶ້ນເຊີຟ໌ ຫຼື ເຊື່ອມຕໍ່ອອນລາຍ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قِيس على هذا Mac. لا يُرفع ولا يُرسل عبر الشبكة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נמדד על Mac זה. שום דבר אינו מועלה או נשלח לרשת."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی همین مک اندازه‌گیری شده. هیچ‌چیز بارگذاری یا به شبکه ارسال نمی‌شود."
          }
        }
      }
    },

    "settings.skipConfirmationWarning": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift will start cleaning as soon as you click. Items still go to the Trash, but you will not see the list first."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击后 Sift 会立即开始清理。内容仍会进入废纸篓，但不会先显示列表。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 바로 정리를 시작합니다. 항목은 휴지통으로 이동하지만 목록을 먼저 볼 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift начнёт очистку сразу после нажатия. Файлы попадут в Корзину, но список вы не увидите."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift empezará a limpiar al hacer clic. Todo irá a la papelera, pero no verás la lista antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックするとすぐに削除が始まります。ゴミ箱には入りますが、一覧は表示されません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift nettoiera dès le clic. Les éléments iront à la corbeille, mais sans liste préalable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift beginnt sofort nach dem Klick. Alles landet im Papierkorb, aber ohne vorherige Liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift inizierà a pulire non appena clicchi. Gli elementi vanno comunque nel Cestino, ma non vedrai prima l’elenco."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift começará a limpiar assim que você clicar. Os itens ainda vão para a Lixeira, mas você não verá a lista antes."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按後 Sift 會立即開始清理。內容仍會進入垃圾桶，但不會先顯示列表。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift, tıkladığınız anda temizlemeye başlar. Öğeler yine Çöp Sepeti’ne gider, ama listeyi önce görmezsiniz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift rozpocznie czyszczenie od razu po kliknięciu. Elementy trafią do Kosza, ale nie zobaczysz najpierw listy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift begint meteen met opschonen zodra je klikt. Items gaan nog steeds naar de Prullenbak, maar je ziet de lijst niet eerst."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ຈະເລີ່ມລ້າງທັນທີທີ່ທ່ານກົດ. ລາຍການຍັງເຂົ້າຖັງຂີ້ເຫຍື້ອ ແຕ່ທ່ານຈະບໍ່ໄດ້ເຫັນລາຍການກ່ອນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبدأ Sift التنظيف فور النقر. ستذهب العناصر إلى المهملات، لكنك لن ترى القائمة أولًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift יתחיל לנקות ברגע הלחיצה. הפריטים עדיין יגיעו לפח האשפה, אבל לא תראו את הרשימה קודם."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift به‌محض کلیک پاک‌سازی را آغاز می‌کند. موارد همچنان به سطل بازیافت می‌روند، اما فهرست را پیش از آن نمی‌بینید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ще започне почистване веднага щом натиснете. Елементите все още отиват в Кошчето, но няма да видите списъка първо."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift začne čistit hned po kliknutí. Položky stále jdou do Koše, ale nejprve neuvidíte seznam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift begynder at rydde, så snart du klikker. Elementerne ryger stadig i Papirkurven, men du ser ikke listen først."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sift θα ξεκινήσει τον καθαρισμό μόλις κάνετε κλικ. Τα στοιχεία πηγαίνουν πάντα στον Κάδο, αλλά δεν θα δείτε πρώτα τη λίστα."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift empezará a limpiar en cuanto hagas clic. Los elementos siguen yendo a la Papelera, pero no verás la lista antes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift aloittaa siivouksen heti, kun napsautat. Kohteet siirtyvät silti Roskakoriin, mutta et näe luetteloa ensin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sift a kattintás után azonnal tisztítani kezd. Az elemek továbbra is a Kukába kerülnek, de előbb nem látja a listát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift akan mulai membersihkan begitu Anda mengeklik. Item tetap dipindahkan ke Tempat Sampah, tetapi Anda tidak akan melihat daftarnya terlebih dahulu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift akan mula membersihkan sebaik sahaja anda mengklik. Item tetap masuk ke Tong Sampah, tetapi anda tidak akan melihat senarainya dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift begynner å rydde så snart du klikker. Elementene går fortsatt til Papirkurven, men du ser ikke listen først."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift começa a limpar assim que clicar. Os itens continuam a ir para o Lixo, mas não verá a lista primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift va începe curățarea imediat ce faci clic. Elementele ajung tot în Coș, dar nu vei vedea lista mai întâi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift börjar rensa så snart du klickar. Objekten hamnar fortfarande i Papperskorgen, men du ser inte listan först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift จะเริ่มทำความสะอาดทันทีที่คุณคลิก รายการยังคงถูกย้ายไปที่ถังขยะ แต่คุณจะไม่เห็นรายการก่อน"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift почне очищення одразу після натискання. Елементи все одно перейдуть у Кошик, але списку ви не побачите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift sẽ bắt đầu dọn dẹp ngay khi bạn nhấp. Các mục vẫn được chuyển vào Thùng rác nhưng bạn sẽ không thấy danh sách trước."
          }
        }
      }
    },

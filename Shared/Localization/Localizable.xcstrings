    "diagnostics.remediation.owningApplication": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuild it from the tool that made it"
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由生成它的工具重建"
          }
        },
        "ko": {

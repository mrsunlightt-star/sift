        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 日より前のシステムログです。一部はフルディスクアクセスが必要です。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux système de plus de %d jours. Certains exigent un accès complet au disque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemprotokolle älter als %d Tage. Einige erfordern vollständigen Festplattenzugriff."
          }
        }
      }
    },

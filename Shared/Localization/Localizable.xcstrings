    "report.exportFailed": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report could not be saved. It is still kept locally, so you can try again."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告保存失败。本地报告仍然保留，可以重试。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고서를 저장하지 못했습니다. 로컬 사본은 남아 있으니 다시 시도할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить отчёт. Локальная копия сохранена, можно повторить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el informe. La copia local sigue disponible para reintentar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートを保存できませんでした。ローカルに残っているため再試行できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport n’a pas pu être enregistré. La copie locale permet de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht konnte nicht gespeichert werden. Lokal bleibt er erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rapporto non si è lasciato salvare. La copia locale resta disponibile: puoi riprovare."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O relatório não pôde ser salvo. A cópia local continua disponível para nova tentativa."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "報告儲存失敗。本機報告仍然保留，可以重試。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapor kaydedilemedi. Yerel kopya duruyor; yeniden deneyebilirsiniz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać raportu. Lokalna kopia pozostała, można spróbować ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het rapport kon niet worden opgeslagen. De lokale kopie blijft bestaan; probeer het opnieuw."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບັນທຶກລາຍງານບໍ່ສຳເລັດ. ສຳເນົາໃນເຄື່ອງຍັງຢູ່ ຈຶ່ງລອງໃໝ່ໄດ້."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ التقرير. تبقى النسخة المحلية متاحة لإعادة المحاولة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדוח לא נשמר. העותק המקומי נותר זמין לניסיון חוזר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ذخیرهٔ گزارش ممکن نشد. نسخهٔ محلی هنوز هست؛ دوباره تلاش کنید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчетът не можа да бъде запазен. Все още се пази локално, така че можете да опитате отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zprávu nešlo uložit. Zůstává uložena lokálně, takže to můžete zkusit znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporten kunne ikke gemmes. Den bevares stadig lokalt, så du kan prøve igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναφορά δεν ήταν δυνατό να αποθηκευτεί. Διατηρείται τοπικά, ώστε να μπορείτε να δοκιμάσετε ξανά."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el informe. La copia local sigue disponible para volver a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raporttia ei voitu tallentaa. Se säilytetään silti paikallisesti, joten voit yrittää uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelentést nem sikerült menteni. Helyben továbbra is megvan, így újra próbálkozhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan tidak dapat disimpan. Laporan tetap tersimpan secara lokal, jadi Anda dapat mencoba lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan tidak dapat disimpan. Ia masih disimpan secara setempat, jadi anda boleh mencuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporten kunne ikke lagres. Den beholdes fortsatt lokalt, så du kan prøve igjen."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O relatório não pôde ser guardado. Continua disponível localmente, pelo que pode tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportul nu a putut fi salvat. Este încă păstrat local, așa că poți încerca din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapporten kunde inte sparas. Den finns fortfarande kvar lokalt, så du kan försöka igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกรายงานได้ แต่รายงานยังถูกเก็บไว้ในเครื่อง ดังนั้นคุณสามารถลองอีกครั้งได้"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти звіт. Його локальну копію збережено, тож можна спробувати ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu báo cáo. Báo cáo vẫn được giữ trên máy nên bạn có thể thử lại."
          }
        }
      }
    },

    "settings.deleteReportsConfirm": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all saved PDF reports? This cannot be undone."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除所有已保存的 PDF 报告？此操作无法撤销。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모든 PDF 보고서를 삭제할까요? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить все сохранённые PDF-отчёты? Это действие нельзя отменить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todos los informes PDF guardados? Esta acción no se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されているすべての PDF レポートを削除しますか？この操作は取り消せません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer tous les rapports PDF enregistrés ? Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gespeicherten PDF-Berichte löschen? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare tutti i rapporti PDF salvati? L’operazione non si può annullare."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir todos os relatórios PDF salvos? Esta ação não pode ser desfeita."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除所有已儲存的 PDF 報告？此操作無法復原。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı tüm PDF raporları silinsin mi? Bu işlem geri alınamaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć wszystkie zapisane raporty PDF? Tej czynności nie można cofnąć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle opgeslagen PDF-rapporten verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ລຶບລາຍງານ PDF ທີ່ບັນທຶກໄວ້ທັງໝົດ? ເຮັດແລ້ວຍ້ອນກັບບໍ່ໄດ້."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف جميع تقارير PDF المحفوظة؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק את כל הדוחות ב-PDF השמורים? פעולה זו בלתי הפיכה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف همهٔ گزارش‌های PDF ذخیره‌شده؟ این اقدام بازگشت‌پذیر نیست."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да се изтрият ли всички запазени PDF отчети? Това не може да бъде отменено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat všechny uložené zprávy PDF? Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet alle gemte PDF-rapporter? Dette kan ikke fortrydes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγραφή όλων των αποθηκευμένων αναφορών PDF; Η ενέργεια δεν αναιρείται."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todos los informes PDF guardados? Esta acción no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko kaikki tallennetut PDF-raportit? Tätä ei voi kumota."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli az összes mentett PDF-jelentést? Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus semua laporan PDF tersimpan? Tindakan ini tidak dapat dibatalkan."

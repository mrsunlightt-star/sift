        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຍ້າຍໄປຖັງຂີ້ເຫຍື້ອ?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل إلى المهملات؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להעביר אל פח האשפה؟"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به سطل بازیافت منتقل شود؟"
          }
        }
      }
    },
    "cleanup.confirm.undoNotice": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything goes to the Trash, so you can put it back until you empty it."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有内容都会进入废纸篓，在清空前都可以恢复。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 항목은 휴지통으로 이동하며, 비우기 전까지 되돌릴 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё перемещается в Корзину, поэтому можно вернуть до её очистки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo va a la papelera, así que puedes recuperarlo hasta que la vacíes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてゴミ箱に入るため、空にするまで元に戻せます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout va à la corbeille : vous pouvez restaurer jusqu’à ce que vous la vidiez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles landet im Papierkorb und kann bis zum Leeren zurückgeholt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto finisce nel Cestino: puoi ripristinarlo finché non lo svuoti."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo vai para a Lixeira, então você pode recuperar até esvaziá-la."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有內容都會進入垃圾桶，在清空前都可以還原。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey Çöp Sepeti’ne gider; boşaltana kadar geri alabilirsiniz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko trafia do Kosza, więc możesz przywrócić do jego opróżnienia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gaat naar de Prullenbak, dus je kunt het terugzetten totdat je die leegt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທຸກຢ່າງຈະເຂົ້າຖັງຂີ້ເຫຍື້ອ ຈຶ່ງກູ້ຄືນໄດ້ຈົນກວ່າຈະລ້າງຖັງ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يذهب إلى المهملات، لذا يمكنك استعادته حتى تفرغها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול יועבר אל פח האשפה, כך שאפשר לשחזר עד שתרוקנו אותו."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه چیز به سطل بازیافت می‌رود؛ تا زمان خالی کردنش می‌توانید بازگردانید."
          }
        }
      }
    },
    "cleanup.explanation.cache": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps rebuild these files the next time they run."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用下次运行时会重新生成这些文件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 다음 실행 시 이 파일들을 다시 만듭니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения создадут эти файлы заново при следующем запуске."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps regeneran estos archivos la próxima vez que se ejecutan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは次回起動時にこれらのファイルを再作成します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps recréent ces fichiers à leur prochaine ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps erzeugen diese Dateien beim nächsten Start neu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app ricreano questi file alla successiva esecuzione."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps recriam esses arquivos na próxima execução."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式下次執行時會重新產生這些檔案。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar bu dosyaları bir sonraki çalıştırmada yeniden oluşturur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje odtworzą te pliki przy następnym uruchomieniu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De apps maken deze bestanden opnieuw aan bij de volgende keer dat ze draaien."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແອັບຈະສ້າງໄຟລ໌ເຫຼົ່ານີ້ຄືນໃໝ່ເມື່ອເປີດຄັ້ງຕໍ່ໄປ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيد التطبيقات إنشاء هذه الملفات عند تشغيلها في المرة القادمة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציות ייצרו מחדש את הקבצים האלה בהפעלה הבאה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌ها دفعهٔ بعد که اجرا شوند این فایل‌ها را دوباره می‌سازند."
          }
        }
      }
    },
    "cleanup.explanation.duplicates": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identical content. Keep one copy and remove the rest."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容完全相同。保留一份，删除其余。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 완전히 동일합니다. 하나만 남기고 나머지를 삭제하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентичное содержимое. Оставьте одну копию и удалите остальные."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido idéntico. Conserva una copia y elimina el resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が完全に同じです。1 つを残して他を削除します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu identique. Gardez une copie et supprimez les autres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Identischer Inhalt. Eine Kopie behalten, den Rest entfernen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenuto identico. Conserva una copia e rimuovi le altre."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo idêntico. Mantenha uma cópia e remova as demais."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容完全相同。保留一份，刪除其餘。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerik birebir aynı. Bir kopyayı tutun, gerisini kaldırın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Identyczna zawartość. Zachowaj jedną kopię i usuń pozostałe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Identieke inhoud. Bewaar één exemplaar en verwijder de rest."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເນື້ອໃນຄືກັນໝົດ. ເກັບໄວ້ໜຶ່ງ ລຶບທີ່ເຫຼືອ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محتوى متطابق. احتفظ بنسخة واحدة واحذف البقية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוכן זהה. שמרו עותק אחד והסירו את השאר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محتوا یکسان است. یکی را نگه دارید و بقیه را حذف کنید."
          }
        }
      }
    },
    "cleanup.explanation.installers": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installers you already used. You may still need them, so confirm first."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经使用过的安装包。你可能仍需要它们，请先确认。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 사용한 설치 파일입니다. 필요할 수 있으니 먼저 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установщики, которые вы уже использовали. Они могут ещё понадобиться."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores que ya usaste. Puede que aún los necesites, confirma antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用済みのインストーラです。必要になる場合があるため確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installateurs déjà utilisés. Vous pourriez en avoir besoin, vérifiez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits verwendete Installer. Sie könnten sie noch brauchen – bitte prüfen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer già utilizzati. Potresti averne ancora bisogno: conferma prima."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores que você já usou. Ainda pode precisar deles; confirme antes."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經使用過的安裝程式。你可能仍需要它們，請先確認。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten kullandığınız yükleyiciler. Hâlâ gerekebilir; önce onaylayın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalatory, które zostały już użyte. Mogą jeszcze być potrzebne — najpierw potwierdź."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installatieprogramma’s die je al hebt gebruikt. Je kunt ze nog nodig hebben — bevestig eerst."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໂປຣແກຣມຕິດຕັ້ງທີ່ໃຊ້ແລ້ວ. ທ່ານອາດຍັງຕ້ອງການ, ກະລຸນາຢືນຢັນກ່ອນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برامج تثبيت استخدمتها بالفعل. قد تحتاجها بعدُ، فأكّد أولًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתקינים שכבר השתמשת בהם. ייתכן שעדיין תזדקק להם — אשר קודם."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نصب‌کننده‌هایی که پیش‌تر استفاده کرده‌اید. شاید هنوز لازمشان داشته باشید؛ ابتدا تأیید کنید."
          }
        }
      }
    },
    "cleanup.explanation.largeFiles": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files larger than %@. Sift never guesses: you decide which to remove."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大于 %@ 的文件。Sift 不做猜测，由你决定删除哪些。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@보다 큰 파일입니다. 어떤 파일을 지울지는 사용자가 결정합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы больше %@. Sift не угадывает: решение за вами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de más de %@. Sift no adivina: tú decides cuáles eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を超えるファイルです。削除するかどうかはご自身で決められます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers de plus de %@. Sift ne devine pas : c’est vous qui décidez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien größer als %@. Sift rät nicht – Sie entscheiden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File più grandi di %@. Sift non indovina: sei tu a decidere cosa rimuovere."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos maiores que %@. O Sift não adivinha: você decide o que remover."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大於 %@ 的檔案。Sift 不做猜測，由你決定刪除哪些。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzeri dosyalar. Sift tahmin yapmaz: neyin kaldırılacağına siz karar verirsiniz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki większe niż %@. Sift nie zgaduje: to Ty decydujesz, co usunąć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden groter dan %@. Sift gokt niet: jij bepaalt wat er verwijderd wordt."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໄຟລ໌ທີ່ໃຫຍ່ກວ່າ %@. Sift ບໍ່ເດາະເດາະ: ທ່ານເປັນຜູ້ຕັດສິນວ່າຈະລຶບອັນໃດ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفات أكبر من %@. لا يخمّن Sift: أنت من يقرر ماذا يُزال."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים גדולים מ-%@. Sift לא מנחש: אתם מחליטים מה להסיר."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل‌های بزرگ‌تر از %@. Sift حدس نمی‌زند: تصمیم حذف با شماست."
          }
        }
      }
    },

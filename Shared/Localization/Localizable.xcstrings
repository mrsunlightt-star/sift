        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadata carian yang disimpan sistem untuk kandungan anda sendiri. Saiznya tidak dapat dibaca: Akses Cakera Penuh diperlukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søkemetadata som systemet lagrer for ditt eget innhold. Størrelsen kunne ikke leses: full disktilgang kreves."
          }
        },
        "pt-pt": {
          "stringUnit": {

    "dashboard.scanCard.subtitle": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, logs, installers and leftover files. Every item shows its source and purpose before removal."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描缓存、日志、安装包和残留文件。所有项目都会在删除前展示来源和用途。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시, 로그, 설치 파일 및 잔여 파일을 검사합니다. 모든 항목은 삭제 전에 출처와 용도를 보여줍니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэши, логи, установщики и остатки файлов. Каждый элемент показывает источник и назначение до удаления."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés, registros, instaladores y archivos residuales. Cada elemento muestra su origen y propósito antes de eliminarse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ、ログ、インストーラ、残留ファイルを対象にします。削除前に由来と用途を表示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, journaux, installateurs et fichiers résiduels. Chaque élément indique son origine et son utilité avant suppression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, Protokolle, Installer und Reste. Jeder Eintrag zeigt vor dem Löschen Quelle und Zweck."
          }
        }
      }
    },

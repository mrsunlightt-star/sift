    "settings.exportLogsDetail": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics contain no file names or full paths."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断日志不包含文件名或完整路径。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 로그에는 파일 이름이나 전체 경로가 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика не содержит имён файлов или полных путей."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diagnósticos no contienen nombres ni rutas completas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断情報にファイル名や完全なパスは含まれません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les diagnostics ne contiennent ni noms ni chemins complets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosedaten enthalten keine Dateinamen oder vollständigen Pfade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La diagnostica non contiene nomi di file né percorsi completi."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Os diagnósticos não contêm nomes de arquivos nem caminhos completos."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷資訊不包含檔名或完整路徑。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanılama verileri dosya adı veya tam yol içermez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostyka nie zawiera nazw plików ani pełnych ścieżek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostiek bevat geen bestandsnamen of volledige paden."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ການວິນິດໄສບໍ່ມີຊື່ໄຟລ໌ ຫຼື ເສັ້ນທາງເຕັມ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشخيص لا يحتوي على أسماء ملفات أو مسارات كاملة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האבחון אינו מכיל שמות קבצים או נתיבים מלאים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دادهٔ عیب‌یابی شامل نام فایل یا مسیر کامل نیست."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностиката не съдържа имена на файлове или пълни пътища."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostika neobsahuje názvy souborů ani úplné cesty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosedata indeholder ingen filnavne eller fulde stier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα διαγνωστικά δεν περιέχουν ονόματα αρχείων ή πλήρεις διαδρομές."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diagnósticos no contienen nombres de archivos ni rutas completas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostiikka ei sisällä tiedostonimiä tai täydellisiä polkuja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diagnosztika nem tartalmaz fájlneveket vagy teljes elérési utakat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostik tidak berisi nama file atau jalur lengkap."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostik tidak mengandungi nama fail atau laluan penuh."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostikken inneholder ingen filnavn eller fulle stier."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os diagnósticos não contêm nomes de ficheiros nem caminhos completos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosticarea nu conține nume de fișiere sau căi complete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostiken innehåller inga filnamn eller fullständiga sökvägar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลวินิจฉัยไม่มีชื่อไฟล์หรือเส้นทางแบบเต็ม"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діагностика не містить назв файлів чи повних шляхів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chẩn đoán không chứa tên tệp hay đường dẫn đầy đủ."
          }
        }
      }
    },

    "settings.privacyStatement": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift does not collect file contents, file names, full paths, browsing history, app usage or account details. Scan results stay on this Mac, and nothing is uploaded."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 不采集文件内容、文件名、完整路径、浏览历史、应用使用记录或账号信息。扫描结果只保存在本机，不会上传。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift는 파일 내용, 파일 이름, 전체 경로, 방문 기록, 앱 사용 기록 또는 계정 정보를 수집하지 않습니다. 검사 결과는 이 Mac에만 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift не собирает содержимое файлов, имена, полные пути, историю браузера, данные об использовании приложений или аккаунт. Результаты остаются на этом Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift no recopila contenidos, nombres de archivo, rutas completas, historial de navegación, uso de apps ni datos de cuenta. Los resultados se quedan en este Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift はファイル内容、ファイル名、完全なパス、閲覧履歴、アプリの使用履歴、アカウント情報を収集しません。結果はこの Mac にのみ保存されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ne collecte ni contenu, ni noms de fichiers, ni chemins complets, ni historique, ni usage des apps, ni données de compte. Les résultats restent sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift erfasst keine Dateiinhalte, Dateinamen, vollständigen Pfade, Verläufe, App-Nutzung oder Kontodaten. Ergebnisse bleiben auf diesem Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift non raccoglie contenuti dei file, nomi dei file, percorsi completi, cronologia di navigazione, uso delle app o dati dell’account. I risultati della scansione restano su questo Mac e nulla viene caricato online."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift não coleta conteúdos de arquivos, nomes, caminhos completos, histórico de navegação, uso de apps ou dados de conta. Os resultados da verificação ficam neste Mac, e nada é enviado."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 不蒐集檔案內容、檔名、完整路徑、瀏覽記錄、應用程式使用記錄或帳號資訊。掃描結果只保存在本機，不會上傳。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift; dosya içeriklerini, dosya adlarını, tam yolları, tarama geçmişini, uygulama kullanımını veya hesap bilgilerini toplamaz. Tarama sonuçları bu Mac’te kalır, hiçbir şey yüklenmez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift nie zbiera treści plików, ich nazw, pełnych ścieżek, historii przeglądania, użycia aplikacji ani danych konta. Wyniki skanowania zostają na tym Macu, nic nie jest wysyłane."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift verzamelt geen bestandsinhoud, bestandsnamen, volledige paden, browsegeschiedenis, app-gebruik of accountgegevens. Scanresultaten blijven op deze Mac, er wordt niets geüpload."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ບໍ່ເກັບເນື້ອໃນໄຟລ໌, ຊື່ໄຟລ໌, ເສັ້ນທາງເຕັມ, ປະຫວັດການທ່ອງເວັບ, ການໃຊ້ແອັບ ຫຼື ຂໍ້ມູນບັນຊີ. ຜົນການສະແກນຢູ່ໃນເຄື່ອງນີ້ເທົ່ານັ້ນ ບໍ່ມີການສົ່ງຂຶ້ນເຊີຟ໌ເວີ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجمع Sift محتويات الملفات، ولا أسماءها، ولا المسارات الكاملة، ولا سجل التصفح، ولا استخدام التطبيقات، ولا بيانات الحساب. تبقى نتائج الفحص على هذا Mac ولا يُرفع شيء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift אינו אוסף תכני קבצים, שמות קבצים, נתיבים מלאים, היסטוריית גלישה, שימוש באפליקציות או פרטי חשבון. תוצאות הסריקה נשארות ב-Mac הזה ושום דבר אינו מועלה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift محتوای فایل‌ها، نام فایل‌ها، مسیرهای کامل، سابقهٔ مرور، استفاده از برنامه‌ها یا اطلاعات حساب را جمع نمی‌کند. نتایج اسکن فقط روی همین مک می‌ماند و هیچ‌چیز بارگذاری نمی‌شود."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift не събира съдържание на файлове, имена на файлове, пълни пътища, история на сърфиране, използване на приложения или данни за акаунт. Резултатите от сканирането остават на този Mac и нищо не се качва."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift neshromažďuje obsah souborů, názvy souborů, úplné cesty, historii prohlížení, používání aplikací ani údaje o účtu. Výsledky skenování zůstávají na tomto Macu a nic se neodesílá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift indsamler ikke filindhold, filnavne, fulde stier, browserhistorik, appforbrug eller kontooplysninger. Scanningsresultater bliver på denne Mac, og intet uploades."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sift δεν συλλέγει περιεχόμενα αρχείων, ονόματα αρχείων, πλήρεις διαδρομές, ιστορικό περιήγησης, χρήση εφαρμογών ή στοιχεία λογαριασμού. Τα αποτελέσματα της σάρωσης παραμένουν σε αυτό το Mac και τίποτα δεν μεταφορτώνεται."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift no recopila contenidos de archivos, nombres de archivos, rutas completas, historial de navegación, uso de aplicaciones ni datos de cuenta. Los resultados del análisis se quedan en este Mac y no se sube nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ei kerää tiedostojen sisältöä, tiedostonimiä, täydellisiä polkuja, selaushistoriaa, sovellusten käyttöä tai tilitietoja. Skannaustulokset pysyvät tällä Macilla, eikä mitään ladata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sift nem gyűjt fájltartalmat, fájlneveket, teljes elérési utakat, böngészési előzményeket, alkalmazáshasználatot vagy fiókadatokat. A vizsgálati eredmények ezen a Macen maradnak, és semmi nem kerül feltöltésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift tidak mengumpulkan konten file, nama file, jalur lengkap, riwayat penjelajahan, penggunaan aplikasi, atau detail akun. Hasil pemindaian tetap di Mac ini, dan tidak ada yang diunggah."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift tidak mengumpul kandungan fail, nama fail, laluan penuh, sejarah pelayaran, penggunaan apl atau butiran akaun. Hasil imbasan kekal pada Mac ini, dan tiada apa-apa dimuat naik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift samler ikke inn filinnhold, filnavn, fulle stier, nettleserhistorikk, appbruk eller kontoopplysninger. Skanneresultatene blir på denne Macen, og ingenting lastes opp."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift não recolhe conteúdos de ficheiros, nomes de ficheiros, caminhos completos, histórico de navegação, utilização de aplicações nem dados de conta. Os resultados da verificação ficam neste Mac e nada é enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift nu colectează conținutul fișierelor, numele fișierelor, căi complete, istoricul de navigare, utilizarea aplicațiilor sau detalii de cont. Rezultatele scanării rămân pe acest Mac și nimic nu este încărcat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift samlar inte in filinnehåll, filnamn, fullständiga sökvägar, webbläsarhistorik, appanvändning eller kontouppgifter. Skanningsresultaten stannar på den här Macen och inget laddas upp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ไม่เก็บเนื้อหาไฟล์ ชื่อไฟล์ เส้นทางแบบเต็ม ประวัติการท่องเว็บ การใช้งานแอป หรือรายละเอียดบัญชี ผลการสแกนอยู่ใน Mac เครื่องนี้ และไม่มีสิ่งใดถูกอัปโหลด"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift не збирає вміст файлів, назви файлів, повні шляхи, історію перегляду, дані про використання програм чи дані облікового запису. Результати сканування залишаються на цьому Mac, і нічого не завантажується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift không thu thập nội dung tệp, tên tệp, đường dẫn đầy đủ, lịch sử duyệt web, việc sử dụng ứng dụng hay chi tiết tài khoản. Kết quả quét ở lại trên Mac này và không có gì được tải lên."
          }
        }
      }
    },

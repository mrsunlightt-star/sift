        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En stor fil. Sift gjetter aldri: du bestemmer hva som fjernes."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ficheiro grande. O Sift não adivinha: a decisão é sua."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fișier mare. Sift nu ghicește niciodată: tu decizi ce se elimină."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En stor fil. Sift gissar aldrig: du bestämmer vad som ska tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ขนาดใหญ่ Sift ไม่เดา คุณเป็นผู้ตัดสินว่าจะลบไฟล์ใด"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Великий файл. Sift ніколи не вгадує: ви вирішуєте, чи видаляти його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tệp lớn. Sift không đoán: bạn quyết định xóa tệp nào."
          }
        }
      }
    },
    "cleanup.explanation.logs": {
      "comment": null,

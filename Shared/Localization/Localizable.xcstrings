    "dashboard.scanCard.subtitle": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, logs, installers and leftover files. Every item shows its source and purpose before removal."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描缓存、日志、安装包和残留文件。所有项目都会在删除前展示来源和用途。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시, 로그, 설치 파일 및 잔여 파일을 검사합니다. 모든 항목은 삭제 전에 출처와 용도를 보여줍니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэши, логи, установщики и остатки файлов. Каждый элемент показывает источник и назначение до удаления."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés, registros, instaladores y archivos residuales. Cada elemento muestra su origen y propósito antes de eliminarse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ、ログ、インストーラ、残留ファイルを対象にします。削除前に由来と用途を表示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, journaux, installateurs et fichiers résiduels. Chaque élément indique son origine et son utilité avant suppression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, Protokolle, Installer und Reste. Jeder Eintrag zeigt vor dem Löschen Quelle und Zweck."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, log, programmi di installazione e file residui. Ogni elemento mostra origine e scopo prima della rimozione."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, logs, instaladores e arquivos residuais. Cada item mostra a origem e a finalidade antes da remoção."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描快取、記錄檔、安裝程式和殘留檔案。所有項目都會在刪除前顯示來源和用途。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellekler, günlükler, yükleyiciler ve artık dosyalar. Her öğe silinmeden önce kaynağını ve amacını gösterir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamięci podręczne, dzienniki, instalatory i pozostałości plików. Każdy element pokazuje źródło i cel przed usunięciem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, logbestanden, installatieprogramma’s en achtergebleven bestanden. Elk item toont bron en doel vóór verwijdering."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຄຊ໌, ໄຟລ໌ບັນທຶກ, ໂປຣແກຣມຕິດຕັ້ງ ແລະ ໄຟລ໌ຕົກຄ້າງ. ທຸກໆລາຍການສະແດງແຫຼ່ງທີ່ມາ ແລະ ຈຸດປະສົງກ່ອນການລຶບ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة مؤقتة وسجلات وبرامج تثبيت وملفات متبقية. يعرض كل عنصر مصدره وغرضه قبل الإزالة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מטמונים, יומנים, מתקינים וקבצים שנותרו. כל פריט מציג את מקורו וייעודו לפני ההסרה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظه‌های نهانی، گزارش‌ها، نصب‌کننده‌ها و فایل‌های باقی‌مانده. هر مورد پیش از حذف، منبع و کاربردش را نشان می‌دهد."
          }
        }
      }
    },

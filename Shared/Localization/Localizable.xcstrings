            "state": "translated",
            "value": "앱 캐시와 오래된 설치 파일부터 처리하면 약 %@을 확보할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с кэшей приложений и старых установщиков: можно освободить около %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por las cachés de apps y los instaladores antiguos: se pueden liberar unos %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのキャッシュと古いインストーラから始めると、約 %@ を解放できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par les caches d’apps et les anciens installateurs : environ %@ peuvent être libérés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit App-Caches und alten Installern: etwa %@ lassen sich freigeben."
          }
        }
      }
    },

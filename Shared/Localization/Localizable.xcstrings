    "diagnostics.explanation.systemData": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of macOS or its libraries. It occupies space and cannot be removed."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属于 macOS 或其系统库。它占用空间，但不能删除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 또는 시스템 라이브러리의 일부입니다. 공간을 차지하지만 삭제할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть macOS или её библиотек. Занимает место и не может быть удалена."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de macOS o de sus bibliotecas. Ocupa espacio y no se puede eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS またはそのライブラリの一部です。容量を使いますが削除できません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait partie de macOS ou de ses bibliothèques. Occupe de l’espace et ne peut pas être supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teil von macOS oder dessen Bibliotheken. Belegt Platz und darf nicht entfernt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte di macOS o delle sue librerie. Occupa spazio e non si può rimuovere."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do macOS ou de suas bibliotecas. Ocupa espaço e não pode ser removida."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屬於 macOS 或其系統程式庫。它佔用空間，但不能刪除。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS’un veya kitaplıklarının bir parçası. Yer kaplar ve kaldırılamaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część macOS lub jego bibliotek. Zajmuje miejsce i nie można jej usunąć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderdeel van macOS of diens bibliotheken. Neemt ruimte in en kan niet verwijderd worden."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເປັນສ່ວນໜຶ່ງຂອງ macOS ຫຼື ຄັງສະຄຣິບຂອງມັນ. ກິນພື້ນທີ່ ແຕ່ລຶບອອກບໍ່ໄດ້."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جزء من macOS أو مكتباته. يشغل مساحة ولا يمكن إزالته."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מ-macOS או מהספריות שלו. תופס שטח ואינו ניתן להסרה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بخشی از مک‌او‌اس یا کتابخانه‌هایش. فضا اشغال می‌کند و قابل حذف نیست."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Част от macOS или неговите библиотеки. Заема място и не може да бъде премахната."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Součást macOS nebo jeho knihoven. Zabírá místo a nelze ji odstranit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En del af macOS eller dets biblioteker. Den optager plads og kan ikke fjernes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέρος του macOS ή των βιβλιοθηκών του. Καταλαμβάνει χώρο και δεν μπορεί να αφαιρεθεί."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de macOS o de sus bibliotecas. Ocupa espacio y no se puede eliminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osa macOS:ää tai sen kirjastoja. Se vie tilaa, eikä sitä voi poistaa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS vagy könyvtárai része. Helyet foglal, és nem távolítható el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian dari macOS atau pustakanya. Menempati ruang dan tidak dapat dihapus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebahagian daripada macOS atau pustakanya. Ia menggunakan ruang dan tidak boleh dibuang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En del av macOS eller bibliotekene. Den tar plass og kan ikke fjernes."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do macOS ou das suas bibliotecas. Ocupa espaço e não pode ser eliminada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte din macOS sau din bibliotecile sale. Ocupă spațiu și nu poate fi eliminat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En del av macOS eller dess bibliotek. Den tar plats och kan inte tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนหนึ่งของ macOS หรือไลบรารีของระบบ ใช้พื้นที่และไม่สามารถลบได้"

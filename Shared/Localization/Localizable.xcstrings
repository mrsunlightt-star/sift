        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns locais exigem o Acesso Total ao Disco para serem medidos."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分位置需要完全磁碟存取權限才能統計。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı konumların ölçülebilmesi Tam Disk Erişimi gerektiriyor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre lokalizacje wymagają pełnego dostępu do dysku, aby można je było zmierzyć."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige locaties hebben Volledige Schijftoegang nodig om gemeten te kunnen worden."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ບາງຕຳແໜ່ງຕ້ອງມີສິດເຂົ້າເຖິງດິສກ໌ຢ່າງເຕັມສ່ວນ ຈຶ່ງວັດແທກໄດ້."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج بعض المواقع إلى الوصول الكامل إلى القرص لتُقاس."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהמיקומים דורש גישה מלאה לכונן כדי להימדד."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی مکان‌ها برای اندازه‌گیری به دسترسی کامل به دیسک نیاز دارند."
          }
        }
      }
    },

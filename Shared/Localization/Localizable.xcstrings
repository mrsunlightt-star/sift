        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift no toca esta ubicación para proteger tus archivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを保護するため、この場所は処理しません。"
          }

    "uninstall.appRunning": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is running. Quit it before removing, or Sift will skip the files it holds open."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在运行。请先退出，否则 Sift 会跳过被占用的文件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 실행 중입니다. 먼저 종료하지 않으면 사용 중인 파일은 건너뜁니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запущено. Закройте его, иначе Sift пропустит занятые файлы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se está ejecutando. Ciérrala antes, o Sift omitirá los archivos en uso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が実行中です。先に終了しないと、使用中のファイルはスキップされます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en cours d’exécution. Quittez-le, sinon Sift ignorera les fichiers ouverts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft. Beenden Sie es, sonst überspringt Sift die geöffneten Dateien."
          }
        }
      }
    },

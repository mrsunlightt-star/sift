    "storage.diskDisconnected": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This disk is no longer connected. Reconnect it and scan again."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁盘已断开连接。请重新连接后再扫描。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스크의 연결이 끊어졌습니다. 다시 연결한 뒤 검사하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот диск отключён. Подключите его снова и повторите."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disco ya no está conectado. Vuelve a conectarlo y analiza de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスクは接続されていません。再接続してスキャンしてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce disque n’est plus connecté. Reconnectez-le puis relancez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Laufwerk ist nicht mehr verbunden. Bitte erneut anschließen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo disco non è più collegato. Ricollegalo e scansiona di nuovo."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disco não está mais conectado. Reconecte-o e verifique novamente."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁碟已斷開連接。請重新連接後再掃描。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu disk artık bağlı değil. Yeniden bağlayın ve yeniden tarayın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dysk nie jest już podłączony. Podłącz go ponownie i skanuj jeszcze raz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze schijf is niet meer verbonden. Sluit hem opnieuw aan en scan opnieuw."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດິສກ໌ນີ້ຖືກຕັດການເຊື່ອມຕໍ່ແລ້ວ. ກະລຸນາເຊື່ອມຄືນ ແລ້ວສະແກນອີກຄັ້ງ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا القرص لم يعد متصلًا. أعد توصيله وافحص مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכונן הזה כבר אינו מחובר. חברו אותו שוב וסרקו פעם נוספת."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این دیسک دیگر وصل نیست. دوباره وصلش کنید و دوباره اسکن بگیرید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този диск вече не е свързан. Свържете го отново и сканирайте."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento disk už není připojen. Připojte jej a skenujte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne disk er ikke længere tilsluttet. Tilslut den igen, og scan igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο δίσκος δεν είναι πλέον συνδεδεμένος. Συνδέστε τον ξανά και σαρώστε εκ νέου."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disco ya no está conectado. Vuelve a conectarlo y analiza de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä levyä ei ole enää liitetty. Liitä se uudelleen ja skannaa uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a lemez már nincs csatlakoztatva. Csatlakoztassa újra, és vizsgálja meg újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk ini tidak lagi terhubung. Hubungkan kembali dan pindai lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cakera ini tidak lagi disambungkan. Sambung semula dan imbas semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne disken er ikke lenger tilkoblet. Koble den til igjen og skann på nytt."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disco já não está ligado. Ligue-o novamente e verifique outra vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest disc nu mai este conectat. Reconectează-l și scanează din nou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här disken är inte längre ansluten. Anslut den igen och skanna på nytt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดิสก์นี้ไม่ได้เชื่อมต่ออยู่แล้ว เชื่อมต่อใหม่แล้วสแกนอีกครั้ง"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей диск більше не під'єднано. Під'єднайте його знову й скануйте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đĩa này không còn kết nối. Hãy kết nối lại và quét lại."
          }
        }
      }
    },

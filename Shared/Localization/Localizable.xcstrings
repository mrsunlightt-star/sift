    "storage.scopeNote": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File categories cover your home folder and authorised folders on this disk. The toggle adds whole-volume system diagnostics."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件分类统计个人文件夹和此磁盘上已授权的文件夹；开关会为系统诊断加入整卷范围。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 분류는 홈과 이 디스크에서 승인한 폴더를 포함합니다. 스위치는 시스템 진단에 볼륨 전체를 포함합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории файлов охватывают домашнюю папку и разрешённые папки на этом диске. Переключатель добавляет диагностику всего тома."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías cubren tu carpeta personal y las carpetas autorizadas en este disco. La opción añade el diagnóstico de todo el volumen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル分類はホームとこのディスク上で許可したフォルダを対象にします。スイッチはシステム診断にボリューム全体を加えます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les catégories couvrent votre dossier personnel et les dossiers autorisés sur ce disque. L’option ajoute le diagnostic du volume entier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateikategorien umfassen Ihren Benutzerordner und autorisierte Ordner auf diesem Volume. Die Option ergänzt die Systemdiagnose für das gesamte Volume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le categorie di file coprono la tua cartella home e le cartelle autorizzate su questo disco. L’interruttore aggiunge la diagnostica dell’intero volume."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias de arquivos cobrem sua pasta pessoal e as pastas autorizadas neste disco. A opção adiciona o diagnóstico do volume inteiro."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案分類統計個人資料夾和此磁碟上已授權的資料夾；開關會為系統診斷加入整卷範圍。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya kategorileri ana klasörünüzü ve bu diskteki yetkilendirilmiş klasörleri kapsar. Anahtar, sistem tanısına tüm birimi ekler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie plików obejmują Twój folder domowy i autoryzowane foldery na tym dysku. Przełącznik dodaje diagnostykę całego wolumenu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestandscategorieën dekken je persoonlijke map en geautoriseerde mappen op deze schijf. De schakelaar voegt systeemdiagnostiek van het hele volume toe."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ປະເພດໄຟລ໌ນັບໂຟນເດີບ້ານຂອງທ່ານ ແລະ ໂຟນເດີທີ່ໄດ້ຮັບອະນຸຍາດໃນດິສກ໌ນີ້; ສະວິດຈະເພີ່ມການວິນິດໄສທົ່ວຣະບົບ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغطي فئات الملفات مجلدك الرئيسي والمجلدات المصرّح بها على هذا القرص. يضيف المفتاح تشخيص الحجم بالكامل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קטגוריות הקבצים מכסות את התיקייה הביתית שלכם ותיקיות מורשות בכונן זה. המתג מוסיף אבחון מערכת של הכונן כולו."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسته‌های فایل پوشهٔ خانهٔ شما و پوشه‌های مجاز روی این دیسک را در بر می‌گیرند. کلید، عیب‌یابی کل حجم را می‌افزاید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Категориите файлове обхващат вашата домашна папка и разрешените папки на този диск. Превключвателят добавя диагностика на целия том."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie souborů pokrývají vaši domovskou složku a autorizované složky na tomto disku. Přepínač přidá systémovou diagnostiku celého svazku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filkategorier dækker din hjemmemappe og autoriserede mapper på denne disk. Kontakten tilføjer systemdiagnose for hele disken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κατηγορίες αρχείων καλύπτουν τον προσωπικό σας φάκελο και τους εξουσιοδοτημένους φακέλους σε αυτόν τον δίσκο. Ο διακόπτης προσθέτει διαγνωστικά συστήματος για ολόκληρο τον τόμο."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las categorías de archivos abarcan tu carpeta personal y las carpetas autorizadas en este disco. La opción agrega el diagnóstico de todo el volumen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostokategoriat kattavat kotikansiosi ja tämän levyn valtuutetut kansiot. Kytkin lisää koko levyn järjestelmädiagnostiikan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fájlkategóriák a saját mappáját és az engedélyezett mappákat fedik le ezen a lemezen. A kapcsoló hozzáadja a teljes kötet rendszerdiagnosztikáját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategori file mencakup folder home Anda dan folder yang diizinkan di disk ini. Tombol ini menambahkan diagnostik sistem seluruh volume."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategori fail merangkumi folder rumah anda dan folder yang dibenarkan pada cakera ini. Suis ini menambah diagnostik sistem seluruh volum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filkategoriene dekker hjemmappen din og autoriserte mapper på denne disken. Bryteren legger til systemdiagnostikk for hele disken."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As categorias de ficheiros abrangem a sua pasta pessoal e as pastas autorizadas neste disco. A opção acrescenta o diagnóstico de todo o volume."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Categoriile de fișiere acoperă folderul tău personal și folderele autorizate de pe acest disc. Comutatorul adaugă diagnosticarea de sistem a întregului volum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filkategorierna omfattar din hemmapp och auktoriserade mappar på den här disken. Växeln lägger till systemdiagnostik för hela disken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมวดหมู่ไฟล์ครอบคลุมโฟลเดอร์บ้านและโฟลเดอร์ที่อนุญาตบนดิสก์นี้ สวิตช์นี้จะเพิ่มการวินิจฉัยระบบทั้งโวลุ่ม"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Категорії файлів охоплюють вашу домашню папку й дозволені папки на цьому диску. Перемикач додає діагностику всього тому."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh mục tệp bao gồm thư mục home và các thư mục được cho phép trên đĩa này. Công tắc này thêm chẩn đoán hệ thống toàn ổ đĩa."
          }
        }
      }
    },

        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إزالته عادةً، لكن من الأفضل التأكيد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדרך כלל אפשר להסיר, אבל עדיף לאשר."

            "value": "Un archivo grande. Sift no adivina: tú decides cuáles eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きなファイルです。削除するかどうかはご自身で決められます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier volumineux. Sift ne devine pas : c’est vous qui décidez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine große Datei. Sift rät nicht – Sie entscheiden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file di grandi dimensioni. Sift non indovina: sei tu a decidere cosa rimuovere."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo grande. O Sift não adivinha: você decide o que remover."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大型檔案。Sift 不做猜測，由你決定刪除哪些。"
          }
        },
        "tr": {
          "stringUnit": {

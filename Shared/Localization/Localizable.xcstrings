          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjør en skanning for å se hva som trygt kan frigjøres."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute uma verificação para ver o que pode ser libertado em segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulează o scanare pentru a vedea ce poate fi eliberat în siguranță."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör en skanning för att se vad som säkert kan frigöras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รันการสแกนเพื่อดูว่าปลดปล่อยอะไรได้อย่างปลอดภัย"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",

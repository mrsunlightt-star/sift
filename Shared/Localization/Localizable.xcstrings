    "scan.running.readOnly": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads names, sizes and modification dates only. It never opens files or uploads data."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读取文件名、大小与修改时间，不打开内容、不上传任何数据"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 이름, 크기, 수정일만 읽습니다. 내용을 열거나 데이터를 업로드하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читаются только имена, размеры и даты изменения. Содержимое не открывается и никуда не отправляется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lee nombres, tamaños y fechas de modificación. No abre archivos ni sube datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前・サイズ・更新日のみを読み取ります。中身を開いたり送信したりしません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit uniquement les noms, tailles et dates. N’ouvre jamais les fichiers et n’envoie rien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest nur Namen, Größen und Änderungsdaten. Öffnet keine Dateien und lädt nichts hoch."
          }
        }
      }
    },

    "cleanup.explanation.installers": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installers you already used. You may still need them, so confirm first."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经使用过的安装包。你可能仍需要它们，请先确认。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 사용한 설치 파일입니다. 필요할 수 있으니 먼저 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установщики, которые вы уже использовали. Они могут ещё понадобиться."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaladores que ya usaste. Puede que aún los necesites, confirma antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用済みのインストーラです。必要になる場合があるため確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installateurs déjà utilisés. Vous pourriez en avoir besoin, vérifiez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits verwendete Installer. Sie könnten sie noch brauchen – bitte prüfen."
          }
        }
      }
    },
    "cleanup.explanation.largeFiles": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files larger than %@. Sift never guesses: you decide which to remove."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大于 %@ 的文件。Sift 不做猜测，由你决定删除哪些。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@보다 큰 파일입니다. 어떤 파일을 지울지는 사용자가 결정합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы больше %@. Sift не угадывает: решение за вами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de más de %@. Sift no adivina: tú decides cuáles eliminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を超えるファイルです。削除するかどうかはご自身で決められます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers de plus de %@. Sift ne devine pas : c’est vous qui décidez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien größer als %@. Sift rät nicht – Sie entscheiden."
          }
        }
      }
    },

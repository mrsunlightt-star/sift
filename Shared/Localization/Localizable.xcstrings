    "risk.protected.detail": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift will not remove this. It is shown for information only."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 不会删除此处内容，仅作说明。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift는 이 항목을 삭제하지 않습니다. 정보 제공용입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift это не удаляет. Показано только для информации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift no elimina esto. Solo se muestra a modo informativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift は削除しません。情報としてのみ表示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ne le supprimera pas. Affiché à titre informatif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift entfernt das nicht. Nur zur Information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift non lo rimuoverà. Mostrato solo come informazione."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift não remove isto. Exibido apenas como informação."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift 不會刪除此內容，僅作說明。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift bunu kaldırmaz. Yalnızca bilgi amaçlı gösterilir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift tego nie usunie. Pokazane wyłącznie informacyjnie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift verwijdert dit niet. Alleen ter informatie getoond."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ຈະບໍ່ລຶບສິ່ງນີ້ ສະແດງເພື່ອຂໍ້ມູນເທົ່ານັ້ນ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يزله Sift. يُعرض للإعلام فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift לא יסיר זאת. מוצג למידע בלבד."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift این را حذف نمی‌کند. فقط برای اطلاع نمایش داده می‌شود."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift няма да премахне това. Показано е само за информация."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift toto neodstraní. Zobrazuje se pouze pro informaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift fjerner ikke dette. Det vises kun som information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Sift δεν θα το αφαιρέσει. Εμφανίζεται μόνο ενημερωτικά."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift no elimina esto. Solo se muestra a modo informativo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift ei poista tätä. Se näytetään vain tiedoksi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Sift nem távolítja el. Csak tájékoztatásul jelenik meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift tidak akan menghapusnya. Ini hanya ditampilkan sebagai informasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift tidak akan membuangnya. Ia dipaparkan untuk maklumat sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift fjerner ikke dette. Det vises bare som informasjon."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Sift não elimina isto. É apresentado apenas a título informativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift nu va elimina acest element. Este afișat doar pentru informare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift tar inte bort detta. Det visas endast som information."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift จะไม่ลบรายการนี้ แสดงไว้เพื่อเป็นข้อมูลเท่านั้น"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift не видалить це. Показано лише для інформації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sift sẽ không xóa mục này. Mục chỉ được hiển thị để tham khảo."
          }
        }
      }
    },

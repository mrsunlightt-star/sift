          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee CleaningRules.json de la carpeta de datos de la app. Se aplica al próximo análisis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのデータフォルダの CleaningRules.json を読み込みます。次回のスキャンから適用されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit CleaningRules.json dans le dossier de données de l’app. S’applique au prochain scan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest CleaningRules.json aus dem Datenordner der App. Gilt ab dem nächsten Scan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge CleaningRules.json dalla cartella dati dell’app. Vale dalla prossima scansione."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê CleaningRules.json da pasta de dados do app. Vale a partir da próxima verificação."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從應用程式資料目錄讀取 CleaningRules.json，下一次掃描生效。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın veri klasöründen CleaningRules.json dosyasını okur. Sonraki taramadan itibaren geçerlidir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyta CleaningRules.json z folderu danych aplikacji. Obowiązuje od następnego skanowania."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest CleaningRules.json uit de datamap van de app. Geldt vanaf de volgende scan."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ອ່ານ CleaningRules.json ຈາກໂຟນເດີຂໍ້ມູນຂອງແອັບ. ມີຜົນຕັ້ງແຕ່ການສະແກນຄັ້ງຕໍ່ໄປ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ CleaningRules.json من مجلد بيانات التطبيق. يُطبَّق من الفحص القادم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קורא את CleaningRules.json מתיקיית הנתונים של האפליקציה. חל מהסריקה הבאה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "CleaningRules.json را از پوشهٔ دادهٔ برنامه می‌خواند. از اسکن بعدی اعمال می‌شود."
          }
        }
      }
    },

      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This disk is no longer connected. Reconnect it and scan again."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此磁盘已断开连接。请重新连接后再扫描。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디스크의 연결이 끊어졌습니다. 다시 연결한 뒤 검사하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот диск отключён. Подключите его снова и повторите."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disco ya no está conectado. Vuelve a conectarlo y analiza de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このディスクは接続されていません。再接続してスキャンしてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce disque n’est plus connecté. Reconnectez-le puis relancez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Laufwerk ist nicht mehr verbunden. Bitte erneut anschließen."
          }
        }
      }
    },

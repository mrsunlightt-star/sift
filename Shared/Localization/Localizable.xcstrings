            "value": "Reconstruiește-l din instrumentul care l-a creat"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg upp det igen från verktyget som skapade det"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างใหม่จากเครื่องมือที่สร้างมันขึ้นมา"

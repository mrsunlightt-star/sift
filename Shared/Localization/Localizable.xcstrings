    "cleanup.confirm.riskWarning": {
      "comment": null,
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have included items marked for review. Please check the list before continuing."
          }
        },
        "zh-hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已选中标记为需确认的项目。继续前请检查列表。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인이 필요한 항목이 포함되어 있습니다. 계속하기 전에 목록을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выбрали элементы с пометкой «проверить». Проверьте список перед продолжением."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has incluido elementos marcados para revisar. Comprueba la lista antes de continuar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要確認の項目が含まれています。続行前にリストを確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez inclus des éléments à vérifier. Vérifiez la liste avant de continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben Einträge mit „prüfen“ ausgewählt. Bitte prüfen Sie die Liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai incluso elementi da verificare. Controlla l’elenco prima di continuare."
          }
        },
        "pt-br": {
          "stringUnit": {
            "state": "translated",
            "value": "Você incluiu itens marcados para revisão. Verifique a lista antes de continuar."
          }
        },
        "zh-hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已選取標記為需確認的項目。繼續前請檢查列表。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol edilmesi işaretli öğeler eklediniz. Devam etmeden önce listeyi gözden geçirin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwzględniłeś elementy oznaczone do sprawdzenia. Przed kontynuacją sprawdź listę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt items opgenomen die om controle vragen. Controleer de lijst voordat je doorgaat."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ທ່ານໄດ້ເລືອກລາຍການທີ່ຕ້ອງຢືນຢັນ. ກວດເບິ່ງລາຍການກ່ອນສືບຕໍ່."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد ضمّنت عناصر محددة للمراجعة. تحقق من القائمة قبل المتابعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כללתם פריטים המסומנים לבדיקה. בדקו את הרשימה לפני ההמשך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مواردی که نیاز به بررسی دارند را گنجانده‌اید. پیش از ادامه فهرست را بازبینی کنید."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включили сте елементи, отбелязани за преглед. Проверете списъка, преди да продължите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahrnuli jste položky označené ke kontrole. Před pokračováním zkontrolujte seznam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har medtaget elementer markeret til gennemgang. Kontroller listen, før du fortsætter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε συμπεριλάβει στοιχεία που έχουν χαρακτηριστεί προς έλεγχο. Ελέγξτε τη λίστα πριν συνεχίσετε."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluiste elementos marcados para revisar. Revisa la lista antes de continuar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet valinnut kohteita, jotka on merkitty tarkistettaviksi. Tarkista luettelo ennen jatkamista."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Átnézendőnek jelölt elemeket is kijelölt. Kérjük, ellenőrizze a listát, mielőtt folytatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda menyertakan item yang ditandai untuk ditinjau. Periksa daftar sebelum melanjutkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah menyertakan item yang ditanda untuk disemak. Sila semak senarai sebelum meneruskan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har tatt med elementer merket for gjennomgang. Kontroller listen før du fortsetter."
          }
        },
        "pt-pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluiu itens marcados para revisão. Verifique a lista antes de continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai inclus elemente marcate pentru verificare. Verifică lista înainte de a continua."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har inkluderat objekt markerade för granskning. Kontrollera listan innan du fortsätter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณได้เลือกรายการที่ทำเครื่องหมายว่าควรตรวจสอบ โปรดตรวจสอบรายการก่อนดำเนินการต่อ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви включили елементи, позначені для перевірки. Перегляньте список, перш ніж продовжити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã bao gồm các mục được đánh dấu cần xem lại. Vui lòng kiểm tra danh sách trước khi tiếp tục."
          }
        }
      }
    },

          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перестроить в создавшей программе"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruir desde la herramienta que lo creó"

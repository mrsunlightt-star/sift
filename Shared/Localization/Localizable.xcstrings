        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε το ξανά από το εργαλείο που το δημιούργησε"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruirlo desde la herramienta que lo creó"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo uudelleen työkalulla, joka sen teki"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Építse újra az azt létrehozó eszközzel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun ulang dari alat yang membuatnya"
          }
